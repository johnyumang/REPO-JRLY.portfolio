[
 {
  "text": "Huwag!",
  "start": 0.015,
  "end": 0.305,
  "style": "sharp",
  "speaker": "M"
 },
 {
  "text": "Limandaan at dalawampu't siyam na araw akong naghintay para bawiin ang medalyon ko.",
  "start": 0.77,
  "end": 5.3,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Pinigilan ako ng mismong nagnakaw nito.",
  "start": 5.725,
  "end": 7.785,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 8.21,
  "end": 9.09,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Panadero na ako ngayon.",
  "start": 9.515,
  "end": 10.595,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Cavite.",
  "start": 11.44,
  "end": 11.98,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hunyo 1898.",
  "start": 12.405,
  "end": 14.995,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Madaling-araw.",
  "start": 15.42,
  "end": 16.38,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Labimpitong buwan nang naghihintay si Indio sa nakaraan.",
  "start": 16.805,
  "end": 19.855,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nagmamasa siya ng tinapay sa panaderya ng amo niyang si Aling Pining.",
  "start": 20.28,
  "end": 24.53,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kasama pa rin niya si Usman, ang aso niyang nagsasalita.",
  "start": 24.955,
  "end": 28.225,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At binibilang niya ang mga araw sa dingding.",
  "start": 28.65,
  "end": 30.97,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Unang trabahong hindi ako natanggal.",
  "start": 31.435,
  "end": 33.225,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Kinailangan ko pang mapadpad sa ibang siglo.",
  "start": 33.65,
  "end": 35.85,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Sinigang: galing sa salitang \"sigang\", ibig sabihin, pakuluan.",
  "start": 36.275,
  "end": 40.215,
  "style": "wistful",
  "speaker": "INDIO"
 },
 {
  "text": "Atin 'yan mula pa noong una.",
  "start": 40.64,
  "end": 42.19,
  "style": "wistful",
  "speaker": "INDIO"
 },
 {
  "text": "Ang tagal ko nang hindi nakakatikim ng sinigang ni Lola.",
  "start": 42.615,
  "end": 45.365,
  "style": "wistful",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayong araw, uuwi na ako.",
  "start": 45.79,
  "end": 47.75,
  "style": "wistful",
  "speaker": "INDIO"
 },
 {
  "text": "Indio!",
  "start": 48.215,
  "end": 48.705,
  "style": "brisk",
  "speaker": "ALING PINING"
 },
 {
  "text": "Tatlong bilao para sa handaan sa bahay ng Heneral.",
  "start": 49.13,
  "end": 52.12,
  "style": "brisk",
  "speaker": "ALING PINING"
 },
 {
  "text": "Ikaw ang magdala, at huwag mong ipakain sa aso.",
  "start": 52.545,
  "end": 55.345,
  "style": "brisk",
  "speaker": "ALING PINING"
 },
 {
  "text": "Naririnig kita, Aling Pining.",
  "start": 55.81,
  "end": 58.16,
  "style": "sleepy",
  "speaker": "USMAN"
 },
 {
  "text": "Kawit.",
  "start": 59.005,
  "end": 59.575,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ikalabindalawa ng Hunyo, 1898.",
  "start": 60.0,
  "end": 63.79,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hapon.",
  "start": 64.215,
  "end": 64.685,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Dinala ni Indio ang tinapay sa Kawit.",
  "start": 65.11,
  "end": 67.19,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinahanap niya si M, ang babaeng nagnakaw ng medalyon niya.",
  "start": 67.556,
  "end": 70.986,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sabi sa sulat ng Lolo niya, narito siya ngayong araw.",
  "start": 71.411,
  "end": 74.661,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nahati ang mga tao.",
  "start": 75.086,
  "end": 76.296,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Dumaan ang isang lalaking nakaduyan.",
  "start": 76.721,
  "end": 78.871,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si Mabini.",
  "start": 79.336,
  "end": 80.336,
  "style": "whispers",
  "speaker": "ALING PINING"
 },
 {
  "text": "Lumpo ang paa, pero siya ang pinakamatalas dito.",
  "start": 80.761,
  "end": 83.821,
  "style": "whispers",
  "speaker": "ALING PINING"
 },
 {
  "text": "Binuhat siya sa duyan papunta rito.",
  "start": 84.246,
  "end": 86.316,
  "style": "whispers",
  "speaker": "ALING PINING"
 },
 {
  "text": "Sabi sa libro, buong kalayaan ang idineklara ngayon.",
  "start": 86.781,
  "end": 89.721,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Lahat masaya.",
  "start": 90.146,
  "end": 90.836,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Maaga pa ito.",
  "start": 91.381,
  "end": 92.261,
  "style": "quiet",
  "speaker": "MABINI"
 },
 {
  "text": "At padalos-dalos.",
  "start": 92.686,
  "end": 93.906,
  "style": "quiet",
  "speaker": "MABINI"
 },
 {
  "text": "Hindi lahat masaya, par.",
  "start": 94.371,
  "end": 95.531,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "May gulo sa harap.",
  "start": 95.996,
  "end": 97.006,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sumilip si Indio sa lente ng Lolo niya.",
  "start": 97.412,
  "end": 99.682,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang binatang naka-pulang bandana ang itinutulak palabas.",
  "start": 100.107,
  "end": 103.507,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ako 'yon.",
  "start": 103.972,
  "end": 104.382,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Noong una akong dumating dito.",
  "start": 104.807,
  "end": 106.127,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "At ako 'yon.",
  "start": 106.592,
  "end": 107.501,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Huwag kang lalapit, par.",
  "start": 107.926,
  "end": 109.056,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Bawal magkita ang iisang tao.",
  "start": 109.462,
  "end": 110.982,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Saka niya nakita si M, may kargang paslit.",
  "start": 111.827,
  "end": 114.317,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hawak nito ang medalyon.",
  "start": 114.742,
  "end": 116.142,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si M.",
  "start": 116.607,
  "end": 117.037,
  "style": "fierce",
  "speaker": "INDIO"
 },
 {
  "text": "At ang medalyon ko.",
  "start": 117.462,
  "end": 118.472,
  "style": "fierce",
  "speaker": "INDIO"
 },
 {
  "text": "Sumugod si Indio.",
  "start": 118.937,
  "end": 120.067,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang dangkal na lang.",
  "start": 120.492,
  "end": 121.642,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Huwag!",
  "start": 122.107,
  "end": 122.397,
  "style": "sharp",
  "speaker": "M"
 },
 {
  "text": "Sinunggaban ni M ang pulso niya.",
  "start": 122.862,
  "end": 124.592,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang taon at kalahati, M.",
  "start": 125.057,
  "end": 126.867,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Nagmasa ako ng tinapay para makakain.",
  "start": 127.292,
  "end": 129.442,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Akin 'yan.",
  "start": 129.867,
  "end": 130.347,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Hiningi ko ito sa Lolo mo noon.",
  "start": 130.812,
  "end": 132.302,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Tumanggi siya, kaya sa'yo ko kinuha.",
  "start": 132.727,
  "end": 134.707,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "At kung kukunin mo ngayon, hindi na ito makakarating sa'yo kailanman.",
  "start": 135.093,
  "end": 138.543,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ano'ng ibig mong sabihin?",
  "start": 139.008,
  "end": 140.238,
  "style": "confused",
  "speaker": "INDIO"
 },
 {
  "text": "Tingnan mo ang bata.",
  "start": 140.703,
  "end": 141.653,
  "style": "quiet",
  "speaker": "M"
 },
 {
  "text": "Tiningnan ni Indio ang paslit.",
  "start": 142.118,
  "end": 143.748,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mga mata ito ng Lolo niya.",
  "start": 144.173,
  "end": 145.583,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ito pala ang sulat niya: \"ibabalik ko sa pinanggalingan\".",
  "start": 146.048,
  "end": 149.028,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Mula sa batang ito, bababa ang medalyon sa pamilya ko.",
  "start": 149.453,
  "end": 152.933,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hanggang kay Lolo.",
  "start": 153.358,
  "end": 154.298,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hanggang sa akin.",
  "start": 154.723,
  "end": 155.623,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ang daan ko pauwi, isasabit sa leeg ng isang sanggol.",
  "start": 156.048,
  "end": 159.128,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "At kailangan kong panoorin.",
  "start": 159.553,
  "end": 161.033,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Binitawan siya ni M.",
  "start": 161.878,
  "end": 163.088,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At iniurong ni Indio ang kamay niya.",
  "start": 163.495,
  "end": 165.325,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sige.",
  "start": 165.87,
  "end": 166.21,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Isabit mo.",
  "start": 166.6,
  "end": 167.15,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Isinabit ni M ang medalyon sa paslit.",
  "start": 167.615,
  "end": 169.795,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At mula sa tanso, may nagsalita.",
  "start": 170.202,
  "end": 172.372,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mahigit tatlong daang taon akong naghintay sa araw na ito.",
  "start": 172.837,
  "end": 175.807,
  "style": "deep",
  "speaker": "DIWA"
 },
 {
  "text": "Sino 'yon?",
  "start": 176.272,
  "end": 176.822,
  "style": "startled",
  "speaker": "INDIO"
 },
 {
  "text": "Si Rajah Sulayman.",
  "start": 177.287,
  "end": 178.667,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ang diwa sa medalyon n'yo.",
  "start": 179.092,
  "end": 180.352,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa braso ni Indio, umusok ang ikaanim na marka.",
  "start": 180.817,
  "end": 183.997,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ikaanim.",
  "start": 184.462,
  "end": 185.142,
  "style": "soft",
  "speaker": "M"
 },
 {
  "text": "Dahil bumitaw ka.",
  "start": 185.567,
  "end": 186.447,
  "style": "soft",
  "speaker": "M"
 },
 {
  "text": "Sino ka na ba ngayon, Indio?",
  "start": 186.872,
  "end": 188.132,
  "style": "soft",
  "speaker": "M"
 },
 {
  "text": "Panadero.",
  "start": 188.597,
  "end": 189.247,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "May trabaho na ako.",
  "start": 189.672,
  "end": 190.642,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Hoy!",
  "start": 191.107,
  "end": 191.407,
  "style": "loud",
  "speaker": "ALING PINING"
 },
 {
  "text": "'Yang kinakain n'yong lahat, masa ng binatang 'yan!",
  "start": 191.832,
  "end": 194.587,
  "style": "loud",
  "speaker": "ALING PINING"
 },
 {
  "text": "Limandaang araw kong tinuruan 'yan!",
  "start": 194.973,
  "end": 196.953,
  "style": "loud",
  "speaker": "ALING PINING"
 },
 {
  "text": "Pumalakpak ang mga tao.",
  "start": 197.418,
  "end": 198.688,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sikat ka na, par.",
  "start": 199.153,
  "end": 200.203,
  "style": "proud",
  "speaker": "USMAN"
 },
 {
  "text": "Sa tinapay.",
  "start": 200.628,
  "end": 201.348,
  "style": "proud",
  "speaker": "USMAN"
 },
 {
  "text": "Inikot ni M ang hawakan ng payong niya.",
  "start": 202.193,
  "end": 204.403,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa loob, isang maliit na medalyon at isang blangkong kasulatan.",
  "start": 204.828,
  "end": 208.788,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi ang medalyon ang hinahanap ng mga sumusunod sa atin.",
  "start": 209.253,
  "end": 212.093,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ito.",
  "start": 212.518,
  "end": 212.828,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ang Huling Tala.",
  "start": 213.253,
  "end": 213.983,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa lente, lumitaw ang isang mapa.",
  "start": 214.448,
  "end": 216.838,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Labindalawang tuldok.",
  "start": 217.263,
  "end": 218.583,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Labindalawang medalyon, nakakalat sa mundo.",
  "start": 219.048,
  "end": 221.918,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Kaya kitang iuwi ngayon din, kung gusto mo.",
  "start": 222.343,
  "end": 224.683,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sumindi ang unang tuldok.",
  "start": 225.148,
  "end": 226.478,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Naisip ni Indio ang Lola niya.",
  "start": 226.884,
  "end": 228.594,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tapos tumingin siya ulit sa mapa.",
  "start": 229.019,
  "end": 230.649,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Lola, itabi mo muna ang sinigang ko.",
  "start": 231.114,
  "end": 233.164,
  "style": "steady",
  "speaker": "INDIO"
 },
 {
  "text": "Pero sa likod ng karamihan, may lalaking nakataas ang cellphone.",
  "start": 233.629,
  "end": 237.639,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi siya kilala ni Indio.",
  "start": 238.064,
  "end": 239.514,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Teka.",
  "start": 239.979,
  "end": 240.389,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "May cellphone 'yon.",
  "start": 240.814,
  "end": 241.664,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi lang pala ako ang hindi taga-rito.",
  "start": 242.089,
  "end": 243.879,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: kung isang hakbang na lang pauwi, at may nagsabing \"huwag muna\", makikinig ka ba?",
  "start": 244.724,
  "end": 249.784,
  "style": "curious",
  "speaker": "INDIO"
 }
]