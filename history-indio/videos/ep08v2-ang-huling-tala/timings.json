[
 {
  "text": "Huwag!",
  "start": 0.0,
  "end": 0.288,
  "style": "sharp",
  "speaker": "M"
 },
 {
  "text": "Limandaan at dalawampu't siyam na araw akong naghintay para bawiin ang medalyon ko.",
  "start": 0.918,
  "end": 5.38,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Pinigilan ako ng mismong nagnakaw nito.",
  "start": 5.76,
  "end": 8.267,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 8.908,
  "end": 9.664,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Panadero na ako ngayon.",
  "start": 10.044,
  "end": 11.416,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Cavite.",
  "start": 12.327,
  "end": 12.809,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hunyo 1898.",
  "start": 13.189,
  "end": 15.821,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Madaling-araw.",
  "start": 16.201,
  "end": 17.286,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Labimpitong buwan nang naghihintay si Indio sa nakaraan.",
  "start": 17.947,
  "end": 20.905,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nagmamasa siya ng tinapay sa panaderya ng amo niyang si Aling Pining.",
  "start": 21.285,
  "end": 25.577,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kasama pa rin niya si Usman, ang aso niyang nagsasalita.",
  "start": 26.117,
  "end": 29.347,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At binibilang niya ang mga araw sa dingding.",
  "start": 29.727,
  "end": 32.176,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Unang trabahong hindi ako natanggal.",
  "start": 32.827,
  "end": 34.524,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Kinailangan ko pang mapadpad sa ibang siglo.",
  "start": 34.904,
  "end": 37.355,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Sinigang: galing sa salitang \"sigang\", ibig sabihin, pakuluan.",
  "start": 37.976,
  "end": 41.895,
  "style": "wistful",
  "speaker": "INDIO"
 },
 {
  "text": "Atin 'yan mula pa noong una.",
  "start": 42.275,
  "end": 44.019,
  "style": "wistful",
  "speaker": "INDIO"
 },
 {
  "text": "Ang tagal ko nang hindi nakakatikim ng sinigang ni Lola.",
  "start": 44.26,
  "end": 46.926,
  "style": "wistful",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayong araw, uuwi na ako.",
  "start": 47.456,
  "end": 49.374,
  "style": "wistful",
  "speaker": "INDIO"
 },
 {
  "text": "Indio!",
  "start": 50.015,
  "end": 50.406,
  "style": "brisk",
  "speaker": "ALING PINING"
 },
 {
  "text": "Tatlong bilao para sa handaan sa bahay ng Heneral.",
  "start": 50.786,
  "end": 53.696,
  "style": "brisk",
  "speaker": "ALING PINING"
 },
 {
  "text": "Ikaw ang magdala, at huwag mong ipakain sa aso.",
  "start": 54.076,
  "end": 56.865,
  "style": "brisk",
  "speaker": "ALING PINING"
 },
 {
  "text": "Naririnig kita, Aling Pining.",
  "start": 57.485,
  "end": 59.813,
  "style": "sleepy",
  "speaker": "USMAN"
 },
 {
  "text": "Kawit.",
  "start": 60.714,
  "end": 61.256,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ikalabindalawa ng Hunyo, 1898.",
  "start": 61.636,
  "end": 65.531,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hapon.",
  "start": 65.911,
  "end": 66.334,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Dinala ni Indio ang tinapay sa Kawit.",
  "start": 66.974,
  "end": 69.108,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinahanap niya si M, ang babaeng nagnakaw ng medalyon niya.",
  "start": 69.429,
  "end": 72.796,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sabi sa sulat ng Lolo niya, narito siya ngayong araw.",
  "start": 73.176,
  "end": 76.443,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nahati ang mga tao.",
  "start": 77.104,
  "end": 78.23,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Dumaan ang isang lalaking nakaduyan.",
  "start": 78.61,
  "end": 80.783,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si Mabini.",
  "start": 81.444,
  "end": 82.337,
  "style": "whispers",
  "speaker": "ALING PINING"
 },
 {
  "text": "Lumpo ang paa, pero siya ang pinakamatalas dito.",
  "start": 82.717,
  "end": 85.566,
  "style": "whispers",
  "speaker": "ALING PINING"
 },
 {
  "text": "Binuhat siya sa duyan papunta rito.",
  "start": 85.946,
  "end": 87.792,
  "style": "whispers",
  "speaker": "ALING PINING"
 },
 {
  "text": "Sabi sa libro, buong kalayaan ang idineklara ngayon.",
  "start": 88.503,
  "end": 91.367,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Lahat masaya.",
  "start": 91.747,
  "end": 92.552,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Maaga pa ito.",
  "start": 93.213,
  "end": 93.988,
  "style": "quiet",
  "speaker": "MABINI"
 },
 {
  "text": "At padalos-dalos.",
  "start": 94.368,
  "end": 95.74,
  "style": "quiet",
  "speaker": "MABINI"
 },
 {
  "text": "Hindi lahat masaya, par.",
  "start": 96.472,
  "end": 97.609,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "May gulo sa harap.",
  "start": 98.211,
  "end": 99.144,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sumilip si Indio sa lente ng Lolo niya.",
  "start": 99.505,
  "end": 101.65,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang binatang naka-pulang bandana ang itinutulak palabas.",
  "start": 102.03,
  "end": 105.58,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ako 'yon.",
  "start": 106.271,
  "end": 106.644,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Noong una akong dumating dito.",
  "start": 107.024,
  "end": 108.479,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "At ako 'yon.",
  "start": 109.12,
  "end": 109.933,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Huwag kang lalapit, par.",
  "start": 110.094,
  "end": 111.24,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Bawal magkita ang iisang tao.",
  "start": 111.601,
  "end": 113.028,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Saka niya nakita si M, may kargang paslit.",
  "start": 113.959,
  "end": 116.499,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hawak nito ang medalyon.",
  "start": 116.879,
  "end": 118.347,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si M.",
  "start": 118.998,
  "end": 119.33,
  "style": "fierce",
  "speaker": "INDIO"
 },
 {
  "text": "At ang medalyon ko.",
  "start": 119.71,
  "end": 120.817,
  "style": "fierce",
  "speaker": "INDIO"
 },
 {
  "text": "Sumugod si Indio.",
  "start": 121.458,
  "end": 122.495,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang dangkal na lang.",
  "start": 122.875,
  "end": 123.926,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Huwag!",
  "start": 124.597,
  "end": 124.885,
  "style": "sharp",
  "speaker": "M"
 },
 {
  "text": "Sinunggaban ni M ang pulso niya.",
  "start": 125.515,
  "end": 127.142,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang taon at kalahati, M.",
  "start": 127.824,
  "end": 129.56,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Nagmasa ako ng tinapay para makakain.",
  "start": 129.94,
  "end": 132.15,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Akin 'yan.",
  "start": 132.53,
  "end": 133.033,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Hiningi ko ito sa Lolo mo noon.",
  "start": 133.593,
  "end": 135.077,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Tumanggi siya, kaya sa'yo ko kinuha.",
  "start": 135.457,
  "end": 137.663,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "At kung kukunin mo ngayon, hindi na ito makakarating sa'yo kailanman.",
  "start": 138.004,
  "end": 141.413,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ano'ng ibig mong sabihin?",
  "start": 142.033,
  "end": 143.218,
  "style": "confused",
  "speaker": "INDIO"
 },
 {
  "text": "Tingnan mo ang bata.",
  "start": 143.88,
  "end": 144.836,
  "style": "quiet",
  "speaker": "M"
 },
 {
  "text": "Tiningnan ni Indio ang paslit.",
  "start": 145.459,
  "end": 147.088,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mga mata ito ng Lolo niya.",
  "start": 147.468,
  "end": 148.798,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ito pala ang sulat niya: \"ibabalik ko sa pinanggalingan\".",
  "start": 149.459,
  "end": 152.465,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Mula sa batang ito, bababa ang medalyon sa pamilya ko.",
  "start": 152.845,
  "end": 157.075,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hanggang kay Lolo.",
  "start": 157.455,
  "end": 158.859,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hanggang sa akin.",
  "start": 159.379,
  "end": 160.275,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ang daan ko pauwi, isasabit sa leeg ng isang sanggol.",
  "start": 160.898,
  "end": 163.919,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "At kailangan kong panoorin.",
  "start": 164.299,
  "end": 165.706,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Binitawan siya ni M.",
  "start": 166.612,
  "end": 167.688,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At iniurong ni Indio ang kamay niya.",
  "start": 168.05,
  "end": 169.76,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sige.",
  "start": 170.401,
  "end": 170.634,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Isabit mo.",
  "start": 170.979,
  "end": 171.426,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Isinabit ni M ang medalyon sa paslit.",
  "start": 172.048,
  "end": 174.286,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At mula sa tanso, may nagsalita.",
  "start": 174.648,
  "end": 176.776,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mahigit tatlong daang taon akong naghintay sa araw na ito.",
  "start": 177.396,
  "end": 180.365,
  "style": "deep",
  "speaker": "DIWA"
 },
 {
  "text": "Sino 'yon?",
  "start": 180.885,
  "end": 181.387,
  "style": "startled",
  "speaker": "INDIO"
 },
 {
  "text": "Si Rajah Sulayman.",
  "start": 182.022,
  "end": 183.34,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ang diwa sa medalyon n'yo.",
  "start": 183.72,
  "end": 184.889,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa braso ni Indio, umusok ang ikaanim na marka.",
  "start": 185.55,
  "end": 188.617,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ikaanim.",
  "start": 189.298,
  "end": 189.911,
  "style": "soft",
  "speaker": "M"
 },
 {
  "text": "Dahil bumitaw ka.",
  "start": 190.291,
  "end": 191.117,
  "style": "soft",
  "speaker": "M"
 },
 {
  "text": "Sino ka na ba ngayon, Indio?",
  "start": 191.497,
  "end": 192.826,
  "style": "soft",
  "speaker": "M"
 },
 {
  "text": "Panadero.",
  "start": 193.457,
  "end": 194.043,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "May trabaho na ako.",
  "start": 194.423,
  "end": 195.416,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Hoy!",
  "start": 196.037,
  "end": 196.308,
  "style": "loud",
  "speaker": "ALING PINING"
 },
 {
  "text": "'Yang kinakain n'yong lahat, masa ng binatang 'yan!",
  "start": 196.409,
  "end": 199.079,
  "style": "loud",
  "speaker": "ALING PINING"
 },
 {
  "text": "Limandaang araw kong tinuruan 'yan!",
  "start": 199.42,
  "end": 201.126,
  "style": "loud",
  "speaker": "ALING PINING"
 },
 {
  "text": "Pumalakpak ang mga tao.",
  "start": 201.767,
  "end": 203.004,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sikat ka na, par.",
  "start": 203.687,
  "end": 204.685,
  "style": "proud",
  "speaker": "USMAN"
 },
 {
  "text": "Sa tinapay.",
  "start": 205.065,
  "end": 205.855,
  "style": "proud",
  "speaker": "USMAN"
 },
 {
  "text": "Inikot ni M ang hawakan ng payong niya.",
  "start": 206.786,
  "end": 208.899,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa loob, isang maliit na medalyon at isang blangkong kasulatan.",
  "start": 209.279,
  "end": 213.366,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi ang medalyon ang hinahanap ng mga sumusunod sa atin.",
  "start": 214.036,
  "end": 216.888,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ito.",
  "start": 217.268,
  "end": 217.59,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ang Huling Tala.",
  "start": 217.97,
  "end": 218.815,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa lente, lumitaw ang isang mapa.",
  "start": 219.476,
  "end": 221.795,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Labindalawang tuldok.",
  "start": 222.175,
  "end": 224.044,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Labindalawang medalyon, nakakalat sa mundo.",
  "start": 224.664,
  "end": 227.484,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Kaya kitang iuwi ngayon din, kung gusto mo.",
  "start": 227.864,
  "end": 230.473,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sumindi ang unang tuldok.",
  "start": 231.124,
  "end": 232.419,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Naisip ni Indio ang Lola niya.",
  "start": 232.78,
  "end": 234.366,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tapos tumingin siya ulit sa mapa.",
  "start": 234.746,
  "end": 236.353,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Lola, itabi mo muna ang sinigang ko.",
  "start": 236.994,
  "end": 239.0,
  "style": "steady",
  "speaker": "INDIO"
 },
 {
  "text": "Pero sa likod ng karamihan, may lalaking nakataas ang cellphone.",
  "start": 239.642,
  "end": 243.635,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi siya kilala ni Indio.",
  "start": 244.015,
  "end": 245.442,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Teka.",
  "start": 246.062,
  "end": 246.384,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "May cellphone 'yon.",
  "start": 246.666,
  "end": 247.49,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi lang pala ako ang hindi taga-rito.",
  "start": 247.732,
  "end": 249.441,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: kung isang hakbang na lang pauwi, at may nagsabing \"huwag muna\", makikinig ka ba?",
  "start": 250.347,
  "end": 255.356,
  "style": "curious",
  "speaker": "INDIO"
 }
]