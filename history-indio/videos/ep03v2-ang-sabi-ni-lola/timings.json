[
 {
  "text": "Magnanakaw!",
  "start": 0.0,
  "end": 0.756,
  "style": "shout",
  "speaker": "TINDERA"
 },
 {
  "text": "Inaagaw niya ang bata!",
  "start": 1.038,
  "end": 2.026,
  "style": "shout",
  "speaker": "TINDERA"
 },
 {
  "text": "Hindi ako magnanakaw.",
  "start": 2.699,
  "end": 3.986,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Akala ko nga, ako ang ninakawan.",
  "start": 4.346,
  "end": 6.238,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 6.839,
  "end": 7.693,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Unang uwi ko sa probinsya, eskandalo agad.",
  "start": 8.053,
  "end": 10.628,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon.",
  "start": 11.599,
  "end": 12.052,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa isang jeep, papuntang Kawit.",
  "start": 12.412,
  "end": 14.367,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Natanggal si Indio sa trabaho, kaya umuwi siya sa Kawit, kay Lola Ising, ang biyuda ng Lolo niya.",
  "start": 14.987,
  "end": 21.447,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Jeepney: pagkatapos ng giyera, mga lumang jeep ng sundalong Amerikano ang ginawang pampasahero ng mga Pilipino.",
  "start": 22.107,
  "end": 29.83,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Tira-tira nila, ginawa nating hari ng kalsada.",
  "start": 30.19,
  "end": 33.657,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Ako na lang ang lumang hindi pa napapakinabangan.",
  "start": 34.197,
  "end": 36.646,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Kumain ka muna, apo.",
  "start": 37.206,
  "end": 38.15,
  "style": "warm",
  "speaker": "LOLA ISING"
 },
 {
  "text": "Tapos sagutin mo ako: uminit na ba ang medalyon?",
  "start": 38.51,
  "end": 42.086,
  "style": "warm",
  "speaker": "LOLA ISING"
 },
 {
  "text": "Iniabot ni Lola ang lumang kahon ng Lolo niya.",
  "start": 42.666,
  "end": 45.217,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kasyang-kasya roon ang medalyon.",
  "start": 45.577,
  "end": 47.365,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ganyan din ang Lolo Isidro mo.",
  "start": 48.046,
  "end": 49.62,
  "style": "quiet",
  "speaker": "LOLA ISING"
 },
 {
  "text": "Bigla-biglang nawawala.",
  "start": 49.98,
  "end": 51.144,
  "style": "quiet",
  "speaker": "LOLA ISING"
 },
 {
  "text": "Pumunta ka sa bahay ni Aguinaldo, at basahin mo nang malakas ang marker.",
  "start": 51.504,
  "end": 55.595,
  "style": "quiet",
  "speaker": "LOLA ISING"
 },
 {
  "text": "Sa bahay ni Aguinaldo, binasa niya ang marker.",
  "start": 56.256,
  "end": 59.137,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Uminit ang medalyon.",
  "start": 59.497,
  "end": 60.684,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kawit.",
  "start": 61.625,
  "end": 62.167,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ikalabindalawa ng Hunyo, 1898.",
  "start": 62.527,
  "end": 66.442,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hapon.",
  "start": 66.802,
  "end": 67.245,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa tabi niya, lumitaw si Usman, ang asong itim na siya lang ang nakakarinig.",
  "start": 67.885,
  "end": 72.513,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang daming tao, par.",
  "start": 73.174,
  "end": 74.334,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Huwag kang mawawala.",
  "start": 74.415,
  "end": 75.202,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Ikaw ang aso.",
  "start": 75.822,
  "end": 76.578,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw ang huwag mawala.",
  "start": 76.938,
  "end": 77.849,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "May batang hirap sa isang malaking tambol: si Tinong, ang pinakabatang tambolero ng banda.",
  "start": 78.469,
  "end": 83.958,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tabi!",
  "start": 84.619,
  "end": 85.053,
  "style": "urgent",
  "speaker": "TINONG"
 },
 {
  "text": "Tambol ito ng banda!",
  "start": 85.133,
  "end": 86.445,
  "style": "urgent",
  "speaker": "TINONG"
 },
 {
  "text": "Tulungan na kita.",
  "start": 87.218,
  "end": 87.821,
  "style": "friendly",
  "speaker": "INDIO"
 },
 {
  "text": "Saan ba ang balkonahe?",
  "start": 88.181,
  "end": 89.568,
  "style": "friendly",
  "speaker": "INDIO"
 },
 {
  "text": "Doon daw iwawagayway ang watawat.",
  "start": 89.928,
  "end": 91.838,
  "style": "friendly",
  "speaker": "INDIO"
 },
 {
  "text": "Anong balkonahe, kuya?",
  "start": 92.358,
  "end": 93.515,
  "style": "puzzled",
  "speaker": "TINONG"
 },
 {
  "text": "Bintana lang ang meron diyan.",
  "start": 93.875,
  "end": 95.366,
  "style": "puzzled",
  "speaker": "TINONG"
 },
 {
  "text": "Bintana nga.",
  "start": 95.987,
  "end": 96.719,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sa lahat ng litratong nakita ko, may balkonahe.",
  "start": 97.079,
  "end": 100.17,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sino'ng nagdagdag?",
  "start": 100.53,
  "end": 101.956,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Mula sa likod, may nakita si Indio: isang paslit na may medalyong kamukha ng kanya.",
  "start": 102.871,
  "end": 108.299,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Medalyon ko 'yon.",
  "start": 108.97,
  "end": 109.835,
  "style": "shocked",
  "speaker": "INDIO"
 },
 {
  "text": "Wala ang akin!",
  "start": 110.488,
  "end": 111.345,
  "style": "angry",
  "speaker": "INDIO"
 },
 {
  "text": "Ninakaw!",
  "start": 111.705,
  "end": 112.415,
  "style": "angry",
  "speaker": "INDIO"
 },
 {
  "text": "Par, sandali, makinig ka muna.",
  "start": 113.077,
  "end": 114.835,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Hinila niya ang tali sa leeg ng bata.",
  "start": 115.497,
  "end": 117.506,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nakita ito ng isang tinderang katabi.",
  "start": 117.866,
  "end": 119.856,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Magnanakaw!",
  "start": 120.507,
  "end": 121.263,
  "style": "shout",
  "speaker": "TINDERA"
 },
 {
  "text": "Inaagaw niya ang bata!",
  "start": 121.545,
  "end": 122.533,
  "style": "shout",
  "speaker": "TINDERA"
 },
 {
  "text": "Itinulak siya ng mga tao palabas ng bakuran.",
  "start": 123.206,
  "end": 125.654,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Diyan ka sa labas.",
  "start": 126.345,
  "end": 127.109,
  "style": "cold",
  "speaker": "LALAKI"
 },
 {
  "text": "Hindi para sa magnanakaw ang araw na ito.",
  "start": 127.371,
  "end": 129.343,
  "style": "cold",
  "speaker": "LALAKI"
 },
 {
  "text": "Ang pinakamahalagang hapon ng bansa.",
  "start": 130.004,
  "end": 131.791,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Pinalabas ako bago pa magsimula.",
  "start": 132.151,
  "end": 134.643,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sa alikabok, nakita niya ang sarili niyang medalyon.",
  "start": 135.548,
  "end": 138.45,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nahulog lang pala.",
  "start": 138.81,
  "end": 139.936,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "'Yan ang sinasabi ko kanina.",
  "start": 140.577,
  "end": 141.834,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Nahulog 'yan nang magsiksikan.",
  "start": 142.194,
  "end": 143.745,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "May pagkit pa.",
  "start": 144.366,
  "end": 145.079,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Akin 'to.",
  "start": 145.22,
  "end": 145.602,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Kung akin 'to, kanino 'yung nasa bata?",
  "start": 145.843,
  "end": 147.874,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon ka lang tumingin nang maayos.",
  "start": 148.535,
  "end": 150.132,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Dalawa sila.",
  "start": 150.774,
  "end": 151.387,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "At muntik na akong maging magnanakaw.",
  "start": 151.747,
  "end": 153.822,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Kuya!",
  "start": 154.483,
  "end": 154.745,
  "style": "desperate",
  "speaker": "TINONG"
 },
 {
  "text": "Magsisimula na ang martsa!",
  "start": 155.105,
  "end": 156.461,
  "style": "desperate",
  "speaker": "TINONG"
 },
 {
  "text": "Pinasan niya ang tambol ni Tinong, bumalik sa loob, at hinarap ang tinderang sumigaw.",
  "start": 157.223,
  "end": 162.222,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nagkamali po ako.",
  "start": 163.003,
  "end": 163.937,
  "style": "plain",
  "speaker": "INDIO"
 },
 {
  "text": "Akin pala ito, nahulog lang.",
  "start": 164.297,
  "end": 166.165,
  "style": "plain",
  "speaker": "INDIO"
 },
 {
  "text": "Walang kasalanan ang bata.",
  "start": 166.525,
  "end": 167.812,
  "style": "plain",
  "speaker": "INDIO"
 },
 {
  "text": "Patawad po.",
  "start": 168.292,
  "end": 168.894,
  "style": "plain",
  "speaker": "INDIO"
 },
 {
  "text": "Hmp.",
  "start": 169.529,
  "end": 169.894,
  "style": "gruff",
  "speaker": "TINDERA"
 },
 {
  "text": "Padaanin ang tambol!",
  "start": 170.076,
  "end": 171.127,
  "style": "gruff",
  "speaker": "TINDERA"
 },
 {
  "text": "Kanina pinalabas ka.",
  "start": 171.759,
  "end": 172.774,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Ngayon, pinapadaan ka pa.",
  "start": 173.134,
  "end": 175.027,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Si Heneral Aguinaldo.",
  "start": 176.003,
  "end": 177.249,
  "style": "whispers",
  "speaker": "TINONG"
 },
 {
  "text": "At ang asawa niya, si Hilaria.",
  "start": 177.609,
  "end": 179.581,
  "style": "whispers",
  "speaker": "TINONG"
 },
 {
  "text": "Sa bintana, pinisil ng isang ginang ang kamay ng heneral.",
  "start": 180.373,
  "end": 184.033,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Saka iniladlad ang watawat, at tumugtog ang banda.",
  "start": 184.393,
  "end": 187.742,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Martsa namin 'yan!",
  "start": 188.403,
  "end": 189.328,
  "style": "proud",
  "speaker": "TINONG"
 },
 {
  "text": "Wala pang salita.",
  "start": 189.529,
  "end": 190.334,
  "style": "proud",
  "speaker": "TINONG"
 },
 {
  "text": "Tugtog lang.",
  "start": 190.694,
  "end": 191.722,
  "style": "proud",
  "speaker": "TINONG"
 },
 {
  "text": "Si Ambrosio Rianzares Bautista, ang sumulat ng kasulatan, ang bumasa nito.",
  "start": 192.343,
  "end": 197.391,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "¡Independencia!",
  "start": 198.162,
  "end": 199.184,
  "style": "strong",
  "speaker": "BAUTISTA"
 },
 {
  "text": "Kalayaan, kuya.",
  "start": 199.907,
  "end": 200.954,
  "style": "awed",
  "speaker": "TINONG"
 },
 {
  "text": "'Yun ang ibig sabihin.",
  "start": 201.314,
  "end": 202.666,
  "style": "awed",
  "speaker": "TINONG"
 },
 {
  "text": "Sa libro ko, isang linya lang ito.",
  "start": 203.286,
  "end": 205.544,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Dito, yumayanig ang lupa.",
  "start": 205.904,
  "end": 208.074,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ngumiti ang paslit kay Indio.",
  "start": 208.694,
  "end": 210.187,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tapos nawala ito sa dami ng tao, karga ng isang babaeng hindi niya nakita ang mukha.",
  "start": 210.547,
  "end": 216.059,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi niya alam kung sino sila.",
  "start": 216.419,
  "end": 218.344,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kakaiba ang amoy ng babaeng 'yon, par.",
  "start": 218.994,
  "end": 220.542,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi siya taga-rito.",
  "start": 220.703,
  "end": 221.547,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi rin taga-ngayon.",
  "start": 221.907,
  "end": 222.914,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Kuya, sa'yo na 'tong isang patpat ng tambol ko.",
  "start": 223.494,
  "end": 225.705,
  "style": "warm",
  "speaker": "TINONG"
 },
 {
  "text": "Para may dala ka pauwi.",
  "start": 226.065,
  "end": 227.192,
  "style": "warm",
  "speaker": "TINONG"
 },
 {
  "text": "Lumamig ang medalyon.",
  "start": 228.219,
  "end": 229.525,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumalik si Indio sa kasalukuyan, may pangatlong marka sa braso.",
  "start": 230.188,
  "end": 233.847,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Aray.",
  "start": 234.528,
  "end": 234.89,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Tatlo.",
  "start": 235.25,
  "end": 235.715,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "At ayan na ang balkonahe.",
  "start": 236.075,
  "end": 237.747,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Idinagdag lang pala pagkatapos.",
  "start": 238.288,
  "end": 240.035,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Nakita mo na siya, 'no?",
  "start": 240.747,
  "end": 241.961,
  "style": "soft",
  "speaker": "LOLA ISING"
 },
 {
  "text": "Ang batang may medalyon.",
  "start": 242.321,
  "end": 243.727,
  "style": "soft",
  "speaker": "LOLA ISING"
 },
 {
  "text": "Sa tingin ko, siya ang lolo ng Lolo mo.",
  "start": 244.087,
  "end": 246.977,
  "style": "soft",
  "speaker": "LOLA ISING"
 },
 {
  "text": "Sa tingin n'yo lang po?",
  "start": 247.577,
  "end": 248.357,
  "style": "curious",
  "speaker": "INDIO"
 },
 {
  "text": "Hula ko lang, apo.",
  "start": 248.99,
  "end": 249.753,
  "style": "quiet",
  "speaker": "LOLA ISING"
 },
 {
  "text": "Ang Lolo Isidro mo, isang salita lang ang iniwan sa akin: Calamba.",
  "start": 250.113,
  "end": 254.63,
  "style": "quiet",
  "speaker": "LOLA ISING"
 },
 {
  "text": "Ikaw, ka-Indio: kapag nagkamali ka sa harap ng maraming tao, babalik ka ba para humingi ng tawad?",
  "start": 255.53,
  "end": 260.78,
  "style": "curious",
  "speaker": "INDIO"
 }
]