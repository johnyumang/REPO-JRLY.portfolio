[
 {
  "text": "Nasaan ang cedula mo?!",
  "start": 0.0,
  "end": 1.065,
  "style": "shout",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Walang cedula, kaya may itak sa leeg ko ngayon.",
  "start": 1.638,
  "end": 3.996,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 4.588,
  "end": 5.363,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Malas daw ako.",
  "start": 5.665,
  "end": 6.308,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Ganito 'yan nagsimula.",
  "start": 6.688,
  "end": 7.757,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Kaninang umaga, sa Quezon City, pumila si Indio para sa trabaho.",
  "start": 8.558,
  "end": 13.188,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Maghapon akong pumila.",
  "start": 13.793,
  "end": 14.987,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Wala pala akong cedula, 'yung resibo ng buwis.",
  "start": 15.367,
  "end": 18.256,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi ko alam na kailangan pala 'yon.",
  "start": 18.636,
  "end": 20.363,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya dinala niya sa sanglaan ang nag-iisang mana niya: ang lumang medalyon ng Lolo niya.",
  "start": 20.948,
  "end": 25.867,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pamasahe lang po sana.",
  "start": 26.428,
  "end": 27.613,
  "style": "hopeful",
  "speaker": "INDIO"
 },
 {
  "text": "Tanso lang 'yan, tol.",
  "start": 28.225,
  "end": 29.455,
  "style": "bored",
  "speaker": "MAY-ARI"
 },
 {
  "text": "Walang halaga.",
  "start": 29.835,
  "end": 30.523,
  "style": "bored",
  "speaker": "MAY-ARI"
 },
 {
  "text": "Sa likod ng may-ari, may katulong na kinakalawang ang kamay.",
  "start": 31.215,
  "end": 34.533,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bago ibinalik ang medalyon, palihim niya itong idiniin sa isang pirasong pagkit.",
  "start": 34.913,
  "end": 39.484,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Gutom na 'ko.",
  "start": 40.039,
  "end": 40.579,
  "style": "sigh",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kanto, may paresan.",
  "start": 41.167,
  "end": 43.224,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi niya kaya ang isang mangkok.",
  "start": 43.604,
  "end": 45.29,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tinapay lang ang nabili niya.",
  "start": 45.67,
  "end": 47.296,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pares: taga-Quezon City, gaya ko.",
  "start": 47.877,
  "end": 50.653,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Sabi nila, nagsimula ito sa Retiro noong 1979.",
  "start": 51.033,
  "end": 55.602,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon, nasa buong Pilipinas na.",
  "start": 55.982,
  "end": 57.807,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Diwata, baka naman!",
  "start": 58.377,
  "end": 59.894,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Pagsapit ng gabi, bumuhos ang ulan.",
  "start": 60.727,
  "end": 63.184,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sumilong si Indio sa dambana ng Pugad Lawin, sa Bahay Toro.",
  "start": 63.564,
  "end": 67.697,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala akong kausap.",
  "start": 68.252,
  "end": 69.21,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Marker na lang.",
  "start": 69.573,
  "end": 70.239,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Binasa niya nang malakas ang nakasulat.",
  "start": 70.826,
  "end": 72.982,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Uminit ang medalyon sa dibdib niya.",
  "start": 73.362,
  "end": 75.168,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At tumigil sa ere ang mga patak ng ulan.",
  "start": 75.548,
  "end": 77.976,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mula sa liwanag, lumundag ang isang asong itim.",
  "start": 78.556,
  "end": 81.685,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kumapit ka, Indio!",
  "start": 82.306,
  "end": 83.283,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Teka, nagsalita 'yung aso?",
  "start": 83.906,
  "end": 85.524,
  "style": "shocked",
  "speaker": "INDIO"
 },
 {
  "text": "Agosto 1896.",
  "start": 86.301,
  "end": 89.096,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang bakuran sa labas ng Maynila, puno ng mga Katipunero.",
  "start": 89.476,
  "end": 93.544,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinablot si Indio, at hinarang ng isang batang may itak.",
  "start": 93.924,
  "end": 97.551,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Siya si Islaw.",
  "start": 98.046,
  "end": 98.878,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Labindalawang taong gulang, anak ng magsasaka, at bantay ng bakuran ngayong gabi.",
  "start": 99.258,
  "end": 104.674,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sino ka?",
  "start": 105.265,
  "end": 105.617,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "Sino'ng nagsama sa'yo rito?",
  "start": 105.997,
  "end": 107.412,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "Lumapit ang pinuno ng mga bantay, isang Katipunerong hindi ngumingiti.",
  "start": 108.054,
  "end": 112.223,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "May nagsumbong sa amin sa Kastila.",
  "start": 112.823,
  "end": 114.458,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Kaya lahat ng narito, may dalang cedula ngayong gabi.",
  "start": 114.838,
  "end": 117.728,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Ilabas mo ang sa'yo.",
  "start": 118.108,
  "end": 119.113,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Cedula?",
  "start": 119.688,
  "end": 120.08,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "'Yan din ang hinanap sa akin kaninang umaga.",
  "start": 120.46,
  "end": 122.476,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "Walang papel, walang kakilala.",
  "start": 123.102,
  "end": 124.793,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Espiya 'yan.",
  "start": 125.173,
  "end": 125.901,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Itinali ang mga kamay niya.",
  "start": 126.442,
  "end": 127.838,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Idinikit ang itak sa leeg niya.",
  "start": 128.218,
  "end": 130.43,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Unang araw ko sa nakaraan.",
  "start": 131.061,
  "end": 132.38,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Mukhang huling araw ko na rin.",
  "start": 132.561,
  "end": 133.769,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Par.",
  "start": 134.369,
  "end": 134.68,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Sabihin mo ang totoo.",
  "start": 135.022,
  "end": 135.968,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "'Yun lang ang meron ka.",
  "start": 136.348,
  "end": 137.376,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Wala akong cedula.",
  "start": 138.003,
  "end": 138.837,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong trabaho.",
  "start": 139.217,
  "end": 140.224,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong kahit ano.",
  "start": 140.604,
  "end": 141.511,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya nga ako napadpad dito.",
  "start": 142.067,
  "end": 143.453,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Natigilan ang bata.",
  "start": 143.995,
  "end": 145.173,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumaba ang itak.",
  "start": 145.553,
  "end": 146.582,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala rin akong cedula.",
  "start": 147.184,
  "end": 148.201,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Hindi kayang bayaran ni Itay.",
  "start": 148.483,
  "end": 149.792,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Saka lumapit ang mga aso ng kampo.",
  "start": 150.413,
  "end": 152.409,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Inamoy siya, kinain ang tinapay niya, at humiga sa paanan niya.",
  "start": 152.789,
  "end": 156.702,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kinausap ko sila.",
  "start": 157.308,
  "end": 158.094,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "May bayad nga lang: hapunan mo.",
  "start": 158.336,
  "end": 159.727,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi tumatahimik ang aso sa espiya.",
  "start": 160.333,
  "end": 162.113,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Kalagan n'yo siya.",
  "start": 162.493,
  "end": 163.301,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Sino ka ba talaga?",
  "start": 163.902,
  "end": 164.685,
  "style": "uneasy",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Wala.",
  "start": 165.289,
  "end": 165.502,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Tambay lang.",
  "start": 165.882,
  "end": 166.516,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Sa gilid ng liwanag, may mag-asawang nagpapaalam.",
  "start": 167.318,
  "end": 170.415,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang babae, si Oriang.",
  "start": 170.516,
  "end": 172.24,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinali niya ang pulang panyo sa leeg ng lalaki.",
  "start": 172.62,
  "end": 175.587,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kapag pinunit mo 'yan, wala na tayong uuwian.",
  "start": 176.163,
  "end": 179.06,
  "style": "soft",
  "speaker": "ORIANG"
 },
 {
  "text": "Kaya nga pupunitin ko.",
  "start": 179.687,
  "end": 180.814,
  "style": "quiet",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Para may uuwian ang lahat.",
  "start": 181.194,
  "end": 182.765,
  "style": "quiet",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Huwag kang tumitig, par.",
  "start": 183.305,
  "end": 184.542,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Humakbang ang lalaki sa liwanag, at itinaas ang kanyang cedula.",
  "start": 185.135,
  "end": 188.774,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang Supremo.",
  "start": 189.405,
  "end": 190.381,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Si Andres Bonifacio.",
  "start": 190.761,
  "end": 192.012,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Punitin ang mga cedula!",
  "start": 192.714,
  "end": 193.95,
  "style": "shout",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Mabuhay ang Pilipinas!",
  "start": 194.535,
  "end": 195.842,
  "style": "shout",
  "speaker": "MGA KATIPUNERO"
 },
 {
  "text": "Buwis namin 'yan sa Kastila.",
  "start": 196.384,
  "end": 197.731,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "Kapag pinunit mo, wala nang atrasan.",
  "start": 198.111,
  "end": 200.243,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "'Yung papel na kulang sa akin kaninang umaga, pinupunit nila para sa kalayaan.",
  "start": 200.834,
  "end": 204.883,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Walang mapunit si Islaw, kaya kamao na lang ang itinaas nilang dalawa.",
  "start": 205.484,
  "end": 209.753,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kuya, babalik ka ba?",
  "start": 210.349,
  "end": 211.826,
  "style": "hopeful",
  "speaker": "ISLAW"
 },
 {
  "text": "Bago pa siya makasagot, lumamig ang medalyon.",
  "start": 212.674,
  "end": 215.442,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "May marka ka na, par.",
  "start": 216.043,
  "end": 217.223,
  "style": "fading",
  "speaker": "USMAN"
 },
 {
  "text": "Una pa lang 'yan.",
  "start": 217.405,
  "end": 218.05,
  "style": "fading",
  "speaker": "USMAN"
 },
 {
  "text": "Quezon City ulit.",
  "start": 218.632,
  "end": 219.858,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ulan.",
  "start": 220.238,
  "end": 220.582,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala na ang aso.",
  "start": 220.962,
  "end": 222.11,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pero sa braso ni Indio, may guhit na umuusok pa.",
  "start": 222.661,
  "end": 225.84,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Aray.",
  "start": 226.446,
  "end": 226.788,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Usman.",
  "start": 227.168,
  "end": 227.895,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "'Yun ang itatawag ko sa'yo.",
  "start": 228.275,
  "end": 229.525,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Pangalan ng aso sa mga kuwento ni Lolo.",
  "start": 230.041,
  "end": 232.048,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kabilang kalye, may babaeng nakatitig sa kanya, na parang kilala siya.",
  "start": 232.549,
  "end": 237.197,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa sanglaan, hawak ng katulong ang pagkit: buong-buo ang bakas ng medalyon.",
  "start": 237.828,
  "end": 242.896,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tanso lang pala, ha.",
  "start": 243.557,
  "end": 244.531,
  "style": "soft",
  "speaker": "KATULONG"
 },
 {
  "text": "Ikaw, ka-Indio: kung hinanapan ka ng papel na wala ka, magsisinungaling ka ba, o aamin?",
  "start": 245.21,
  "end": 250.679,
  "style": "curious",
  "speaker": "INDIO"
 }
]