[
 {
  "text": "Nasaan ang cedula mo?!",
  "start": 0.0,
  "end": 1.066,
  "style": "shout",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Walang cedula, kaya may itak sa leeg ko ngayon.",
  "start": 1.628,
  "end": 4.035,
  "style": "dramatic",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 4.616,
  "end": 5.494,
  "style": "playful",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Malas daw ako.",
  "start": 5.717,
  "end": 6.384,
  "style": "playful",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ngayon.",
  "start": 7.185,
  "end": 7.545,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Maghapon akong pumila.",
  "start": 8.19,
  "end": 9.244,
  "style": "dry",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Wala pala akong cedula, 'yung resibo ng buwis.",
  "start": 9.404,
  "end": 11.752,
  "style": "dry",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Hindi ko alam na kailangan pala 'yon.",
  "start": 12.132,
  "end": 13.92,
  "style": "dry",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Isang sanglaan.",
  "start": 14.665,
  "end": 15.507,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pamasahe lang po sana.",
  "start": 16.212,
  "end": 17.525,
  "style": "hopeful",
  "speaker": "INDIO"
 },
 {
  "text": "Tanso lang 'yan, tol.",
  "start": 18.139,
  "end": 19.369,
  "style": "bored",
  "speaker": "MAY-ARI"
 },
 {
  "text": "Walang halaga.",
  "start": 19.749,
  "end": 20.437,
  "style": "bored",
  "speaker": "MAY-ARI"
 },
 {
  "text": "Gutom na 'ko.",
  "start": 21.149,
  "end": 21.822,
  "style": "sigh",
  "speaker": "INDIO"
 },
 {
  "text": "Pares: taga-Quezon City, gaya ko.",
  "start": 22.695,
  "end": 24.748,
  "style": "proud",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Sabi nila, nagsimula ito sa Retiro noong 1979: baka, kapares ng sinangag at sabaw.",
  "start": 25.109,
  "end": 30.937,
  "style": "proud",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ngayon, nasa buong Pilipinas na.",
  "start": 31.517,
  "end": 33.249,
  "style": "proud",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Diwata, baka naman!",
  "start": 33.829,
  "end": 35.264,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Gabi.",
  "start": 36.035,
  "end": 36.306,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumuhos ang ulan sa Bahay Toro.",
  "start": 36.686,
  "end": 38.783,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala akong kausap.",
  "start": 39.424,
  "end": 40.382,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Marker na lang.",
  "start": 40.745,
  "end": 41.411,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Kumapit ka, Indio!",
  "start": 42.033,
  "end": 43.01,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Teka, nagsalita 'yung aso?",
  "start": 43.653,
  "end": 45.631,
  "style": "shocked",
  "speaker": "INDIO"
 },
 {
  "text": "Agosto 1896.",
  "start": 46.453,
  "end": 48.973,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang bakuran sa labas ng Maynila.",
  "start": 49.353,
  "end": 51.182,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sino ka?",
  "start": 51.823,
  "end": 52.175,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "Sino'ng nagsama sa'yo rito?",
  "start": 52.555,
  "end": 53.97,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "May nagsumbong sa amin sa Kastila nitong linggo.",
  "start": 54.662,
  "end": 56.938,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Kaya lahat ng narito, may dalang cedula ngayong gabi.",
  "start": 57.318,
  "end": 60.127,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Ilabas mo ang sa'yo.",
  "start": 60.507,
  "end": 61.51,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Cedula?",
  "start": 62.141,
  "end": 62.628,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "'Yan din ang hinanap sa akin kaninang umaga.",
  "start": 62.855,
  "end": 64.985,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "Uso pa rin pala.",
  "start": 65.258,
  "end": 66.029,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "Sabi ng titser ko, pinunit nila ang cedula.",
  "start": 66.687,
  "end": 68.988,
  "style": "whisper",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Walang nagsabing hahanapan muna ako.",
  "start": 69.269,
  "end": 70.936,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Walang papel, walang kakilala.",
  "start": 71.597,
  "end": 73.288,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Espiya 'yan.",
  "start": 73.668,
  "end": 74.396,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Unang araw ko sa nakaraan.",
  "start": 75.017,
  "end": 76.155,
  "style": "whisper",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Mukhang huling araw ko na rin.",
  "start": 76.535,
  "end": 77.746,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Par.",
  "start": 78.527,
  "end": 78.768,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Sabihin mo ang totoo.",
  "start": 79.01,
  "end": 80.035,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "'Yun lang ang meron ka.",
  "start": 80.415,
  "end": 82.026,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Wala akong cedula.",
  "start": 82.707,
  "end": 83.622,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong trabaho.",
  "start": 83.943,
  "end": 84.788,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong kahit ano.",
  "start": 85.168,
  "end": 86.216,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya nga ako napadpad dito.",
  "start": 86.671,
  "end": 88.288,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala rin akong cedula.",
  "start": 88.88,
  "end": 89.947,
  "style": "whisper",
  "speaker": "ISLAW"
 },
 {
  "text": "Hindi kayang bayaran ni Itay.",
  "start": 90.229,
  "end": 91.658,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Kinausap ko sila.",
  "start": 92.31,
  "end": 93.096,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "May bayad nga lang: hapunan mo.",
  "start": 93.338,
  "end": 94.729,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi tumatahimik ang aso sa espiya.",
  "start": 95.37,
  "end": 97.15,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Kalagan n'yo siya.",
  "start": 97.53,
  "end": 98.338,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Sino ka ba talaga?",
  "start": 99.019,
  "end": 100.175,
  "style": "uneasy",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Wala.",
  "start": 100.861,
  "end": 101.094,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Tambay lang.",
  "start": 101.42,
  "end": 101.868,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Islaw, ano'ng tawag sa lugar na 'to?",
  "start": 102.488,
  "end": 105.135,
  "style": "curious",
  "speaker": "INDIO"
 },
 {
  "text": "Ewan.",
  "start": 105.807,
  "end": 106.1,
  "style": "shrug",
  "speaker": "ISLAW"
 },
 {
  "text": "Basta dito.",
  "start": 106.48,
  "end": 107.093,
  "style": "shrug",
  "speaker": "ISLAW"
 },
 {
  "text": "Tandaan mo 'yan, par.",
  "start": 107.776,
  "end": 108.58,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Balang araw, pag-aawayan nila kung saan mismo ito nangyari.",
  "start": 108.882,
  "end": 111.575,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "At nagsimula na.",
  "start": 112.341,
  "end": 113.367,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kapag pinunit mo 'yan, wala na tayong uuwian.",
  "start": 114.04,
  "end": 116.937,
  "style": "soft",
  "speaker": "ORIANG"
 },
 {
  "text": "Kaya nga pupunitin ko.",
  "start": 117.519,
  "end": 118.807,
  "style": "quiet",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Para may uuwian ang lahat.",
  "start": 119.149,
  "end": 120.658,
  "style": "quiet",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Huwag kang tumitig, par.",
  "start": 121.278,
  "end": 122.515,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Ang Supremo.",
  "start": 123.158,
  "end": 124.143,
  "style": "whisper",
  "speaker": "ISLAW"
 },
 {
  "text": "Punitin ang mga cedula!",
  "start": 124.752,
  "end": 125.976,
  "style": "shout",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Mabuhay ang Pilipinas!",
  "start": 126.561,
  "end": 127.868,
  "style": "shout",
  "speaker": "MGA KATIPUNERO"
 },
 {
  "text": "Buwis namin 'yan sa Kastila.",
  "start": 128.49,
  "end": 129.837,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "Kapag pinunit mo, wala nang atrasan.",
  "start": 130.217,
  "end": 132.349,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "'Yung papel na kulang sa akin kaninang umaga, pinupunit nila para sa kalayaan.",
  "start": 132.99,
  "end": 137.199,
  "style": "whisper",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Kuya, babalik ka ba?",
  "start": 137.83,
  "end": 138.981,
  "style": "hopeful",
  "speaker": "ISLAW"
 },
 {
  "text": "Lumamig ang medalyon.",
  "start": 139.827,
  "end": 141.133,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "May marka ka na, par.",
  "start": 141.796,
  "end": 142.976,
  "style": "fading",
  "speaker": "USMAN"
 },
 {
  "text": "Una pa lang 'yan.",
  "start": 143.158,
  "end": 143.803,
  "style": "fading",
  "speaker": "USMAN"
 },
 {
  "text": "Aray.",
  "start": 144.435,
  "end": 144.676,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Usman.",
  "start": 145.056,
  "end": 145.783,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "'Yun ang itatawag ko sa'yo.",
  "start": 146.163,
  "end": 147.554,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Pangalan ng aso sa mga kuwento ni Lolo.",
  "start": 148.075,
  "end": 150.154,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "May babaeng nakatingin sa akin, na parang kilala niya ako.",
  "start": 150.775,
  "end": 153.783,
  "style": "whisper",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "At sa sanglaan, bukas pa ang ilaw.",
  "start": 154.404,
  "end": 156.623,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tanso lang pala, ha.",
  "start": 157.284,
  "end": 158.271,
  "style": "soft",
  "speaker": "KATULONG"
 },
 {
  "text": "Ikaw, ka-Indio: kung hinanapan ka ng papel na wala ka, magsisinungaling ka ba, o aamin?",
  "start": 159.169,
  "end": 164.638,
  "style": "curious",
  "speaker": "INDIO",
  "aside": true
 }
]