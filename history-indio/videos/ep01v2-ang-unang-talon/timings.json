[
 {
  "text": "Nasaan ang cedula mo?!",
  "start": 0.0,
  "end": 1.186,
  "style": "shout",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Walang cedula, kaya may itak sa leeg ko ngayon.",
  "start": 1.769,
  "end": 4.298,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 4.899,
  "end": 5.693,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Malas daw ako.",
  "start": 6.073,
  "end": 7.081,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Ganito 'yan nagsimula.",
  "start": 7.461,
  "end": 8.368,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Kaninang umaga, sa Quezon City, pumila si Indio para sa trabaho.",
  "start": 9.128,
  "end": 13.776,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Maghapon akong pumila.",
  "start": 14.382,
  "end": 15.506,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Wala pala akong cedula, 'yung resibo ng buwis.",
  "start": 15.707,
  "end": 17.835,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi ko alam na kailangan pala 'yon.",
  "start": 18.096,
  "end": 19.601,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Walang trabaho, walang pamasahe.",
  "start": 20.186,
  "end": 22.182,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kaya dinala niya sa sanglaan ang nag-iisang mana niya: ang lumang medalyon ng Lolo niya.",
  "start": 22.562,
  "end": 27.115,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pamasahe lang po sana.",
  "start": 27.686,
  "end": 28.863,
  "style": "hopeful",
  "speaker": "INDIO"
 },
 {
  "text": "Tanso lang 'yan, tol.",
  "start": 29.415,
  "end": 30.645,
  "style": "bored",
  "speaker": "MAY-ARI"
 },
 {
  "text": "Walang halaga.",
  "start": 31.025,
  "end": 31.713,
  "style": "bored",
  "speaker": "MAY-ARI"
 },
 {
  "text": "Pero bago ito ibinalik, palihim itong idiniin ng katulong sa isang pirasong pagkit.",
  "start": 32.405,
  "end": 37.644,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Gutom na 'ko.",
  "start": 38.199,
  "end": 38.741,
  "style": "sigh",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kanto, may paresan.",
  "start": 39.381,
  "end": 41.438,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi niya kaya ang isang mangkok.",
  "start": 41.818,
  "end": 43.504,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tinapay lang ang nabili niya.",
  "start": 43.884,
  "end": 45.51,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pares: taga-Quezon City, gaya ko.",
  "start": 46.091,
  "end": 48.867,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Sabi nila, nagsimula ito sa Retiro noong 1979.",
  "start": 49.247,
  "end": 53.816,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon, nasa buong Pilipinas na.",
  "start": 54.196,
  "end": 56.021,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Diwata, baka naman!",
  "start": 56.591,
  "end": 58.128,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Pagsapit ng gabi, bumuhos ang ulan.",
  "start": 58.98,
  "end": 61.437,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sumilong si Indio sa dambana ng Pugad Lawin, sa Bahay Toro.",
  "start": 61.817,
  "end": 65.95,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala akong kausap.",
  "start": 66.505,
  "end": 67.463,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Marker na lang.",
  "start": 67.826,
  "end": 68.492,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Binasa niya nang malakas ang nakasulat.",
  "start": 69.079,
  "end": 71.235,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Uminit ang medalyon sa dibdib niya.",
  "start": 71.615,
  "end": 73.421,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At tumigil sa ere ang mga patak ng ulan.",
  "start": 73.801,
  "end": 76.229,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kumapit ka, Indio!",
  "start": 76.809,
  "end": 77.786,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Mula sa liwanag, lumundag ang isang asong itim.",
  "start": 78.379,
  "end": 81.527,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Teka, nagsalita 'yung aso?",
  "start": 82.178,
  "end": 83.805,
  "style": "shocked",
  "speaker": "INDIO"
 },
 {
  "text": "Agosto 1896.",
  "start": 84.602,
  "end": 87.389,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang bakuran sa labas ng Maynila.",
  "start": 87.769,
  "end": 89.735,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Daan-daang lalaki, may mga sulo.",
  "start": 90.115,
  "end": 92.142,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinablot si Indio, at hinarang ng isang batang may itak.",
  "start": 92.657,
  "end": 95.976,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sino ka?",
  "start": 96.516,
  "end": 96.909,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "Sino'ng nagsama sa'yo rito?",
  "start": 97.289,
  "end": 98.503,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "May nagsumbong sa amin sa Kastila.",
  "start": 99.125,
  "end": 100.779,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Kaya lahat ng narito, may dalang cedula ngayong gabi.",
  "start": 101.159,
  "end": 104.149,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Ilabas mo ang sa'yo.",
  "start": 104.529,
  "end": 105.473,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Cedula?",
  "start": 106.114,
  "end": 106.617,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "'Yan din ang hinanap sa akin kaninang umaga.",
  "start": 106.997,
  "end": 109.153,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "Walang papel, walang kakilala.",
  "start": 109.729,
  "end": 111.42,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Espiya 'yan.",
  "start": 111.8,
  "end": 112.528,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Itinali ang mga kamay niya.",
  "start": 113.114,
  "end": 114.51,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Idinikit ang itak sa leeg niya.",
  "start": 114.89,
  "end": 117.102,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Unang araw ko sa nakaraan.",
  "start": 117.703,
  "end": 119.022,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Mukhang huling araw ko na rin.",
  "start": 119.203,
  "end": 120.411,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Par.",
  "start": 120.981,
  "end": 121.292,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Sabihin mo ang totoo.",
  "start": 121.634,
  "end": 122.58,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "'Yun lang ang meron ka.",
  "start": 122.96,
  "end": 123.988,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Wala akong cedula.",
  "start": 124.66,
  "end": 125.635,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong trabaho.",
  "start": 125.997,
  "end": 126.962,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong kahit ano.",
  "start": 127.304,
  "end": 128.309,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya nga ako napadpad dito.",
  "start": 128.835,
  "end": 130.221,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Natigilan ang bata.",
  "start": 130.808,
  "end": 132.046,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumaba ang itak.",
  "start": 132.368,
  "end": 133.435,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala rin akong cedula.",
  "start": 133.997,
  "end": 135.214,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Hindi kayang bayaran ni Itay.",
  "start": 135.516,
  "end": 136.965,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Saka lumapit ang mga aso ng kampo.",
  "start": 137.556,
  "end": 139.552,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Inamoy siya, kinain ang tinapay niya, at humiga sa paanan niya.",
  "start": 139.932,
  "end": 143.845,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kinausap ko sila.",
  "start": 144.496,
  "end": 145.282,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "May bayad nga lang: hapunan mo.",
  "start": 145.524,
  "end": 146.915,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi tumatahimik ang aso sa espiya.",
  "start": 147.491,
  "end": 149.271,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Kalagan n'yo siya.",
  "start": 149.651,
  "end": 150.459,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Sino ka ba talaga?",
  "start": 151.105,
  "end": 151.888,
  "style": "uneasy",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Wala.",
  "start": 152.462,
  "end": 152.695,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Tambay lang.",
  "start": 153.075,
  "end": 153.709,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Sa gilid ng liwanag, may mag-asawang nagpapaalam.",
  "start": 154.46,
  "end": 157.56,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinali ng babae ang pulang panyo sa leeg ng lalaki.",
  "start": 157.94,
  "end": 160.889,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kapag pinunit mo 'yan, wala na tayong uuwian.",
  "start": 161.53,
  "end": 164.427,
  "style": "soft",
  "speaker": "ORIANG"
 },
 {
  "text": "Kaya nga pupunitin ko.",
  "start": 165.024,
  "end": 166.151,
  "style": "quiet",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Para may uuwian ang lahat.",
  "start": 166.531,
  "end": 168.102,
  "style": "quiet",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Huwag kang tumitig, par.",
  "start": 168.687,
  "end": 169.924,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Humakbang ang lalaki sa liwanag, at itinaas ang kanyang cedula.",
  "start": 170.487,
  "end": 174.696,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang Supremo.",
  "start": 175.307,
  "end": 176.083,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Si Andres Bonifacio.",
  "start": 176.463,
  "end": 177.534,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Punitin ang mga cedula!",
  "start": 178.266,
  "end": 179.571,
  "style": "shout",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Mabuhay ang Pilipinas!",
  "start": 180.126,
  "end": 181.433,
  "style": "shout",
  "speaker": "MGA KATIPUNERO"
 },
 {
  "text": "Buwis namin 'yan sa Kastila.",
  "start": 182.02,
  "end": 183.367,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "Kapag pinunit mo, wala nang atrasan.",
  "start": 183.747,
  "end": 185.879,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "'Yung papel na kulang sa akin kaninang umaga, pinupunit nila para sa kalayaan.",
  "start": 186.44,
  "end": 190.588,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Walang mapunit si Islaw.",
  "start": 191.159,
  "end": 192.554,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinaas na lang niya ang kamao.",
  "start": 192.934,
  "end": 194.421,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinaas din ni Indio ang kanya.",
  "start": 194.801,
  "end": 196.408,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kuya, babalik ka ba?",
  "start": 197.029,
  "end": 198.506,
  "style": "hopeful",
  "speaker": "ISLAW"
 },
 {
  "text": "Bago pa siya makasagot, lumamig ang medalyon.",
  "start": 199.324,
  "end": 202.092,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "May marka ka na, par.",
  "start": 202.738,
  "end": 203.718,
  "style": "fading",
  "speaker": "USMAN"
 },
 {
  "text": "Una pa lang 'yan.",
  "start": 203.799,
  "end": 204.445,
  "style": "fading",
  "speaker": "USMAN"
 },
 {
  "text": "Quezon City ulit.",
  "start": 204.997,
  "end": 206.204,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ulan.",
  "start": 206.584,
  "end": 207.129,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala na ang aso.",
  "start": 207.509,
  "end": 208.416,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pero sa braso ni Indio, may guhit na umuusok pa.",
  "start": 208.947,
  "end": 212.126,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Aray.",
  "start": 212.777,
  "end": 213.119,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Usman.",
  "start": 213.499,
  "end": 214.226,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "'Yun ang itatawag ko sa'yo.",
  "start": 214.606,
  "end": 215.856,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Pangalan ng aso sa mga kuwento ni Lolo.",
  "start": 216.342,
  "end": 218.349,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kabilang kalye, may babaeng nakatitig sa kanya, na parang kilala siya.",
  "start": 218.895,
  "end": 223.543,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At sa sanglaan, bukas pa ang ilaw.",
  "start": 224.144,
  "end": 226.027,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hawak ng katulong ang pagkit: buong-buo ang bakas ng medalyon.",
  "start": 226.407,
  "end": 230.474,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tanso lang pala, ha.",
  "start": 231.114,
  "end": 231.977,
  "style": "soft",
  "speaker": "KATULONG"
 },
 {
  "text": "Ikaw, ka-Indio: kung hinanapan ka ng papel na wala ka, magsisinungaling ka ba, o aamin?",
  "start": 232.701,
  "end": 238.489,
  "style": "curious",
  "speaker": "INDIO"
 }
]