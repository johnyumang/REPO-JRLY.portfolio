[
 {
  "text": "Nasaan ang cedula mo?!",
  "start": 0.0,
  "end": 1.065,
  "style": "shout",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Walang cedula, kaya may itak sa leeg ko ngayon.",
  "start": 1.638,
  "end": 3.996,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 4.588,
  "end": 5.363,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Malas daw ako.",
  "start": 5.665,
  "end": 6.308,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Ganito 'yan nagsimula.",
  "start": 6.688,
  "end": 7.757,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Kaninang umaga, sa Quezon City, pumila si Indio para sa trabaho.",
  "start": 8.708,
  "end": 13.338,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Maghapon akong pumila.",
  "start": 13.943,
  "end": 15.137,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Wala pala akong cedula, 'yung resibo ng buwis.",
  "start": 15.517,
  "end": 18.406,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi ko alam na kailangan pala 'yon.",
  "start": 18.786,
  "end": 20.513,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya dinala niya sa sanglaan ang nag-iisang mana niya: ang lumang medalyon ng Lolo niya.",
  "start": 21.098,
  "end": 26.017,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pamasahe lang po sana.",
  "start": 26.578,
  "end": 27.763,
  "style": "hopeful",
  "speaker": "INDIO"
 },
 {
  "text": "Tanso lang 'yan, tol.",
  "start": 28.375,
  "end": 29.605,
  "style": "bored",
  "speaker": "MAY-ARI"
 },
 {
  "text": "Walang halaga.",
  "start": 29.985,
  "end": 30.673,
  "style": "bored",
  "speaker": "MAY-ARI"
 },
 {
  "text": "Sa likod ng may-ari, may katulong na kinakalawang ang kamay.",
  "start": 31.365,
  "end": 34.683,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bago ibinalik ang medalyon, palihim niya itong idiniin sa isang pirasong pagkit.",
  "start": 35.063,
  "end": 39.634,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Gutom na 'ko.",
  "start": 40.189,
  "end": 40.729,
  "style": "sigh",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kanto, may paresan.",
  "start": 41.317,
  "end": 43.374,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi niya kaya ang isang mangkok.",
  "start": 43.754,
  "end": 45.44,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tinapay lang ang nabili niya.",
  "start": 45.82,
  "end": 47.446,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pares: taga-Quezon City, gaya ko.",
  "start": 48.027,
  "end": 50.803,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Sabi nila, nagsimula ito sa Retiro noong 1979.",
  "start": 51.183,
  "end": 55.752,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon, nasa buong Pilipinas na.",
  "start": 56.132,
  "end": 57.957,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Diwata, baka naman!",
  "start": 58.527,
  "end": 59.914,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Pagsapit ng gabi, bumuhos ang ulan.",
  "start": 60.825,
  "end": 63.282,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sumilong si Indio sa dambana ng Pugad Lawin, sa Bahay Toro.",
  "start": 63.662,
  "end": 67.795,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala akong kausap.",
  "start": 68.35,
  "end": 69.308,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Marker na lang.",
  "start": 69.671,
  "end": 70.337,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Binasa niya nang malakas ang nakasulat.",
  "start": 70.924,
  "end": 73.08,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Uminit ang medalyon sa dibdib niya.",
  "start": 73.46,
  "end": 75.266,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At tumigil sa ere ang mga patak ng ulan.",
  "start": 75.646,
  "end": 78.074,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mula sa liwanag, lumundag ang isang asong itim.",
  "start": 78.654,
  "end": 81.783,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kumapit ka, Indio!",
  "start": 82.404,
  "end": 83.381,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Teka, nagsalita 'yung aso?",
  "start": 84.004,
  "end": 85.622,
  "style": "shocked",
  "speaker": "INDIO"
 },
 {
  "text": "Agosto 1896.",
  "start": 86.549,
  "end": 89.044,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang bakuran sa labas ng Maynila, puno ng mga Katipunero.",
  "start": 89.424,
  "end": 92.951,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinablot si Indio, at hinarang ng isang batang may itak.",
  "start": 93.331,
  "end": 97.059,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Siya si Islaw.",
  "start": 97.594,
  "end": 98.426,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Labindalawang taong gulang, anak ng magsasaka, at bantay ng bakuran ngayong gabi.",
  "start": 98.806,
  "end": 104.222,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sino ka?",
  "start": 104.813,
  "end": 105.165,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "Sino'ng nagsama sa'yo rito?",
  "start": 105.545,
  "end": 106.96,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "Lumapit ang pinuno ng mga bantay, isang Katipunerong hindi ngumingiti.",
  "start": 107.602,
  "end": 111.771,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "May nagsumbong sa amin sa Kastila.",
  "start": 112.371,
  "end": 114.006,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Kaya lahat ng narito, may dalang cedula ngayong gabi.",
  "start": 114.386,
  "end": 117.276,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Ilabas mo ang sa'yo.",
  "start": 117.656,
  "end": 118.661,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Cedula?",
  "start": 119.236,
  "end": 119.628,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "'Yan din ang hinanap sa akin kaninang umaga.",
  "start": 120.008,
  "end": 122.024,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "Walang papel, walang kakilala.",
  "start": 122.65,
  "end": 124.341,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Espiya 'yan.",
  "start": 124.721,
  "end": 125.449,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Itinali ang mga kamay niya.",
  "start": 125.99,
  "end": 127.386,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Idinikit ang itak sa leeg niya.",
  "start": 127.766,
  "end": 129.978,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Unang araw ko sa nakaraan.",
  "start": 130.609,
  "end": 131.928,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Mukhang huling araw ko na rin.",
  "start": 132.109,
  "end": 133.317,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Par.",
  "start": 133.917,
  "end": 134.228,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Sabihin mo ang totoo.",
  "start": 134.57,
  "end": 135.516,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "'Yun lang ang meron ka.",
  "start": 135.896,
  "end": 136.924,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Wala akong cedula.",
  "start": 137.551,
  "end": 138.385,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong trabaho.",
  "start": 138.765,
  "end": 139.772,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong kahit ano.",
  "start": 140.152,
  "end": 141.059,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya nga ako napadpad dito.",
  "start": 141.615,
  "end": 143.001,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Natigilan ang bata.",
  "start": 143.543,
  "end": 144.721,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumaba ang itak.",
  "start": 145.101,
  "end": 146.13,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala rin akong cedula.",
  "start": 146.732,
  "end": 147.749,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Hindi kayang bayaran ni Itay.",
  "start": 148.031,
  "end": 149.34,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Saka lumapit ang mga aso ng kampo.",
  "start": 149.961,
  "end": 151.957,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Inamoy siya, kinain ang tinapay niya, at humiga sa paanan niya.",
  "start": 152.337,
  "end": 156.25,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kinausap ko sila.",
  "start": 156.856,
  "end": 157.642,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "May bayad nga lang: hapunan mo.",
  "start": 157.884,
  "end": 159.275,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi tumatahimik ang aso sa espiya.",
  "start": 159.881,
  "end": 161.661,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Kalagan n'yo siya.",
  "start": 162.041,
  "end": 162.849,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Sino ka ba talaga?",
  "start": 163.45,
  "end": 164.233,
  "style": "uneasy",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Wala.",
  "start": 164.837,
  "end": 165.05,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Tambay lang.",
  "start": 165.43,
  "end": 166.064,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Sa gilid ng liwanag, may mag-asawang nagpapaalam.",
  "start": 167.016,
  "end": 170.113,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang babae, si Oriang.",
  "start": 170.214,
  "end": 171.938,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinali niya ang pulang panyo sa leeg ng lalaki.",
  "start": 172.318,
  "end": 175.285,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kapag pinunit mo 'yan, wala na tayong uuwian.",
  "start": 175.861,
  "end": 178.758,
  "style": "soft",
  "speaker": "ORIANG"
 },
 {
  "text": "Kaya nga pupunitin ko.",
  "start": 179.385,
  "end": 180.512,
  "style": "quiet",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Para may uuwian ang lahat.",
  "start": 180.892,
  "end": 182.463,
  "style": "quiet",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Huwag kang tumitig, par.",
  "start": 183.003,
  "end": 184.24,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Humakbang ang lalaki sa liwanag, at itinaas ang kanyang cedula.",
  "start": 184.833,
  "end": 188.472,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang Supremo.",
  "start": 189.103,
  "end": 190.079,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Si Andres Bonifacio.",
  "start": 190.459,
  "end": 191.71,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Punitin ang mga cedula!",
  "start": 192.412,
  "end": 193.648,
  "style": "shout",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Mabuhay ang Pilipinas!",
  "start": 194.233,
  "end": 195.54,
  "style": "shout",
  "speaker": "MGA KATIPUNERO"
 },
 {
  "text": "Buwis namin 'yan sa Kastila.",
  "start": 196.082,
  "end": 197.429,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "Kapag pinunit mo, wala nang atrasan.",
  "start": 197.809,
  "end": 199.941,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "'Yung papel na kulang sa akin kaninang umaga, pinupunit nila para sa kalayaan.",
  "start": 200.532,
  "end": 204.581,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Walang mapunit si Islaw, kaya kamao na lang ang itinaas nilang dalawa.",
  "start": 205.182,
  "end": 209.451,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kuya, babalik ka ba?",
  "start": 210.047,
  "end": 211.524,
  "style": "hopeful",
  "speaker": "ISLAW"
 },
 {
  "text": "Bago pa siya makasagot, lumamig ang medalyon.",
  "start": 212.522,
  "end": 215.29,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "May marka ka na, par.",
  "start": 215.891,
  "end": 217.071,
  "style": "fading",
  "speaker": "USMAN"
 },
 {
  "text": "Una pa lang 'yan.",
  "start": 217.253,
  "end": 217.898,
  "style": "fading",
  "speaker": "USMAN"
 },
 {
  "text": "Quezon City ulit.",
  "start": 218.48,
  "end": 219.706,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ulan.",
  "start": 220.086,
  "end": 220.43,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala na ang aso.",
  "start": 220.81,
  "end": 221.958,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pero sa braso ni Indio, may guhit na umuusok pa.",
  "start": 222.509,
  "end": 225.688,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Aray.",
  "start": 226.294,
  "end": 226.525,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Usman.",
  "start": 226.766,
  "end": 227.007,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "'Yun ang itatawag ko sa'yo.",
  "start": 227.387,
  "end": 228.613,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Pangalan ng aso sa mga kuwento ni Lolo.",
  "start": 229.169,
  "end": 231.176,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kabilang kalye, may babaeng nakatitig sa kanya, na parang kilala siya.",
  "start": 231.677,
  "end": 236.325,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa sanglaan, hawak ng katulong ang pagkit: buong-buo ang bakas ng medalyon.",
  "start": 236.956,
  "end": 242.024,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tanso lang pala, ha.",
  "start": 242.685,
  "end": 243.659,
  "style": "soft",
  "speaker": "KATULONG"
 },
 {
  "text": "Ikaw, ka-Indio: kung hinanapan ka ng papel na wala ka, magsisinungaling ka ba, o aamin?",
  "start": 244.338,
  "end": 249.807,
  "style": "curious",
  "speaker": "INDIO"
 }
]