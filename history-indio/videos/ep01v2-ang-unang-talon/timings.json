[
 {
  "text": "Kaninang umaga, walang cedula, kaya walang trabaho.",
  "start": 0.0,
  "end": 3.298,
  "style": "dramatic",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ngayong gabi, walang cedula, kaya may itak sa leeg ko.",
  "start": 3.949,
  "end": 7.738,
  "style": "dramatic",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 8.379,
  "end": 9.257,
  "style": "playful",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Malas daw ako.",
  "start": 9.48,
  "end": 10.147,
  "style": "playful",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Quezon City.",
  "start": 10.948,
  "end": 11.605,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Umaga.",
  "start": 11.985,
  "end": 12.414,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am, pang-anim na apply ko na po ito ngayong buwan.",
  "start": 13.056,
  "end": 15.724,
  "style": "hopeful",
  "speaker": "INDIO"
 },
 {
  "text": "Kulang.",
  "start": 16.344,
  "end": 16.726,
  "style": "flat",
  "speaker": "BABAE SA BINTANA"
 },
 {
  "text": "Walang cedula, 'yung resibo ng buwis mo.",
  "start": 17.106,
  "end": 19.678,
  "style": "flat",
  "speaker": "BABAE SA BINTANA"
 },
 {
  "text": "Tatawagan ka na lang.",
  "start": 20.058,
  "end": 21.083,
  "style": "flat",
  "speaker": "BABAE SA BINTANA"
 },
 {
  "text": "Malas ka talaga, tol.",
  "start": 21.724,
  "end": 22.91,
  "style": "mocking",
  "speaker": "LALAKI SA PILA"
 },
 {
  "text": "Pang-anim na \"malas\" ko na rin 'yan ngayong buwan.",
  "start": 23.613,
  "end": 25.858,
  "style": "dry",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Tanghali.",
  "start": 26.698,
  "end": 27.223,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang sanglaan.",
  "start": 27.567,
  "end": 28.416,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pamasahe lang po sana.",
  "start": 29.098,
  "end": 30.411,
  "style": "hopeful",
  "speaker": "INDIO"
 },
 {
  "text": "Tanso lang 'yan, tol.",
  "start": 31.025,
  "end": 32.255,
  "style": "bored",
  "speaker": "MAY-ARI"
 },
 {
  "text": "Walang halaga.",
  "start": 32.635,
  "end": 33.323,
  "style": "bored",
  "speaker": "MAY-ARI"
 },
 {
  "text": "Pati medalyon ko, bagsak sa interview.",
  "start": 34.035,
  "end": 36.421,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Gabi.",
  "start": 37.243,
  "end": 37.514,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumuhos ang ulan sa Bahay Toro.",
  "start": 37.894,
  "end": 39.991,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hapunan.",
  "start": 40.632,
  "end": 41.115,
  "style": "sigh",
  "speaker": "INDIO"
 },
 {
  "text": "Isa.",
  "start": 41.495,
  "end": 42.059,
  "style": "sigh",
  "speaker": "INDIO"
 },
 {
  "text": "Buti pa 'yung nasa tarpaulin, may trabaho.",
  "start": 42.439,
  "end": 44.632,
  "style": "sigh",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong kausap.",
  "start": 45.232,
  "end": 46.19,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Marker na lang.",
  "start": 46.553,
  "end": 47.219,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Kumapit ka, Indio!",
  "start": 47.841,
  "end": 48.818,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Teka, nagsalita 'yung aso?",
  "start": 49.461,
  "end": 51.439,
  "style": "shocked",
  "speaker": "INDIO"
 },
 {
  "text": "Agosto 1896.",
  "start": 52.291,
  "end": 54.811,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang bakuran sa labas ng Maynila.",
  "start": 55.191,
  "end": 57.02,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sino ka?",
  "start": 57.661,
  "end": 58.013,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "Sino'ng nagsama sa'yo rito?",
  "start": 58.393,
  "end": 59.808,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "May nagsumbong sa amin sa Kastila nitong linggo.",
  "start": 60.5,
  "end": 62.857,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Kaya lahat ng narito, may dalang cedula ngayong gabi.",
  "start": 63.237,
  "end": 66.286,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Ilabas mo ang sa'yo.",
  "start": 66.666,
  "end": 67.69,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Cedula?",
  "start": 68.29,
  "end": 68.842,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "'Yan din ang hinanap sa akin kaninang umaga.",
  "start": 69.222,
  "end": 71.913,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "Uso pa rin pala.",
  "start": 72.293,
  "end": 73.558,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "Sabi ng titser ko, pinunit nila ang cedula.",
  "start": 74.179,
  "end": 76.958,
  "style": "whisper",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Walang nagsabing hahanapan muna ako.",
  "start": 77.338,
  "end": 79.607,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Walang papel, walang kakilala.",
  "start": 80.258,
  "end": 81.949,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Espiya 'yan.",
  "start": 82.329,
  "end": 83.057,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Unang araw ko sa nakaraan.",
  "start": 83.678,
  "end": 84.816,
  "style": "whisper",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Mukhang huling araw ko na rin.",
  "start": 85.196,
  "end": 86.407,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Par.",
  "start": 87.143,
  "end": 87.384,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Sabihin mo ang totoo.",
  "start": 87.626,
  "end": 88.651,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "'Yun lang ang meron ka.",
  "start": 89.031,
  "end": 90.642,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Wala akong cedula.",
  "start": 91.323,
  "end": 92.185,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong trabaho.",
  "start": 92.516,
  "end": 93.378,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong kahit ano.",
  "start": 93.758,
  "end": 94.859,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya nga ako napadpad dito.",
  "start": 95.364,
  "end": 96.981,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala rin akong cedula.",
  "start": 97.573,
  "end": 98.609,
  "style": "whisper",
  "speaker": "ISLAW"
 },
 {
  "text": "Hindi kayang bayaran ni Itay.",
  "start": 98.989,
  "end": 100.48,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Kinausap ko sila.",
  "start": 101.122,
  "end": 101.908,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "May bayad nga lang: hapunan mo.",
  "start": 102.15,
  "end": 103.541,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi tumatahimik ang aso sa espiya.",
  "start": 104.182,
  "end": 105.962,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Kalagan n'yo siya.",
  "start": 106.342,
  "end": 107.15,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Sino ka ba talaga?",
  "start": 107.831,
  "end": 108.987,
  "style": "uneasy",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Wala.",
  "start": 109.673,
  "end": 109.906,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Tambay lang.",
  "start": 110.232,
  "end": 110.68,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Islaw, ano'ng tawag sa lugar na 'to?",
  "start": 111.3,
  "end": 113.947,
  "style": "curious",
  "speaker": "INDIO"
 },
 {
  "text": "Ewan.",
  "start": 114.619,
  "end": 114.912,
  "style": "shrug",
  "speaker": "ISLAW"
 },
 {
  "text": "Basta dito.",
  "start": 115.292,
  "end": 115.905,
  "style": "shrug",
  "speaker": "ISLAW"
 },
 {
  "text": "Tandaan mo 'yan, par.",
  "start": 116.588,
  "end": 117.392,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Balang araw, pag-aawayan nila kung saan mismo ito nangyari.",
  "start": 117.694,
  "end": 120.387,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "At nagsimula na.",
  "start": 121.183,
  "end": 122.209,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kapag pinunit mo 'yan, wala na tayong uuwian.",
  "start": 122.882,
  "end": 125.779,
  "style": "soft",
  "speaker": "ORIANG"
 },
 {
  "text": "Kaya nga pupunitin ko.",
  "start": 126.391,
  "end": 127.679,
  "style": "quiet",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Para may uuwian ang lahat.",
  "start": 128.021,
  "end": 129.53,
  "style": "quiet",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Huwag kang tumitig, par.",
  "start": 130.15,
  "end": 131.387,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Ang Supremo.",
  "start": 132.03,
  "end": 133.015,
  "style": "whisper",
  "speaker": "ISLAW"
 },
 {
  "text": "Punitin ang mga cedula!",
  "start": 133.654,
  "end": 134.858,
  "style": "shout",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Mabuhay ang Pilipinas!",
  "start": 135.401,
  "end": 136.708,
  "style": "shout",
  "speaker": "MGA KATIPUNERO"
 },
 {
  "text": "Buwis namin 'yan sa Kastila.",
  "start": 137.33,
  "end": 138.677,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "Kapag pinunit mo, wala nang atrasan.",
  "start": 139.057,
  "end": 141.189,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "'Yung papel na kulang sa akin kaninang umaga, pinupunit nila para sa kalayaan.",
  "start": 141.83,
  "end": 146.039,
  "style": "whisper",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Kuya, babalik ka ba?",
  "start": 146.67,
  "end": 147.821,
  "style": "hopeful",
  "speaker": "ISLAW"
 },
 {
  "text": "Lumamig ang medalyon.",
  "start": 148.697,
  "end": 150.003,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "May marka ka na, par.",
  "start": 150.666,
  "end": 151.846,
  "style": "fading",
  "speaker": "USMAN"
 },
 {
  "text": "Una pa lang 'yan.",
  "start": 152.028,
  "end": 152.673,
  "style": "fading",
  "speaker": "USMAN"
 },
 {
  "text": "Aray.",
  "start": 153.305,
  "end": 153.546,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Usman.",
  "start": 153.926,
  "end": 154.653,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "'Yun ang itatawag ko sa'yo.",
  "start": 155.033,
  "end": 156.424,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Pangalan ng aso sa mga kuwento ni Lolo.",
  "start": 156.975,
  "end": 159.054,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "May babaeng nakatingin sa akin, na parang kilala niya ako.",
  "start": 159.675,
  "end": 162.683,
  "style": "whisper",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "At sa sanglaan, bukas pa ang ilaw.",
  "start": 163.304,
  "end": 165.523,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tanso lang pala, ha.",
  "start": 166.184,
  "end": 167.17,
  "style": "soft",
  "speaker": "KATULONG"
 },
 {
  "text": "Ikaw, ka-Indio: kung hinanapan ka ng papel na wala ka, magsisinungaling ka ba, o aamin?",
  "start": 168.099,
  "end": 173.568,
  "style": "curious",
  "speaker": "INDIO",
  "aside": true
 }
]