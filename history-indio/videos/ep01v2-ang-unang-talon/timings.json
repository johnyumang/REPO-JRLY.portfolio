[
 {
  "text": "Nasaan ang cedula mo?!",
  "start": 0.015,
  "end": 1.12,
  "style": "shout",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Walang cedula, kaya may itak sa leeg ko ngayon.",
  "start": 1.585,
  "end": 3.975,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 4.4,
  "end": 5.29,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Malas daw ako.",
  "start": 5.637,
  "end": 6.367,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Ganito 'yan nagsimula.",
  "start": 6.792,
  "end": 7.702,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Kaninang umaga, sa Quezon City, pumila si Indio para sa trabaho.",
  "start": 8.547,
  "end": 13.217,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Maghapon akong pumila.",
  "start": 13.682,
  "end": 14.932,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Wala pala akong cedula, 'yung resibo ng buwis.",
  "start": 15.357,
  "end": 18.097,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi ko alam na kailangan pala 'yon.",
  "start": 18.522,
  "end": 19.972,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya dinala niya sa sanglaan ang nag-iisang mana niya: ang lumang medalyon ng Lolo niya.",
  "start": 20.437,
  "end": 25.377,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pamasahe lang po sana.",
  "start": 25.842,
  "end": 27.052,
  "style": "hopeful",
  "speaker": "INDIO"
 },
 {
  "text": "Tanso lang 'yan, tol.",
  "start": 27.517,
  "end": 28.827,
  "style": "bored",
  "speaker": "MAY-ARI"
 },
 {
  "text": "Walang halaga.",
  "start": 29.252,
  "end": 30.082,
  "style": "bored",
  "speaker": "MAY-ARI"
 },
 {
  "text": "Sa likod ng may-ari, may katulong na kinakalawang ang kamay.",
  "start": 30.547,
  "end": 33.947,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bago ibinalik ang medalyon, palihim niya itong idiniin sa isang pirasong pagkit.",
  "start": 34.372,
  "end": 38.832,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Gutom na 'ko.",
  "start": 39.297,
  "end": 39.937,
  "style": "sigh",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kanto, may paresan.",
  "start": 40.402,
  "end": 42.562,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi niya kaya ang isang mangkok.",
  "start": 42.987,
  "end": 44.497,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tinapay lang ang nabili niya.",
  "start": 44.922,
  "end": 46.977,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pares: taga-Quezon City, gaya ko.",
  "start": 47.442,
  "end": 50.282,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Sabi nila, nagsimula ito sa Retiro noong 1979.",
  "start": 50.707,
  "end": 55.107,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon, nasa buong Pilipinas na.",
  "start": 55.532,
  "end": 57.352,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Diwata, baka naman!",
  "start": 57.777,
  "end": 59.227,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Pagsapit ng gabi, bumuhos ang ulan.",
  "start": 60.072,
  "end": 62.572,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sumilong si Indio sa dambana ng Pugad Lawin, sa Bahay Toro.",
  "start": 62.997,
  "end": 66.997,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala akong kausap.",
  "start": 67.462,
  "end": 68.382,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Marker na lang.",
  "start": 68.79,
  "end": 69.51,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Binasa niya nang malakas ang nakasulat.",
  "start": 69.975,
  "end": 72.065,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Uminit ang medalyon sa dibdib niya.",
  "start": 72.49,
  "end": 74.34,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At tumigil sa ere ang mga patak ng ulan.",
  "start": 74.765,
  "end": 77.135,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mula sa liwanag, lumundag ang isang asong itim.",
  "start": 77.56,
  "end": 80.76,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kumapit ka, Indio!",
  "start": 81.225,
  "end": 82.295,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Teka, nagsalita 'yung aso?",
  "start": 82.76,
  "end": 84.42,
  "style": "shocked",
  "speaker": "INDIO"
 },
 {
  "text": "Agosto 1896.",
  "start": 85.265,
  "end": 87.825,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang bakuran sa labas ng Maynila, puno ng mga Katipunero.",
  "start": 88.25,
  "end": 91.79,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinablot si Indio, at hinarang ng isang batang may itak.",
  "start": 92.215,
  "end": 95.895,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Siya si Islaw.",
  "start": 96.32,
  "end": 97.27,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Labindalawang taong gulang, anak ng magsasaka, at bantay ng bakuran ngayong gabi.",
  "start": 97.695,
  "end": 102.995,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sino ka?",
  "start": 103.46,
  "end": 103.92,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "Sino'ng nagsama sa'yo rito?",
  "start": 104.345,
  "end": 105.575,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "Lumapit ang pinuno ng mga bantay, isang Katipunerong hindi ngumingiti.",
  "start": 106.04,
  "end": 110.24,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "May nagsumbong sa amin sa Kastila.",
  "start": 110.705,
  "end": 112.405,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Kaya lahat ng narito, may dalang cedula ngayong gabi.",
  "start": 112.83,
  "end": 115.68,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Ilabas mo ang sa'yo.",
  "start": 116.105,
  "end": 117.074,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Cedula?",
  "start": 117.539,
  "end": 118.009,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "'Yan din ang hinanap sa akin kaninang umaga.",
  "start": 118.434,
  "end": 120.544,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "Walang papel, walang kakilala.",
  "start": 121.009,
  "end": 122.749,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Espiya 'yan.",
  "start": 123.174,
  "end": 123.844,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Itinali ang mga kamay niya.",
  "start": 124.309,
  "end": 125.799,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Idinikit ang itak sa leeg niya.",
  "start": 126.224,
  "end": 127.904,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Unang araw ko sa nakaraan.",
  "start": 128.369,
  "end": 129.749,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Mukhang huling araw ko na rin.",
  "start": 130.174,
  "end": 131.424,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Par.",
  "start": 131.889,
  "end": 132.229,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Sabihin mo ang totoo.",
  "start": 132.616,
  "end": 133.706,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "'Yun lang ang meron ka.",
  "start": 134.131,
  "end": 135.121,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Wala akong cedula.",
  "start": 135.586,
  "end": 136.506,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong trabaho.",
  "start": 136.931,
  "end": 137.961,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong kahit ano.",
  "start": 138.386,
  "end": 139.316,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya nga ako napadpad dito.",
  "start": 139.741,
  "end": 141.171,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Natigilan ang bata.",
  "start": 141.636,
  "end": 142.886,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumaba ang itak.",
  "start": 143.311,
  "end": 144.361,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala rin akong cedula.",
  "start": 144.826,
  "end": 145.916,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Hindi kayang bayaran ni Itay.",
  "start": 146.341,
  "end": 147.681,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Saka lumapit ang mga aso ng kampo.",
  "start": 148.146,
  "end": 150.236,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Inamoy siya, kinain ang tinapay niya, at humiga sa paanan niya.",
  "start": 150.661,
  "end": 154.601,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kinausap ko sila.",
  "start": 155.066,
  "end": 155.946,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "May bayad nga lang: hapunan mo.",
  "start": 156.371,
  "end": 157.851,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi tumatahimik ang aso sa espiya.",
  "start": 158.316,
  "end": 160.156,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Kalagan n'yo siya.",
  "start": 160.581,
  "end": 161.241,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Sino ka ba talaga?",
  "start": 161.706,
  "end": 162.556,
  "style": "uneasy",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Wala.",
  "start": 163.021,
  "end": 163.261,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Tambay lang.",
  "start": 163.686,
  "end": 164.196,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Sa gilid ng liwanag, may mag-asawang nagpapaalam.",
  "start": 165.041,
  "end": 168.161,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang babae, si Oriang.",
  "start": 168.586,
  "end": 170.396,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinali niya ang pulang panyo sa leeg ng lalaki.",
  "start": 170.821,
  "end": 173.521,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kapag pinunit mo 'yan, wala na tayong uuwian.",
  "start": 173.986,
  "end": 176.896,
  "style": "soft",
  "speaker": "ORIANG"
 },
 {
  "text": "Kaya nga pupunitin ko.",
  "start": 177.361,
  "end": 178.521,
  "style": "quiet",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Para may uuwian ang lahat.",
  "start": 178.946,
  "end": 180.426,
  "style": "quiet",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Huwag kang tumitig, par.",
  "start": 180.891,
  "end": 182.131,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Humakbang ang lalaki sa liwanag, at itinaas ang kanyang cedula.",
  "start": 182.596,
  "end": 186.246,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang Supremo.",
  "start": 186.711,
  "end": 187.781,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Si Andres Bonifacio.",
  "start": 188.206,
  "end": 189.456,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Punitin ang mga cedula!",
  "start": 190.001,
  "end": 191.231,
  "style": "shout",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Mabuhay ang Pilipinas!",
  "start": 191.696,
  "end": 193.066,
  "style": "shout",
  "speaker": "MGA KATIPUNERO"
 },
 {
  "text": "Buwis namin 'yan sa Kastila.",
  "start": 193.531,
  "end": 194.921,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "Kapag pinunit mo, wala nang atrasan.",
  "start": 195.346,
  "end": 197.496,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "'Yung papel na kulang sa akin kaninang umaga, pinupunit nila para sa kalayaan.",
  "start": 197.961,
  "end": 202.021,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Walang mapunit si Islaw, kaya kamao na lang ang itinaas nilang dalawa.",
  "start": 202.486,
  "end": 206.836,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kuya, babalik ka ba?",
  "start": 207.301,
  "end": 208.791,
  "style": "hopeful",
  "speaker": "ISLAW"
 },
 {
  "text": "Bago pa siya makasagot, lumamig ang medalyon.",
  "start": 209.636,
  "end": 212.486,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "May marka ka na, par.",
  "start": 212.951,
  "end": 214.171,
  "style": "fading",
  "speaker": "USMAN"
 },
 {
  "text": "Una pa lang 'yan.",
  "start": 214.596,
  "end": 215.316,
  "style": "fading",
  "speaker": "USMAN"
 },
 {
  "text": "Quezon City ulit.",
  "start": 215.781,
  "end": 216.921,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ulan.",
  "start": 217.346,
  "end": 217.836,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala na ang aso.",
  "start": 218.261,
  "end": 219.281,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pero sa braso ni Indio, may guhit na umuusok pa.",
  "start": 219.706,
  "end": 222.946,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Aray.",
  "start": 223.411,
  "end": 223.681,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Usman.",
  "start": 224.106,
  "end": 224.416,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "'Yun ang itatawag ko sa'yo.",
  "start": 224.841,
  "end": 225.911,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Pangalan ng aso sa mga kuwento ni Lolo.",
  "start": 226.336,
  "end": 228.336,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kabilang kalye, may babaeng nakatitig sa kanya, na parang kilala siya.",
  "start": 228.801,
  "end": 233.541,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa sanglaan, hawak ng katulong ang pagkit: buong-buo ang bakas ng medalyon.",
  "start": 233.966,
  "end": 239.126,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tanso lang pala, ha.",
  "start": 239.591,
  "end": 240.701,
  "style": "soft",
  "speaker": "KATULONG"
 },
 {
  "text": "Ikaw, ka-Indio: kung hinanapan ka ng papel na wala ka, magsisinungaling ka ba, o aamin?",
  "start": 241.166,
  "end": 246.666,
  "style": "curious",
  "speaker": "INDIO"
 }
]