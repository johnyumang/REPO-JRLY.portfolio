[
 {
  "text": "Kausap ang aso!",
  "start": 0.015,
  "end": 0.895,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Kausap ang aso!",
  "start": 1.32,
  "end": 2.785,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Grade five ako nang una akong pagtawanan dahil nagsabi ako ng totoo.",
  "start": 3.25,
  "end": 6.94,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon, pinapanood ko ulit.",
  "start": 7.365,
  "end": 9.155,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "At bawal akong lumapit.",
  "start": 9.56,
  "end": 10.95,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 11.375,
  "end": 12.325,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung nasa pasilyo, ako rin.",
  "start": 12.732,
  "end": 14.482,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Quezon City.",
  "start": 15.327,
  "end": 15.967,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Taong 2012.",
  "start": 16.392,
  "end": 17.612,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Dinala ng mapa si Indio sa dati niyang paaralan, kasama si M, ang babaeng may hawak ng mapa, at ang aso niyang si Usman.",
  "start": 18.037,
  "end": 25.747,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nagtago sila sa labas ng gate.",
  "start": 26.172,
  "end": 28.012,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang pangalawang tuldok sa mapa: ang dati kong paaralan.",
  "start": 28.477,
  "end": 31.367,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Akala ko, kayamanan ang hahanapin.",
  "start": 31.792,
  "end": 33.622,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Banana cue: saging na saba, may asukal, nakatuhog.",
  "start": 34.047,
  "end": 38.107,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "\"Cue\" raw, galing sa \"barbecue\", kasi nakatusok sa stick.",
  "start": 38.532,
  "end": 41.732,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Walang barbecue sa banana cue.",
  "start": 42.137,
  "end": 43.877,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Unang kasinungalingang natutunan ko sa eskwela, at masarap.",
  "start": 44.302,
  "end": 47.302,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Bawal kang lumapit sa sarili mo.",
  "start": 47.767,
  "end": 49.317,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa lente ka sumilip.",
  "start": 49.742,
  "end": 50.862,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ipapakita niyan ang nangyari rito.",
  "start": 51.287,
  "end": 53.057,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa lente, nakita ni Indio ang sarili niya noong bata: tahimik sa sulok, nagbabasa.",
  "start": 53.522,
  "end": 60.012,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ayun ka, par.",
  "start": 60.477,
  "end": 61.267,
  "style": "fond",
  "speaker": "USMAN"
 },
 {
  "text": "Maliit, pero kamukha mo na ang kunot ng noo.",
  "start": 61.692,
  "end": 63.782,
  "style": "fond",
  "speaker": "USMAN"
 },
 {
  "text": "Nagtanong si Ma'am Celia, ang guro, tungkol sa pinakamatandang batas.",
  "start": 64.627,
  "end": 68.987,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tumayo ang isang batang maayos ang buhok, ang pinakamatalino sa klase.",
  "start": 69.412,
  "end": 73.742,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am!",
  "start": 74.207,
  "end": 74.757,
  "style": "proud",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Ang Kodigo ni Kalantiaw po, isinulat noong 1433.",
  "start": 75.182,
  "end": 80.292,
  "style": "proud",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Labingwalong batas!",
  "start": 80.717,
  "end": 81.847,
  "style": "proud",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Tama.",
  "start": 82.312,
  "end": 82.712,
  "style": "warm",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "'Yan ang nasa libro natin.",
  "start": 83.137,
  "end": 84.567,
  "style": "warm",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Nagtaas ng kamay ang batang Indio.",
  "start": 85.032,
  "end": 87.072,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am, pasensya na po.",
  "start": 87.537,
  "end": 89.137,
  "style": "small",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Hindi po totoo ang kodigo.",
  "start": 89.562,
  "end": 91.272,
  "style": "small",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Mas marunong ka pa sa libro?",
  "start": 91.737,
  "end": 93.437,
  "style": "mocking",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "May libro po ang Lolo ko, gawa ni Scott.",
  "start": 93.902,
  "end": 96.492,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Sabi po roon, walang lumang papel na bumabanggit sa kodigo.",
  "start": 96.838,
  "end": 100.148,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Bago lang po ito lumitaw.",
  "start": 100.573,
  "end": 102.533,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Hindi po tugma.",
  "start": 102.958,
  "end": 103.988,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "\"Hindi tugma.\"",
  "start": 104.453,
  "end": 105.183,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sampung taon ako.",
  "start": 105.608,
  "end": 106.588,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Nakikita ko na pala ang hindi nakikita ng iba.",
  "start": 107.013,
  "end": 109.193,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Nagtawanan ang klase.",
  "start": 110.038,
  "end": 111.428,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tumakbo ang bata palabas.",
  "start": 111.853,
  "end": 113.502,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Indio, anak, sandali!",
  "start": 113.967,
  "end": 115.747,
  "style": "calling",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Tahimik, class!",
  "start": 116.114,
  "end": 117.004,
  "style": "calling",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Sa loob, isinabit ang medalyang Best in History sa batang maayos ang buhok.",
  "start": 117.469,
  "end": 122.199,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa gate, kinausap ng bata ang isang asong gala.",
  "start": 122.624,
  "end": 125.814,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nakita siya ng mga kaklase.",
  "start": 126.239,
  "end": 127.819,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kausap ang aso!",
  "start": 128.284,
  "end": 129.414,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Kausap ang aso!",
  "start": 129.839,
  "end": 130.984,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Pupuntahan ko siya.",
  "start": 131.449,
  "end": 132.139,
  "style": "fierce",
  "speaker": "INDIO"
 },
 {
  "text": "Sasabihin ko sa kanyang tama siya.",
  "start": 132.564,
  "end": 134.124,
  "style": "fierce",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi puwede.",
  "start": 134.589,
  "end": 135.199,
  "style": "firm",
  "speaker": "M"
 },
 {
  "text": "Bawal magkita ang iisang tao.",
  "start": 135.624,
  "end": 137.154,
  "style": "firm",
  "speaker": "M"
 },
 {
  "text": "Siya ang tama, siya ang nasa labas.",
  "start": 137.619,
  "end": 139.849,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung mali, may medalya.",
  "start": 140.274,
  "end": 141.824,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Noon pa pala, ganito na.",
  "start": 142.249,
  "end": 143.569,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Ang pinakamadaling taong tulungan sa mundo: ang sarili ko.",
  "start": 143.994,
  "end": 147.264,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "At hindi ko magawa.",
  "start": 147.689,
  "end": 148.609,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Par.",
  "start": 149.454,
  "end": 149.694,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Huwag kang umalis.",
  "start": 150.119,
  "end": 150.919,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Tingnan mo ang ginagawa niya.",
  "start": 151.344,
  "end": 152.474,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "May lumapit sa bata: si Bea, kaklase niyang may tirintas.",
  "start": 152.939,
  "end": 156.989,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinati niya ang banana cue niya.",
  "start": 157.414,
  "end": 159.084,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa'yo ang kalahati.",
  "start": 159.549,
  "end": 160.599,
  "style": "kind",
  "speaker": "BEA"
 },
 {
  "text": "Hindi ako tumawa, ha.",
  "start": 160.966,
  "end": 162.246,
  "style": "kind",
  "speaker": "BEA"
 },
 {
  "text": "Lumabas ang guro at lumuhod sa harap ng bata.",
  "start": 162.711,
  "end": 165.431,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am, baka po mali ako.",
  "start": 165.976,
  "end": 167.316,
  "style": "plain",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Hindi ko pa po tapos basahin ang libro ni Lolo.",
  "start": 167.722,
  "end": 170.062,
  "style": "plain",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Pero 'yun po talaga ang nabasa ko.",
  "start": 170.448,
  "end": 172.088,
  "style": "plain",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Sa pinto, nakikinig ang batang may medalya.",
  "start": 172.553,
  "end": 175.273,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am.",
  "start": 175.738,
  "end": 176.258,
  "style": "small",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Kinabisa ko lang po 'yung sa akin.",
  "start": 176.683,
  "end": 178.293,
  "style": "small",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Hindi ko rin po alam kung totoo.",
  "start": 178.718,
  "end": 180.148,
  "style": "small",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Umamin siya muna na puwede siyang mali.",
  "start": 180.613,
  "end": 182.283,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya umamin din ang isa.",
  "start": 182.708,
  "end": 183.928,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sampung taon ako noon.",
  "start": 184.353,
  "end": 185.593,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Kinabukasan.",
  "start": 186.058,
  "end": 186.988,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Class, tama si Indio.",
  "start": 187.453,
  "end": 188.863,
  "style": "clear",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Noong 2004, idineklara mismo ng National Historical Institute na walang batayan sa kasaysayan ang kodigo.",
  "start": 189.288,
  "end": 196.488,
  "style": "clear",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Mali ang libro natin.",
  "start": 196.913,
  "end": 198.193,
  "style": "clear",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Iniabot ng guro sa Lolo ni Indio ang papel ng pagsusulit, may isinulat sa itaas.",
  "start": 198.658,
  "end": 203.958,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi na binawi ang medalya, par.",
  "start": 204.423,
  "end": 206.383,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi na.",
  "start": 206.848,
  "end": 207.448,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Pero narinig ko ang \"tama ka\".",
  "start": 207.873,
  "end": 209.273,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Inikot ni Indio ang lente.",
  "start": 210.118,
  "end": 211.728,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nakita niya ang Lolo niya, may ibinabaong lata sa ugat ng puno.",
  "start": 212.153,
  "end": 215.953,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Para sa apo ko.",
  "start": 216.418,
  "end": 217.428,
  "style": "soft",
  "speaker": "LOLO"
 },
 {
  "text": "Kapag handa na siyang maniwala sa sarili niya.",
  "start": 217.853,
  "end": 219.993,
  "style": "soft",
  "speaker": "LOLO"
 },
 {
  "text": "Ngayon.",
  "start": 220.458,
  "end": 220.868,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pagbalik sa kasalukuyan, hinukay ni Indio ang parehong ugat.",
  "start": 221.293,
  "end": 224.933,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa lata, may kuwaderno, at ang papel ng pagsusulit.",
  "start": 225.358,
  "end": 229.298,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa itaas: Tama ka.",
  "start": 229.723,
  "end": 231.373,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinago ni Lolo.",
  "start": 231.838,
  "end": 232.828,
  "style": "moved",
  "speaker": "INDIO"
 },
 {
  "text": "Lahat ng taong 'yon.",
  "start": 233.253,
  "end": 234.293,
  "style": "moved",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kuwaderno, kusang lumitaw ang guhit ng mga barko, at isang babala.",
  "start": 234.758,
  "end": 239.398,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "\"Mag-ingat sa batang laging nauuna.\"",
  "start": 239.863,
  "end": 241.843,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sino, Lolo?",
  "start": 242.268,
  "end": 243.218,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung may medalya?",
  "start": 243.643,
  "end": 244.433,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: may itinuro ba sa'yo sa eskwela na hindi pala totoo?",
  "start": 245.278,
  "end": 249.738,
  "style": "curious",
  "speaker": "INDIO"
 },
 {
  "text": "Sinabi mo ba?",
  "start": 250.124,
  "end": 250.814,
  "style": "curious",
  "speaker": "INDIO"
 }
]