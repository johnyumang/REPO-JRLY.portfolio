[
 {
  "text": "Kausap ang aso!",
  "start": 0.015,
  "end": 0.905,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Kausap ang aso!",
  "start": 1.33,
  "end": 2.815,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Grade five ako nang una akong pagtawanan dahil nagsabi ako ng totoo.",
  "start": 3.28,
  "end": 6.97,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon, pinapanood ko ulit.",
  "start": 7.395,
  "end": 9.075,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "At bawal akong lumapit.",
  "start": 9.48,
  "end": 11.14,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 11.565,
  "end": 12.525,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung nasa pasilyo, ako rin.",
  "start": 12.932,
  "end": 14.682,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Quezon City.",
  "start": 15.527,
  "end": 16.177,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Taong 2012.",
  "start": 16.602,
  "end": 17.822,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Dinala ng mapa si Indio sa dati niyang paaralan, kasama si M, ang babaeng may hawak ng mapa, at ang aso niyang si Usman.",
  "start": 18.247,
  "end": 25.957,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nagtago sila sa labas ng gate.",
  "start": 26.382,
  "end": 28.232,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang pangalawang tuldok sa mapa: ang dati kong paaralan.",
  "start": 28.697,
  "end": 31.577,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Akala ko, kayamanan ang hahanapin.",
  "start": 32.002,
  "end": 33.832,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Banana cue: saging na saba, may asukal, nakatuhog.",
  "start": 34.257,
  "end": 38.317,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "\"Cue\" raw, galing sa \"barbecue\", kasi nakatusok sa stick.",
  "start": 38.742,
  "end": 41.952,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Walang barbecue sa banana cue.",
  "start": 42.357,
  "end": 44.097,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Unang kasinungalingang natutunan ko sa eskwela, at masarap.",
  "start": 44.522,
  "end": 47.512,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Bawal kang lumapit sa sarili mo.",
  "start": 47.977,
  "end": 49.537,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa lente ka sumilip.",
  "start": 49.962,
  "end": 50.942,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ipapakita niyan ang nangyari rito.",
  "start": 51.367,
  "end": 53.657,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa lente, nakita ni Indio ang sarili niya noong bata: tahimik sa sulok, nagbabasa.",
  "start": 54.122,
  "end": 60.612,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ayun ka, par.",
  "start": 61.077,
  "end": 61.877,
  "style": "fond",
  "speaker": "USMAN"
 },
 {
  "text": "Maliit, pero kamukha mo na ang kunot ng noo.",
  "start": 62.302,
  "end": 64.392,
  "style": "fond",
  "speaker": "USMAN"
 },
 {
  "text": "Nagtanong si Ma'am Celia, ang guro, tungkol sa pinakamatandang batas.",
  "start": 65.237,
  "end": 69.607,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tumayo ang isang batang maayos ang buhok, ang pinakamatalino sa klase.",
  "start": 70.032,
  "end": 74.352,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am!",
  "start": 74.817,
  "end": 75.377,
  "style": "proud",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Ang Kodigo ni Kalantiaw po, isinulat noong 1433.",
  "start": 75.802,
  "end": 80.912,
  "style": "proud",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Labingwalong batas!",
  "start": 81.337,
  "end": 82.487,
  "style": "proud",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Tama.",
  "start": 82.952,
  "end": 83.352,
  "style": "warm",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "'Yan ang nasa libro natin.",
  "start": 83.777,
  "end": 85.217,
  "style": "warm",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Nagtaas ng kamay ang batang Indio.",
  "start": 85.682,
  "end": 87.722,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am, pasensya na po.",
  "start": 88.187,
  "end": 89.797,
  "style": "small",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Hindi po totoo ang kodigo.",
  "start": 90.222,
  "end": 91.932,
  "style": "small",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Mas marunong ka pa sa libro?",
  "start": 92.397,
  "end": 94.107,
  "style": "mocking",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "May libro po ang Lolo ko, gawa ni Scott.",
  "start": 94.572,
  "end": 97.152,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Sabi po roon, walang lumang papel na bumabanggit sa kodigo.",
  "start": 97.498,
  "end": 100.818,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Bago lang po ito lumitaw.",
  "start": 101.243,
  "end": 103.203,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Hindi po tugma.",
  "start": 103.628,
  "end": 104.648,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "\"Hindi tugma.\"",
  "start": 105.113,
  "end": 105.853,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sampung taon ako.",
  "start": 106.278,
  "end": 107.268,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Nakikita ko na pala ang hindi nakikita ng iba.",
  "start": 107.693,
  "end": 109.883,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Nagtawanan ang klase.",
  "start": 110.728,
  "end": 112.128,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tumakbo ang bata palabas.",
  "start": 112.553,
  "end": 114.202,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Indio, anak, sandali!",
  "start": 114.667,
  "end": 116.447,
  "style": "calling",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Tahimik, class!",
  "start": 116.814,
  "end": 117.684,
  "style": "calling",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Sa loob, isinabit ang medalyang Best in History sa batang maayos ang buhok.",
  "start": 118.149,
  "end": 122.879,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa gate, kinausap ng bata ang isang asong gala.",
  "start": 123.304,
  "end": 126.504,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nakita siya ng mga kaklase.",
  "start": 126.929,
  "end": 128.509,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kausap ang aso!",
  "start": 128.974,
  "end": 130.104,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Kausap ang aso!",
  "start": 130.529,
  "end": 131.714,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Pupuntahan ko siya.",
  "start": 132.179,
  "end": 132.869,
  "style": "fierce",
  "speaker": "INDIO"
 },
 {
  "text": "Sasabihin ko sa kanyang tama siya.",
  "start": 133.294,
  "end": 134.854,
  "style": "fierce",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi puwede.",
  "start": 135.319,
  "end": 135.929,
  "style": "firm",
  "speaker": "M"
 },
 {
  "text": "Bawal magkita ang iisang tao.",
  "start": 136.354,
  "end": 137.884,
  "style": "firm",
  "speaker": "M"
 },
 {
  "text": "Siya ang tama, siya ang nasa labas.",
  "start": 138.349,
  "end": 140.579,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung mali, may medalya.",
  "start": 141.004,
  "end": 142.554,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Noon pa pala, ganito na.",
  "start": 142.979,
  "end": 144.299,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Ang pinakamadaling taong tulungan sa mundo: ang sarili ko.",
  "start": 144.724,
  "end": 148.004,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "At hindi ko magawa.",
  "start": 148.429,
  "end": 149.349,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Par.",
  "start": 150.194,
  "end": 150.434,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Huwag kang umalis.",
  "start": 150.859,
  "end": 151.659,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Tingnan mo ang ginagawa niya.",
  "start": 152.084,
  "end": 153.204,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "May lumapit sa bata: si Bea, kaklase niyang may tirintas.",
  "start": 153.669,
  "end": 157.719,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinati niya ang banana cue niya.",
  "start": 158.144,
  "end": 159.814,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa'yo ang kalahati.",
  "start": 160.279,
  "end": 161.339,
  "style": "kind",
  "speaker": "BEA"
 },
 {
  "text": "Hindi ako tumawa, ha.",
  "start": 161.706,
  "end": 162.986,
  "style": "kind",
  "speaker": "BEA"
 },
 {
  "text": "Lumabas ang guro at lumuhod sa harap ng bata.",
  "start": 163.451,
  "end": 166.171,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am, baka po mali ako.",
  "start": 166.716,
  "end": 168.056,
  "style": "plain",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Hindi ko pa po tapos basahin ang libro ni Lolo.",
  "start": 168.462,
  "end": 170.802,
  "style": "plain",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Pero 'yun po talaga ang nabasa ko.",
  "start": 171.188,
  "end": 172.828,
  "style": "plain",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Sa pinto, nakikinig ang batang may medalya.",
  "start": 173.293,
  "end": 176.013,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am.",
  "start": 176.478,
  "end": 176.988,
  "style": "small",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Kinabisa ko lang po 'yung sa akin.",
  "start": 177.413,
  "end": 179.013,
  "style": "small",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Hindi ko rin po alam kung totoo.",
  "start": 179.438,
  "end": 180.858,
  "style": "small",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Umamin siya muna na puwede siyang mali.",
  "start": 181.323,
  "end": 182.993,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya umamin din ang isa.",
  "start": 183.418,
  "end": 184.638,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sampung taon ako noon.",
  "start": 185.063,
  "end": 186.303,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Kinabukasan.",
  "start": 186.768,
  "end": 187.698,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Class, tama si Indio.",
  "start": 188.163,
  "end": 189.573,
  "style": "clear",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Noong 2004, idineklara mismo ng National Historical Institute na walang batayan sa kasaysayan ang kodigo.",
  "start": 189.998,
  "end": 197.198,
  "style": "clear",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Mali ang libro natin.",
  "start": 197.623,
  "end": 198.903,
  "style": "clear",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Iniabot ng guro sa Lolo ni Indio ang papel ng pagsusulit, may isinulat sa itaas.",
  "start": 199.368,
  "end": 204.668,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi na binawi ang medalya, par.",
  "start": 205.133,
  "end": 207.093,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi na.",
  "start": 207.558,
  "end": 208.158,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Pero narinig ko ang \"tama ka\".",
  "start": 208.583,
  "end": 209.983,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Inikot ni Indio ang lente.",
  "start": 210.828,
  "end": 212.438,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nakita niya ang Lolo niya, may ibinabaong lata sa ugat ng puno.",
  "start": 212.863,
  "end": 216.663,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Para sa apo ko.",
  "start": 217.128,
  "end": 218.138,
  "style": "soft",
  "speaker": "LOLO"
 },
 {
  "text": "Kapag handa na siyang maniwala sa sarili niya.",
  "start": 218.563,
  "end": 220.703,
  "style": "soft",
  "speaker": "LOLO"
 },
 {
  "text": "Ngayon.",
  "start": 221.168,
  "end": 221.578,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pagbalik sa kasalukuyan, hinukay ni Indio ang parehong ugat.",
  "start": 222.003,
  "end": 225.643,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa lata, may kuwaderno, at ang papel ng pagsusulit.",
  "start": 226.068,
  "end": 229.468,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa itaas: Tama ka.",
  "start": 229.893,
  "end": 231.903,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinago ni Lolo.",
  "start": 232.368,
  "end": 233.358,
  "style": "moved",
  "speaker": "INDIO"
 },
 {
  "text": "Lahat ng taong 'yon.",
  "start": 233.783,
  "end": 234.823,
  "style": "moved",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kuwaderno, kusang lumitaw ang guhit ng mga barko, at isang babala.",
  "start": 235.288,
  "end": 239.928,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "\"Mag-ingat sa batang laging nauuna.\"",
  "start": 240.393,
  "end": 242.373,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sino, Lolo?",
  "start": 242.798,
  "end": 243.748,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung may medalya?",
  "start": 244.173,
  "end": 244.973,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: may itinuro ba sa'yo sa eskwela na hindi pala totoo?",
  "start": 245.818,
  "end": 250.278,
  "style": "curious",
  "speaker": "INDIO"
 },
 {
  "text": "Sinabi mo ba?",
  "start": 250.664,
  "end": 251.354,
  "style": "curious",
  "speaker": "INDIO"
 }
]