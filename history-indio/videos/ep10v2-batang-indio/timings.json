[
 {
  "text": "Kausap ang aso!",
  "start": 0.015,
  "end": 0.955,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Kausap ang aso!",
  "start": 1.38,
  "end": 2.27,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Grade five ako nang una akong pagtawanan dahil nagsabi ako ng totoo.",
  "start": 2.735,
  "end": 6.435,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon, pinapanood ko ulit.",
  "start": 6.86,
  "end": 8.54,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "At bawal akong lumapit.",
  "start": 8.945,
  "end": 10.595,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 11.02,
  "end": 11.97,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung nasa pasilyo, ako rin.",
  "start": 12.377,
  "end": 14.127,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Quezon City.",
  "start": 14.972,
  "end": 15.622,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Taong 2012.",
  "start": 16.047,
  "end": 17.267,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Dinala ng mapa si Indio sa dati niyang paaralan, kasama si M, ang babaeng may hawak ng mapa, at ang aso niyang si Usman.",
  "start": 17.692,
  "end": 25.402,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nagtago sila sa labas ng gate.",
  "start": 25.827,
  "end": 27.677,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang pangalawang tuldok sa mapa: ang dati kong paaralan.",
  "start": 28.142,
  "end": 31.032,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Akala ko, kayamanan ang hahanapin.",
  "start": 31.457,
  "end": 33.287,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Banana cue: saging na saba, may asukal, nakatuhog.",
  "start": 33.712,
  "end": 37.772,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "\"Cue\" raw, galing sa \"barbecue\", kasi nakatusok sa stick.",
  "start": 38.197,
  "end": 41.397,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Walang barbecue sa banana cue.",
  "start": 41.802,
  "end": 43.542,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Unang kasinungalingang natutunan ko sa eskwela, at masarap.",
  "start": 43.967,
  "end": 46.957,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Bawal kang lumapit sa sarili mo.",
  "start": 47.422,
  "end": 48.982,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa lente ka sumilip.",
  "start": 49.407,
  "end": 50.387,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ipapakita niyan ang nangyari rito.",
  "start": 50.812,
  "end": 53.102,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa lente, nakita ni Indio ang sarili niya noong bata: tahimik sa sulok, nagbabasa.",
  "start": 53.567,
  "end": 60.057,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ayun ka, par.",
  "start": 60.522,
  "end": 61.312,
  "style": "fond",
  "speaker": "USMAN"
 },
 {
  "text": "Maliit, pero kamukha mo na ang kunot ng noo.",
  "start": 61.737,
  "end": 63.827,
  "style": "fond",
  "speaker": "USMAN"
 },
 {
  "text": "Nagtanong si Ma'am Celia, ang guro, tungkol sa pinakamatandang batas.",
  "start": 64.672,
  "end": 69.042,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tumayo ang isang batang maayos ang buhok, ang pinakamatalino sa klase.",
  "start": 69.467,
  "end": 73.787,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am!",
  "start": 74.252,
  "end": 74.812,
  "style": "proud",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Ang Kodigo ni Kalantiaw po, isinulat noong 1433.",
  "start": 75.237,
  "end": 80.347,
  "style": "proud",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Labingwalong batas!",
  "start": 80.772,
  "end": 81.902,
  "style": "proud",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Tama.",
  "start": 82.367,
  "end": 82.767,
  "style": "warm",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "'Yan ang nasa libro natin.",
  "start": 83.192,
  "end": 84.622,
  "style": "warm",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Nagtaas ng kamay ang batang Indio.",
  "start": 85.087,
  "end": 87.117,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am, pasensya na po.",
  "start": 87.582,
  "end": 89.192,
  "style": "small",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Hindi po totoo ang kodigo.",
  "start": 89.617,
  "end": 91.327,
  "style": "small",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Mas marunong ka pa sa libro?",
  "start": 91.792,
  "end": 93.502,
  "style": "mocking",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "May libro po ang Lolo ko, gawa ni Scott.",
  "start": 93.967,
  "end": 96.557,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Sabi po roon, walang lumang papel na bumabanggit sa kodigo.",
  "start": 96.903,
  "end": 100.223,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Bago lang po ito lumitaw.",
  "start": 100.648,
  "end": 102.598,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Hindi po tugma.",
  "start": 103.023,
  "end": 104.043,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "\"Hindi tugma.\"",
  "start": 104.508,
  "end": 105.248,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sampung taon ako.",
  "start": 105.673,
  "end": 106.663,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Nakikita ko na pala ang hindi nakikita ng iba.",
  "start": 107.088,
  "end": 109.278,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Nagtawanan ang klase.",
  "start": 110.123,
  "end": 111.513,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tumakbo ang bata palabas.",
  "start": 111.938,
  "end": 113.588,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Indio, anak, sandali!",
  "start": 114.053,
  "end": 115.822,
  "style": "calling",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Tahimik, class!",
  "start": 116.189,
  "end": 117.069,
  "style": "calling",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Sa loob, isinabit ang medalyang Best in History sa batang maayos ang buhok.",
  "start": 117.534,
  "end": 122.264,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa gate, kinausap ng bata ang isang asong gala.",
  "start": 122.689,
  "end": 125.889,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nakita siya ng mga kaklase.",
  "start": 126.314,
  "end": 127.894,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kausap ang aso!",
  "start": 128.359,
  "end": 129.479,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Kausap ang aso!",
  "start": 129.904,
  "end": 131.049,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Pupuntahan ko siya.",
  "start": 131.514,
  "end": 132.204,
  "style": "fierce",
  "speaker": "INDIO"
 },
 {
  "text": "Sasabihin ko sa kanyang tama siya.",
  "start": 132.629,
  "end": 134.199,
  "style": "fierce",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi puwede.",
  "start": 134.664,
  "end": 135.274,
  "style": "firm",
  "speaker": "M"
 },
 {
  "text": "Bawal magkita ang iisang tao.",
  "start": 135.699,
  "end": 137.219,
  "style": "firm",
  "speaker": "M"
 },
 {
  "text": "Siya ang tama, siya ang nasa labas.",
  "start": 137.684,
  "end": 139.924,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung mali, may medalya.",
  "start": 140.349,
  "end": 141.889,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Noon pa pala, ganito na.",
  "start": 142.314,
  "end": 143.634,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Ang pinakamadaling taong tulungan sa mundo: ang sarili ko.",
  "start": 144.059,
  "end": 147.339,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "At hindi ko magawa.",
  "start": 147.764,
  "end": 148.684,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Par.",
  "start": 149.529,
  "end": 149.769,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Huwag kang umalis.",
  "start": 150.194,
  "end": 150.994,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Tingnan mo ang ginagawa niya.",
  "start": 151.419,
  "end": 152.549,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "May lumapit sa bata: si Bea, kaklase niyang may tirintas.",
  "start": 153.014,
  "end": 157.054,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinati niya ang banana cue niya.",
  "start": 157.479,
  "end": 159.159,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa'yo ang kalahati.",
  "start": 159.624,
  "end": 160.684,
  "style": "kind",
  "speaker": "BEA"
 },
 {
  "text": "Hindi ako tumawa, ha.",
  "start": 161.051,
  "end": 162.321,
  "style": "kind",
  "speaker": "BEA"
 },
 {
  "text": "Lumabas ang guro at lumuhod sa harap ng bata.",
  "start": 162.786,
  "end": 165.516,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am, baka po mali ako.",
  "start": 166.061,
  "end": 167.401,
  "style": "plain",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Hindi ko pa po tapos basahin ang libro ni Lolo.",
  "start": 167.807,
  "end": 170.157,
  "style": "plain",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Pero 'yun po talaga ang nabasa ko.",
  "start": 170.543,
  "end": 172.193,
  "style": "plain",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Sa pinto, nakikinig ang batang may medalya.",
  "start": 172.658,
  "end": 175.378,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am.",
  "start": 175.843,
  "end": 176.363,
  "style": "small",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Kinabisa ko lang po 'yung sa akin.",
  "start": 176.788,
  "end": 178.388,
  "style": "small",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Hindi ko rin po alam kung totoo.",
  "start": 178.813,
  "end": 180.243,
  "style": "small",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Umamin siya muna na puwede siyang mali.",
  "start": 180.708,
  "end": 182.378,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya umamin din ang isa.",
  "start": 182.803,
  "end": 184.023,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sampung taon ako noon.",
  "start": 184.448,
  "end": 185.688,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Kinabukasan.",
  "start": 186.153,
  "end": 187.083,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Class, tama si Indio.",
  "start": 187.548,
  "end": 188.958,
  "style": "clear",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Noong 2004, idineklara mismo ng National Historical Institute na walang batayan sa kasaysayan ang kodigo.",
  "start": 189.383,
  "end": 196.593,
  "style": "clear",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Mali ang libro natin.",
  "start": 197.018,
  "end": 198.298,
  "style": "clear",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Iniabot ng guro sa Lolo ni Indio ang papel ng pagsusulit, may isinulat sa itaas.",
  "start": 198.763,
  "end": 204.073,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi na binawi ang medalya, par.",
  "start": 204.538,
  "end": 206.498,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi na.",
  "start": 206.963,
  "end": 207.563,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Pero narinig ko ang \"tama ka\".",
  "start": 207.988,
  "end": 209.388,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Inikot ni Indio ang lente.",
  "start": 210.233,
  "end": 211.843,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nakita niya ang Lolo niya, may ibinabaong lata sa ugat ng puno.",
  "start": 212.268,
  "end": 216.068,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Para sa apo ko.",
  "start": 216.533,
  "end": 217.543,
  "style": "soft",
  "speaker": "LOLO"
 },
 {
  "text": "Kapag handa na siyang maniwala sa sarili niya.",
  "start": 217.968,
  "end": 220.108,
  "style": "soft",
  "speaker": "LOLO"
 },
 {
  "text": "Ngayon.",
  "start": 220.573,
  "end": 220.993,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pagbalik sa kasalukuyan, hinukay ni Indio ang parehong ugat.",
  "start": 221.418,
  "end": 225.048,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa lata, may kuwaderno, at ang papel ng pagsusulit.",
  "start": 225.473,
  "end": 229.013,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa itaas: Tama ka.",
  "start": 229.438,
  "end": 231.088,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinago ni Lolo.",
  "start": 231.553,
  "end": 232.533,
  "style": "moved",
  "speaker": "INDIO"
 },
 {
  "text": "Lahat ng taong 'yon.",
  "start": 232.958,
  "end": 234.008,
  "style": "moved",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kuwaderno, kusang lumitaw ang guhit ng mga barko, at isang babala.",
  "start": 234.473,
  "end": 239.103,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "\"Mag-ingat sa batang laging nauuna.\"",
  "start": 239.568,
  "end": 241.548,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sino, Lolo?",
  "start": 241.973,
  "end": 242.923,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung may medalya?",
  "start": 243.348,
  "end": 244.138,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: may itinuro ba sa'yo sa eskwela na hindi pala totoo?",
  "start": 244.983,
  "end": 249.433,
  "style": "curious",
  "speaker": "INDIO"
 },
 {
  "text": "Sinabi mo ba?",
  "start": 249.819,
  "end": 250.509,
  "style": "curious",
  "speaker": "INDIO"
 }
]