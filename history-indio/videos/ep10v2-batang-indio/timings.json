[
 {
  "text": "Kausap ang aso!",
  "start": 0.015,
  "end": 0.945,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Kausap ang aso!",
  "start": 1.37,
  "end": 2.26,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Grade five ako nang una akong pagtawanan dahil nagsabi ako ng totoo.",
  "start": 2.725,
  "end": 6.425,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon, pinapanood ko ulit.",
  "start": 6.85,
  "end": 8.53,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "At bawal akong lumapit.",
  "start": 8.935,
  "end": 10.585,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 11.01,
  "end": 11.96,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung nasa pasilyo, ako rin.",
  "start": 12.367,
  "end": 14.117,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Quezon City.",
  "start": 14.962,
  "end": 15.612,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Taong 2012.",
  "start": 16.037,
  "end": 17.257,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Dinala ng mapa si Indio sa dati niyang paaralan, kasama si M, ang babaeng may hawak ng mapa, at ang aso niyang si Usman.",
  "start": 17.682,
  "end": 25.392,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nagtago sila sa labas ng gate.",
  "start": 25.817,
  "end": 27.667,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang pangalawang tuldok sa mapa: ang dati kong paaralan.",
  "start": 28.132,
  "end": 31.022,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Akala ko, kayamanan ang hahanapin.",
  "start": 31.447,
  "end": 33.277,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Banana cue: saging na saba, may asukal, nakatuhog.",
  "start": 33.702,
  "end": 37.762,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "\"Cue\" raw, galing sa \"barbecue\", kasi nakatusok sa stick.",
  "start": 38.187,
  "end": 41.387,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Walang barbecue sa banana cue.",
  "start": 41.792,
  "end": 43.532,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Unang kasinungalingang natutunan ko sa eskwela, at masarap.",
  "start": 43.957,
  "end": 46.947,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Bawal kang lumapit sa sarili mo.",
  "start": 47.412,
  "end": 48.972,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa lente ka sumilip.",
  "start": 49.397,
  "end": 50.377,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ipapakita niyan ang nangyari rito.",
  "start": 50.802,
  "end": 53.092,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa lente, nakita ni Indio ang sarili niya noong bata: tahimik sa sulok, nagbabasa.",
  "start": 53.557,
  "end": 60.047,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ayun ka, par.",
  "start": 60.512,
  "end": 61.302,
  "style": "fond",
  "speaker": "USMAN"
 },
 {
  "text": "Maliit, pero kamukha mo na ang kunot ng noo.",
  "start": 61.727,
  "end": 63.817,
  "style": "fond",
  "speaker": "USMAN"
 },
 {
  "text": "Nagtanong si Ma'am Celia, ang guro, tungkol sa pinakamatandang batas.",
  "start": 64.662,
  "end": 69.032,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tumayo ang isang batang maayos ang buhok, ang pinakamatalino sa klase.",
  "start": 69.457,
  "end": 73.777,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am!",
  "start": 74.242,
  "end": 74.802,
  "style": "proud",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Ang Kodigo ni Kalantiaw po, isinulat noong 1433.",
  "start": 75.227,
  "end": 80.337,
  "style": "proud",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Labingwalong batas!",
  "start": 80.762,
  "end": 81.892,
  "style": "proud",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Tama.",
  "start": 82.357,
  "end": 82.757,
  "style": "warm",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "'Yan ang nasa libro natin.",
  "start": 83.182,
  "end": 84.612,
  "style": "warm",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Nagtaas ng kamay ang batang Indio.",
  "start": 85.077,
  "end": 87.107,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am, pasensya na po.",
  "start": 87.572,
  "end": 89.182,
  "style": "small",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Hindi po totoo ang kodigo.",
  "start": 89.607,
  "end": 91.317,
  "style": "small",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Mas marunong ka pa sa libro?",
  "start": 91.782,
  "end": 93.492,
  "style": "mocking",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "May libro po ang Lolo ko, gawa ni Scott.",
  "start": 93.957,
  "end": 96.547,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Sabi po roon, walang lumang papel na bumabanggit sa kodigo.",
  "start": 96.893,
  "end": 100.213,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Bago lang po ito lumitaw.",
  "start": 100.638,
  "end": 102.588,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Hindi po tugma.",
  "start": 103.013,
  "end": 104.033,
  "style": "steady",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "\"Hindi tugma.\"",
  "start": 104.498,
  "end": 105.238,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sampung taon ako.",
  "start": 105.663,
  "end": 106.653,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Nakikita ko na pala ang hindi nakikita ng iba.",
  "start": 107.078,
  "end": 109.268,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Nagtawanan ang klase.",
  "start": 110.113,
  "end": 111.502,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tumakbo ang bata palabas.",
  "start": 111.927,
  "end": 113.577,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Indio, anak, sandali!",
  "start": 114.042,
  "end": 115.812,
  "style": "calling",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Tahimik, class!",
  "start": 116.179,
  "end": 117.059,
  "style": "calling",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Sa loob, isinabit ang medalyang Best in History sa batang maayos ang buhok.",
  "start": 117.524,
  "end": 122.254,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa gate, kinausap ng bata ang isang asong gala.",
  "start": 122.679,
  "end": 125.879,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nakita siya ng mga kaklase.",
  "start": 126.304,
  "end": 127.884,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kausap ang aso!",
  "start": 128.349,
  "end": 129.269,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Kausap ang aso!",
  "start": 129.694,
  "end": 130.584,
  "style": "shout",
  "speaker": "MGA KAKLASE"
 },
 {
  "text": "Pupuntahan ko siya.",
  "start": 131.049,
  "end": 131.739,
  "style": "fierce",
  "speaker": "INDIO"
 },
 {
  "text": "Sasabihin ko sa kanyang tama siya.",
  "start": 132.164,
  "end": 133.734,
  "style": "fierce",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi puwede.",
  "start": 134.199,
  "end": 134.819,
  "style": "firm",
  "speaker": "M"
 },
 {
  "text": "Bawal magkita ang iisang tao.",
  "start": 135.244,
  "end": 136.764,
  "style": "firm",
  "speaker": "M"
 },
 {
  "text": "Siya ang tama, siya ang nasa labas.",
  "start": 137.229,
  "end": 139.469,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung mali, may medalya.",
  "start": 139.894,
  "end": 141.434,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Noon pa pala, ganito na.",
  "start": 141.859,
  "end": 143.189,
  "style": "bitter",
  "speaker": "INDIO"
 },
 {
  "text": "Ang pinakamadaling taong tulungan sa mundo: ang sarili ko.",
  "start": 143.614,
  "end": 146.894,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "At hindi ko magawa.",
  "start": 147.319,
  "end": 148.239,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Par.",
  "start": 149.084,
  "end": 149.254,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Huwag kang umalis.",
  "start": 149.679,
  "end": 150.844,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Tingnan mo ang ginagawa niya.",
  "start": 151.21,
  "end": 152.34,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "May lumapit sa bata: si Bea, kaklase niyang may tirintas.",
  "start": 152.805,
  "end": 156.845,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinati niya ang banana cue niya.",
  "start": 157.27,
  "end": 158.95,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa'yo ang kalahati.",
  "start": 159.415,
  "end": 160.475,
  "style": "kind",
  "speaker": "BEA"
 },
 {
  "text": "Hindi ako tumawa, ha.",
  "start": 160.842,
  "end": 162.112,
  "style": "kind",
  "speaker": "BEA"
 },
 {
  "text": "Lumabas ang guro at lumuhod sa harap ng bata.",
  "start": 162.577,
  "end": 165.297,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am, baka po mali ako.",
  "start": 165.842,
  "end": 167.192,
  "style": "plain",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Hindi ko pa po tapos basahin ang libro ni Lolo.",
  "start": 167.598,
  "end": 169.948,
  "style": "plain",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Pero 'yun po talaga ang nabasa ko.",
  "start": 170.334,
  "end": 171.974,
  "style": "plain",
  "speaker": "BATANG INDIO"
 },
 {
  "text": "Sa pinto, nakikinig ang batang may medalya.",
  "start": 172.439,
  "end": 175.169,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ma'am.",
  "start": 175.634,
  "end": 176.154,
  "style": "small",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Kinabisa ko lang po 'yung sa akin.",
  "start": 176.579,
  "end": 178.179,
  "style": "small",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Hindi ko rin po alam kung totoo.",
  "start": 178.604,
  "end": 180.034,
  "style": "small",
  "speaker": "BATANG MAY MEDALYA"
 },
 {
  "text": "Umamin siya muna na puwede siyang mali.",
  "start": 180.499,
  "end": 182.169,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya umamin din ang isa.",
  "start": 182.594,
  "end": 183.814,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sampung taon ako noon.",
  "start": 184.239,
  "end": 185.469,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Kinabukasan.",
  "start": 185.934,
  "end": 186.864,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Class, tama si Indio.",
  "start": 187.329,
  "end": 188.739,
  "style": "clear",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Noong 2004, idineklara mismo ng National Historical Institute na walang batayan sa kasaysayan ang kodigo.",
  "start": 189.164,
  "end": 196.374,
  "style": "clear",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Mali ang libro natin.",
  "start": 196.799,
  "end": 198.059,
  "style": "clear",
  "speaker": "MA'AM CELIA"
 },
 {
  "text": "Iniabot ng guro sa Lolo ni Indio ang papel ng pagsusulit, may isinulat sa itaas.",
  "start": 198.524,
  "end": 203.834,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi na binawi ang medalya, par.",
  "start": 204.299,
  "end": 206.259,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi na.",
  "start": 206.724,
  "end": 207.324,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Pero narinig ko ang \"tama ka\".",
  "start": 207.749,
  "end": 209.149,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Inikot ni Indio ang lente.",
  "start": 209.994,
  "end": 211.594,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nakita niya ang Lolo niya, may ibinabaong lata sa ugat ng puno.",
  "start": 212.019,
  "end": 215.819,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Para sa apo ko.",
  "start": 216.284,
  "end": 217.294,
  "style": "soft",
  "speaker": "LOLO"
 },
 {
  "text": "Kapag handa na siyang maniwala sa sarili niya.",
  "start": 217.719,
  "end": 219.859,
  "style": "soft",
  "speaker": "LOLO"
 },
 {
  "text": "Ngayon.",
  "start": 220.324,
  "end": 220.744,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pagbalik sa kasalukuyan, hinukay ni Indio ang parehong ugat.",
  "start": 221.169,
  "end": 224.899,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa lata, may kuwaderno, at ang papel ng pagsusulit.",
  "start": 225.324,
  "end": 228.614,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa itaas: Tama ka.",
  "start": 229.039,
  "end": 230.639,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinago ni Lolo.",
  "start": 231.104,
  "end": 232.084,
  "style": "moved",
  "speaker": "INDIO"
 },
 {
  "text": "Lahat ng taong 'yon.",
  "start": 232.509,
  "end": 233.549,
  "style": "moved",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kuwaderno, kusang lumitaw ang guhit ng mga barko, at isang babala.",
  "start": 234.014,
  "end": 238.644,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "\"Mag-ingat sa batang laging nauuna.\"",
  "start": 239.109,
  "end": 241.089,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sino, Lolo?",
  "start": 241.514,
  "end": 242.464,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung may medalya?",
  "start": 242.889,
  "end": 243.679,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: may itinuro ba sa'yo sa eskwela na hindi pala totoo?",
  "start": 244.524,
  "end": 248.974,
  "style": "curious",
  "speaker": "INDIO"
 },
 {
  "text": "Sinabi mo ba?",
  "start": 249.36,
  "end": 250.06,
  "style": "curious",
  "speaker": "INDIO"
 }
]