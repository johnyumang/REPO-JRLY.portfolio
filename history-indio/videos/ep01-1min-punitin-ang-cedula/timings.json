[
 {
  "text": "Nasaan ang cedula mo?!",
  "start": 0.03,
  "end": 1.12,
  "style": "shout",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Walang cedula, kaya may itak sa leeg ko ngayon.",
  "start": 1.52,
  "end": 3.91,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 4.31,
  "end": 5.2,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Malas daw ako.",
  "start": 5.6,
  "end": 6.33,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Wala pala akong cedula, 'yung resibo ng buwis.",
  "start": 6.73,
  "end": 9.47,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Mula sa liwanag, lumundag ang isang asong itim.",
  "start": 9.87,
  "end": 13.07,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kumapit ka, Indio!",
  "start": 13.47,
  "end": 14.54,
  "style": "urgent",
  "speaker": "USMAN"
 },
 {
  "text": "Agosto 1896.",
  "start": 15.38,
  "end": 17.94,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinablot si Indio, at hinarang ng isang batang may itak.",
  "start": 18.34,
  "end": 22.02,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Siya si Islaw.",
  "start": 22.42,
  "end": 23.37,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kaya lahat ng narito, may dalang cedula ngayong gabi.",
  "start": 23.77,
  "end": 26.62,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Walang papel, walang kakilala.",
  "start": 27.02,
  "end": 28.76,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Espiya 'yan.",
  "start": 29.16,
  "end": 29.83,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Idinikit ang itak sa leeg niya.",
  "start": 30.23,
  "end": 31.91,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sabihin mo ang totoo.",
  "start": 32.31,
  "end": 33.4,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Wala akong cedula.",
  "start": 33.8,
  "end": 34.72,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala rin akong cedula.",
  "start": 35.12,
  "end": 36.21,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Kalagan n'yo siya.",
  "start": 36.61,
  "end": 37.27,
  "style": "sure",
  "speaker": "ISLAW"
 },
 {
  "text": "Humakbang ang lalaki sa liwanag, at itinaas ang kanyang cedula.",
  "start": 38.11,
  "end": 41.76,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si Andres Bonifacio.",
  "start": 42.16,
  "end": 43.41,
  "style": "whispers",
  "speaker": "ISLAW"
 },
 {
  "text": "Punitin ang mga cedula!",
  "start": 44.0,
  "end": 45.23,
  "style": "shout",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Mabuhay ang Pilipinas!",
  "start": 45.63,
  "end": 47.0,
  "style": "shout",
  "speaker": "MGA KATIPUNERO"
 },
 {
  "text": "'Yung papel na kulang sa akin kaninang umaga, pinupunit nila para sa kalayaan.",
  "start": 47.4,
  "end": 51.46,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: kung hinanapan ka ng papel na wala ka, magsisinungaling ka ba, o aamin?",
  "start": 52.3,
  "end": 57.8,
  "style": "curious",
  "speaker": "INDIO"
 }
]