[
 {
  "text": "Imbécile!",
  "start": 0.415,
  "end": 1.305,
  "style": "shout",
  "speaker": "PUNONG WEYTER"
 },
 {
  "text": "Nakabasag ako ng baso sa gabing ipinamigay ang Pilipinas.",
  "start": 1.77,
  "end": 4.87,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Mas napansin pa nila ang baso.",
  "start": 5.295,
  "end": 6.775,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 7.2,
  "end": 8.23,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "At ayoko sanang bumalik sa nakaraan ngayong gabi.",
  "start": 8.655,
  "end": 11.055,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon.",
  "start": 11.9,
  "end": 12.43,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "San Juan.",
  "start": 12.839,
  "end": 13.839,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Apat na ang marka sa braso ni Indio, pero wala pa rin siyang trabaho.",
  "start": 14.264,
  "end": 18.374,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang lukot na bente na lang ang pera niya.",
  "start": 18.799,
  "end": 20.999,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bente: ang perang papel na pinakagamit nating mga Pilipino.",
  "start": 21.464,
  "end": 25.704,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya nga ginagawa na itong barya, kasi mabilis maluma.",
  "start": 26.129,
  "end": 29.139,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Si Quezon ang nakaguhit.",
  "start": 29.564,
  "end": 31.184,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Sa akin, hindi naluluma.",
  "start": 31.609,
  "end": 32.939,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi kasi tumatagal.",
  "start": 33.364,
  "end": 34.434,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi.",
  "start": 34.859,
  "end": 35.229,
  "style": "firm",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi ako magbabasa ngayong gabi.",
  "start": 35.654,
  "end": 36.894,
  "style": "firm",
  "speaker": "INDIO"
 },
 {
  "text": "Gutom ako, pagod ako.",
  "start": 37.319,
  "end": 38.719,
  "style": "firm",
  "speaker": "INDIO"
 },
 {
  "text": "Uy, bente rin.",
  "start": 39.144,
  "end": 40.124,
  "style": "pleased",
  "speaker": "INDIO"
 },
 {
  "text": "May nakasulat pa.",
  "start": 40.472,
  "end": 41.282,
  "style": "pleased",
  "speaker": "INDIO"
 },
 {
  "text": "May napulot siyang isa pang bente na may sulat-kamay, at binasa niya nang malakas.",
  "start": 41.747,
  "end": 46.347,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Galing pala kay M, na hindi pa rin niya kilala.",
  "start": 46.772,
  "end": 49.262,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "M na naman.",
  "start": 49.727,
  "end": 50.477,
  "style": "annoyed",
  "speaker": "INDIO"
 },
 {
  "text": "Naisahan ako.",
  "start": 50.902,
  "end": 51.622,
  "style": "annoyed",
  "speaker": "INDIO"
 },
 {
  "text": "Paris.",
  "start": 52.467,
  "end": 52.937,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ikasampu ng Disyembre, 1898.",
  "start": 53.362,
  "end": 56.952,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Gabi.",
  "start": 57.377,
  "end": 57.667,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Napunta siya sa isang eskinita sa Paris, sa gitna ng niyebe.",
  "start": 58.092,
  "end": 61.562,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa tabi niya, lumitaw si Usman, ang asong itim na siya lang ang nakakarinig.",
  "start": 61.948,
  "end": 66.588,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bonjour, par.",
  "start": 67.053,
  "end": 68.523,
  "style": "shivering",
  "speaker": "USMAN"
 },
 {
  "text": "Ang lamig.",
  "start": 68.948,
  "end": 69.478,
  "style": "shivering",
  "speaker": "USMAN"
 },
 {
  "text": "Bakit ba ako sumasama sa'yo?",
  "start": 69.903,
  "end": 71.353,
  "style": "shivering",
  "speaker": "USMAN"
 },
 {
  "text": "Ikaw ang may balahibo.",
  "start": 71.818,
  "end": 72.908,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Ako ang naka-polo lang.",
  "start": 73.276,
  "end": 74.336,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Pinapasok sila ng isang Pilipinong tagahugas ng pinggan: si Ambo.",
  "start": 74.801,
  "end": 78.941,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kababayan?",
  "start": 79.406,
  "end": 80.166,
  "style": "surprised",
  "speaker": "AMBO"
 },
 {
  "text": "Dito?",
  "start": 80.591,
  "end": 81.001,
  "style": "surprised",
  "speaker": "AMBO"
 },
 {
  "text": "Pumasok ka, mamamatay ka sa lamig.",
  "start": 81.426,
  "end": 83.236,
  "style": "surprised",
  "speaker": "AMBO"
 },
 {
  "text": "Ako si Ambo.",
  "start": 83.661,
  "end": 84.521,
  "style": "surprised",
  "speaker": "AMBO"
 },
 {
  "text": "Marino, taga-Batangas.",
  "start": 84.867,
  "end": 86.447,
  "style": "surprised",
  "speaker": "AMBO"
 },
 {
  "text": "Naiwan ng barko, kaya naghuhugas ng pinggan.",
  "start": 86.872,
  "end": 89.022,
  "style": "surprised",
  "speaker": "AMBO"
 },
 {
  "text": "Ano'ng meron sa itaas?",
  "start": 89.487,
  "end": 90.617,
  "style": "curious",
  "speaker": "INDIO"
 },
 {
  "text": "Ang daming karwahe.",
  "start": 90.965,
  "end": 92.054,
  "style": "curious",
  "speaker": "INDIO"
 },
 {
  "text": "Mga Amerikano at Kastila.",
  "start": 92.519,
  "end": 93.949,
  "style": "low",
  "speaker": "AMBO"
 },
 {
  "text": "Pinag-uusapan ang Pilipinas.",
  "start": 94.374,
  "end": 95.874,
  "style": "low",
  "speaker": "AMBO"
 },
 {
  "text": "Ngayong gabi ang pirmahan.",
  "start": 96.299,
  "end": 97.429,
  "style": "low",
  "speaker": "AMBO"
 },
 {
  "text": "Sabi sa internet, binili raw tayo.",
  "start": 97.894,
  "end": 99.794,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Dalawang dolyar bawat ulo.",
  "start": 100.219,
  "end": 101.569,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Gusto kong makita kung sino ang pumayag.",
  "start": 101.994,
  "end": 103.864,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Binihisan siya ni Ambo bilang weyter, para makapasok sa silid ng pirmahan.",
  "start": 104.709,
  "end": 109.069,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Huwag kang titingin sa mata nila.",
  "start": 109.534,
  "end": 111.214,
  "style": "quick",
  "speaker": "AMBO"
 },
 {
  "text": "Hindi ka nila makikita.",
  "start": 111.62,
  "end": 112.82,
  "style": "quick",
  "speaker": "AMBO"
 },
 {
  "text": "Ganyan kami rito.",
  "start": 113.245,
  "end": 114.095,
  "style": "quick",
  "speaker": "AMBO"
 },
 {
  "text": "Nakapasok ako.",
  "start": 114.56,
  "end": 115.48,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ako, na hindi makapasok kahit sa isang opisina sa Quezon City.",
  "start": 115.905,
  "end": 119.425,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sa mesa, may papel na may numero: dalawampung milyon.",
  "start": 119.89,
  "end": 123.86,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ayan ang numero.",
  "start": 124.325,
  "end": 125.175,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Bayad ng Amerika sa Espanya.",
  "start": 125.6,
  "end": 127.32,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon, bibilangin ko ang mga Pilipino sa mesa.",
  "start": 127.745,
  "end": 130.485,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Wala.",
  "start": 130.91,
  "end": 131.2,
  "style": "hollow",
  "speaker": "INDIO"
 },
 {
  "text": "Nabitawan niya ang bandeha.",
  "start": 131.665,
  "end": 133.185,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nabasag ang mga baso, at sumugod ang punong weyter.",
  "start": 133.61,
  "end": 137.11,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Imbécile!",
  "start": 137.575,
  "end": 138.465,
  "style": "shout",
  "speaker": "PUNONG WEYTER"
 },
 {
  "text": "Hinila siya nito pababa, sa harap ng mga maruming pinggan.",
  "start": 138.93,
  "end": 142.25,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa silid na 'yon pinagpasyahan ang bayan ko.",
  "start": 142.715,
  "end": 144.805,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "At wala ni isa sa atin ang tinanong.",
  "start": 145.151,
  "end": 146.851,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Dito sa ibaba, kuya, mas marami kang makikita.",
  "start": 147.696,
  "end": 150.696,
  "style": "gentle",
  "speaker": "AMBO"
 },
 {
  "text": "Subukan mo ang bintanang 'yan.",
  "start": 151.103,
  "end": 152.593,
  "style": "gentle",
  "speaker": "AMBO"
 },
 {
  "text": "Mula sa maliit na bintana ng kusina, may natanaw si Indio: isang lalaking nagsusulat mag-isa, sa kabila ng kalye.",
  "start": 153.058,
  "end": 160.478,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Par.",
  "start": 160.943,
  "end": 161.213,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Mali ang silid na pinasok mo kanina.",
  "start": 161.638,
  "end": 163.348,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "'Yang bintanang 'yan ang tama.",
  "start": 163.755,
  "end": 165.035,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Sino 'yon?",
  "start": 165.5,
  "end": 166.06,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Si Don Felipe Agoncillo.",
  "start": 166.525,
  "end": 168.215,
  "style": "proud",
  "speaker": "AMBO"
 },
 {
  "text": "Abogado, taga-Batangas din.",
  "start": 168.64,
  "end": 170.31,
  "style": "proud",
  "speaker": "AMBO"
 },
 {
  "text": "Sugo natin.",
  "start": 170.696,
  "end": 171.416,
  "style": "proud",
  "speaker": "AMBO"
 },
 {
  "text": "Ilang linggo na siyang kumakatok sa kanila.",
  "start": 171.841,
  "end": 173.711,
  "style": "proud",
  "speaker": "AMBO"
 },
 {
  "text": "Hindi siya pinapasok kahit minsan.",
  "start": 174.077,
  "end": 175.747,
  "style": "proud",
  "speaker": "AMBO"
 },
 {
  "text": "Idinikit ng lalaki sa noo niya ang isang liham.",
  "start": 176.212,
  "end": 178.802,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sulat ng asawa niya.",
  "start": 179.267,
  "end": 180.297,
  "style": "soft",
  "speaker": "AMBO"
 },
 {
  "text": "Si Doña Marcela.",
  "start": 180.644,
  "end": 181.624,
  "style": "soft",
  "speaker": "AMBO"
 },
 {
  "text": "Nasa Hong Kong.",
  "start": 182.049,
  "end": 182.769,
  "style": "soft",
  "speaker": "AMBO"
 },
 {
  "text": "Tutol ako sa anumang pasyang ginawa rito, hangga't hindi kinikilala ang kalayaan ng bayang Pilipino.",
  "start": 183.414,
  "end": 189.704,
  "style": "steady",
  "speaker": "AGONCILLO"
 },
 {
  "text": "Lumamlam ang lampara ng lalaki.",
  "start": 190.169,
  "end": 192.009,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala na siyang langis.",
  "start": 192.474,
  "end": 193.454,
  "style": "worried",
  "speaker": "AMBO"
 },
 {
  "text": "At wala na akong pambili.",
  "start": 193.879,
  "end": 195.024,
  "style": "worried",
  "speaker": "AMBO"
 },
 {
  "text": "Ito.",
  "start": 195.489,
  "end": 195.779,
  "style": "pained",
  "speaker": "INDIO"
 },
 {
  "text": "Huling pera ko 'to.",
  "start": 196.204,
  "end": 196.984,
  "style": "pained",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi 'yan tatanggapin dito.",
  "start": 197.449,
  "end": 198.739,
  "style": "puzzled",
  "speaker": "AMBO"
 },
 {
  "text": "Sino 'yang nakaguhit?",
  "start": 199.164,
  "end": 200.084,
  "style": "puzzled",
  "speaker": "AMBO"
 },
 {
  "text": "Si Quezon.",
  "start": 200.549,
  "end": 201.029,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Presidente natin.",
  "start": 201.454,
  "end": 202.324,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Balang araw.",
  "start": 202.749,
  "end": 203.459,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Presidente.",
  "start": 203.924,
  "end": 204.724,
  "style": "moved",
  "speaker": "AMBO"
 },
 {
  "text": "Natin.",
  "start": 205.149,
  "end": 205.609,
  "style": "moved",
  "speaker": "AMBO"
 },
 {
  "text": "Itatago ko 'to, kuya.",
  "start": 206.034,
  "end": 207.284,
  "style": "moved",
  "speaker": "AMBO"
 },
 {
  "text": "Ako nang bahala sa langis.",
  "start": 207.709,
  "end": 209.299,
  "style": "moved",
  "speaker": "AMBO"
 },
 {
  "text": "Dinala ni Ambo ang sarili niyang lampara sa kabilang kalye.",
  "start": 209.764,
  "end": 212.934,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sumunod si Indio at tatlo pang tagahugas, at tumayo sila sa niyebe.",
  "start": 213.359,
  "end": 217.819,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bilangin mo ulit, par.",
  "start": 218.284,
  "end": 219.364,
  "style": "soft",
  "speaker": "USMAN"
 },
 {
  "text": "Isa, dalawa, tatlo, apat, lima.",
  "start": 219.829,
  "end": 223.239,
  "style": "warm",
  "speaker": "INDIO"
 },
 {
  "text": "Lima kaming Pilipino sa kalyeng ito.",
  "start": 223.605,
  "end": 225.225,
  "style": "warm",
  "speaker": "INDIO"
 },
 {
  "text": "Lumamig ang medalyon.",
  "start": 226.07,
  "end": 227.46,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumalik si Indio sa kasalukuyan, may ikalimang marka.",
  "start": 227.885,
  "end": 231.145,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Aray.",
  "start": 231.61,
  "end": 232.09,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Lima.",
  "start": 232.515,
  "end": 232.925,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "At ang natira sa akin, bente ng ibang tao.",
  "start": 233.35,
  "end": 235.91,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kabilang kalsada, may babaeng may pulang payong na hindi niya kilala.",
  "start": 236.375,
  "end": 240.865,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinaas nito ang limang daliri, tapos nawala.",
  "start": 241.29,
  "end": 244.03,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Lima.",
  "start": 244.495,
  "end": 244.805,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Bakit parang binibilang niya ako?",
  "start": 245.23,
  "end": 246.67,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: kung hindi ka pinapasok sa silid, saan ka tatayo para marinig ka pa rin?",
  "start": 247.515,
  "end": 252.365,
  "style": "curious",
  "speaker": "INDIO"
 }
]