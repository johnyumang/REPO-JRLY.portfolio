[
 {
  "text": "Imbécile!",
  "start": 0.415,
  "end": 1.305,
  "style": "shout",
  "speaker": "PUNONG WEYTER"
 },
 {
  "text": "Nakabasag ako ng baso sa gabing ipinamigay ang Pilipinas.",
  "start": 1.77,
  "end": 4.87,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Mas napansin pa nila ang baso.",
  "start": 5.295,
  "end": 6.785,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 7.21,
  "end": 8.24,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "At ayoko sanang bumalik sa nakaraan ngayong gabi.",
  "start": 8.665,
  "end": 11.065,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon.",
  "start": 11.91,
  "end": 12.44,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "San Juan.",
  "start": 12.849,
  "end": 13.849,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Apat na ang marka sa braso ni Indio, pero wala pa rin siyang trabaho.",
  "start": 14.274,
  "end": 18.374,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang lukot na bente na lang ang pera niya.",
  "start": 18.799,
  "end": 20.999,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bente: ang perang papel na pinakagamit nating mga Pilipino.",
  "start": 21.464,
  "end": 25.704,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya nga ginagawa na itong barya, kasi mabilis maluma.",
  "start": 26.129,
  "end": 29.139,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Si Quezon ang nakaguhit.",
  "start": 29.564,
  "end": 31.184,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Sa akin, hindi naluluma.",
  "start": 31.609,
  "end": 32.939,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi kasi tumatagal.",
  "start": 33.364,
  "end": 34.434,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi.",
  "start": 34.859,
  "end": 35.229,
  "style": "firm",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi ako magbabasa ngayong gabi.",
  "start": 35.654,
  "end": 36.894,
  "style": "firm",
  "speaker": "INDIO"
 },
 {
  "text": "Gutom ako, pagod ako.",
  "start": 37.319,
  "end": 38.719,
  "style": "firm",
  "speaker": "INDIO"
 },
 {
  "text": "Uy, bente rin.",
  "start": 39.144,
  "end": 40.124,
  "style": "pleased",
  "speaker": "INDIO"
 },
 {
  "text": "May nakasulat pa.",
  "start": 40.472,
  "end": 41.292,
  "style": "pleased",
  "speaker": "INDIO"
 },
 {
  "text": "May napulot siyang isa pang bente na may sulat-kamay, at binasa niya nang malakas.",
  "start": 41.757,
  "end": 46.357,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Galing pala kay M, na hindi pa rin niya kilala.",
  "start": 46.782,
  "end": 49.272,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "M na naman.",
  "start": 49.737,
  "end": 50.487,
  "style": "annoyed",
  "speaker": "INDIO"
 },
 {
  "text": "Naisahan ako.",
  "start": 50.912,
  "end": 51.632,
  "style": "annoyed",
  "speaker": "INDIO"
 },
 {
  "text": "Paris.",
  "start": 52.477,
  "end": 52.947,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ikasampu ng Disyembre, 1898.",
  "start": 53.372,
  "end": 56.962,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Gabi.",
  "start": 57.387,
  "end": 57.677,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Napunta siya sa isang eskinita sa Paris, sa gitna ng niyebe.",
  "start": 58.102,
  "end": 61.572,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa tabi niya, lumitaw si Usman, ang asong itim na siya lang ang nakakarinig.",
  "start": 61.958,
  "end": 66.598,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bonjour, par.",
  "start": 67.063,
  "end": 68.523,
  "style": "shivering",
  "speaker": "USMAN"
 },
 {
  "text": "Ang lamig.",
  "start": 68.948,
  "end": 69.458,
  "style": "shivering",
  "speaker": "USMAN"
 },
 {
  "text": "Bakit ba ako sumasama sa'yo?",
  "start": 69.883,
  "end": 71.333,
  "style": "shivering",
  "speaker": "USMAN"
 },
 {
  "text": "Ikaw ang may balahibo.",
  "start": 71.798,
  "end": 72.888,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Ako ang naka-polo lang.",
  "start": 73.256,
  "end": 74.316,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Pinapasok sila ng isang Pilipinong tagahugas ng pinggan: si Ambo.",
  "start": 74.781,
  "end": 78.921,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kababayan?",
  "start": 79.386,
  "end": 79.906,
  "style": "surprised",
  "speaker": "AMBO"
 },
 {
  "text": "Dito?",
  "start": 80.331,
  "end": 80.656,
  "style": "surprised",
  "speaker": "AMBO"
 },
 {
  "text": "Pumasok ka, mamamatay ka sa lamig.",
  "start": 81.064,
  "end": 82.974,
  "style": "surprised",
  "speaker": "AMBO"
 },
 {
  "text": "Ako si Ambo.",
  "start": 83.459,
  "end": 84.319,
  "style": "surprised",
  "speaker": "AMBO"
 },
 {
  "text": "Marino, taga-Batangas.",
  "start": 84.665,
  "end": 86.245,
  "style": "surprised",
  "speaker": "AMBO"
 },
 {
  "text": "Naiwan ng barko, kaya naghuhugas ng pinggan.",
  "start": 86.67,
  "end": 88.8,
  "style": "surprised",
  "speaker": "AMBO"
 },
 {
  "text": "Ano'ng meron sa itaas?",
  "start": 89.265,
  "end": 90.395,
  "style": "curious",
  "speaker": "INDIO"
 },
 {
  "text": "Ang daming karwahe.",
  "start": 90.743,
  "end": 91.833,
  "style": "curious",
  "speaker": "INDIO"
 },
 {
  "text": "Mga Amerikano at Kastila.",
  "start": 92.298,
  "end": 93.708,
  "style": "low",
  "speaker": "AMBO"
 },
 {
  "text": "Pinag-uusapan ang Pilipinas.",
  "start": 94.133,
  "end": 95.632,
  "style": "low",
  "speaker": "AMBO"
 },
 {
  "text": "Ngayong gabi ang pirmahan.",
  "start": 96.057,
  "end": 97.187,
  "style": "low",
  "speaker": "AMBO"
 },
 {
  "text": "Sabi sa internet, binili raw tayo.",
  "start": 97.652,
  "end": 99.542,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Dalawang dolyar bawat ulo.",
  "start": 99.967,
  "end": 101.327,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Gusto kong makita kung sino ang pumayag.",
  "start": 101.752,
  "end": 103.622,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Binihisan siya ni Ambo bilang weyter, para makapasok sa silid ng pirmahan.",
  "start": 104.467,
  "end": 108.837,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Huwag kang titingin sa mata nila.",
  "start": 109.302,
  "end": 110.982,
  "style": "quick",
  "speaker": "AMBO"
 },
 {
  "text": "Hindi ka nila makikita.",
  "start": 111.388,
  "end": 112.588,
  "style": "quick",
  "speaker": "AMBO"
 },
 {
  "text": "Ganyan kami rito.",
  "start": 113.013,
  "end": 113.853,
  "style": "quick",
  "speaker": "AMBO"
 },
 {
  "text": "Nakapasok ako.",
  "start": 114.318,
  "end": 115.238,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ako, na hindi makapasok kahit sa isang opisina sa Quezon City.",
  "start": 115.663,
  "end": 119.193,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sa mesa, may papel na may numero: dalawampung milyon.",
  "start": 119.658,
  "end": 123.618,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ayan ang numero.",
  "start": 124.083,
  "end": 124.883,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Bayad ng Amerika sa Espanya.",
  "start": 125.308,
  "end": 126.883,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon, bibilangin ko ang mga Pilipino sa mesa.",
  "start": 127.308,
  "end": 129.858,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Wala.",
  "start": 130.283,
  "end": 130.573,
  "style": "hollow",
  "speaker": "INDIO"
 },
 {
  "text": "Nabitawan niya ang bandeha.",
  "start": 131.038,
  "end": 132.558,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nabasag ang mga baso, at sumugod ang punong weyter.",
  "start": 132.983,
  "end": 136.483,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Imbécile!",
  "start": 136.948,
  "end": 137.838,
  "style": "shout",
  "speaker": "PUNONG WEYTER"
 },
 {
  "text": "Hinila siya nito pababa, sa harap ng mga maruming pinggan.",
  "start": 138.303,
  "end": 141.623,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa silid na 'yon pinagpasyahan ang bayan ko.",
  "start": 142.088,
  "end": 144.178,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "At wala ni isa sa atin ang tinanong.",
  "start": 144.524,
  "end": 146.224,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Dito sa ibaba, kuya, mas marami kang makikita.",
  "start": 147.069,
  "end": 150.069,
  "style": "gentle",
  "speaker": "AMBO"
 },
 {
  "text": "Subukan mo ang bintanang 'yan.",
  "start": 150.476,
  "end": 151.966,
  "style": "gentle",
  "speaker": "AMBO"
 },
 {
  "text": "Mula sa maliit na bintana ng kusina, may natanaw si Indio: isang lalaking nagsusulat mag-isa, sa kabila ng kalye.",
  "start": 152.431,
  "end": 159.851,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Par.",
  "start": 160.316,
  "end": 160.576,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Mali ang silid na pinasok mo kanina.",
  "start": 161.001,
  "end": 162.701,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "'Yang bintanang 'yan ang tama.",
  "start": 163.108,
  "end": 164.368,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Sino 'yon?",
  "start": 164.833,
  "end": 165.363,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Si Don Felipe Agoncillo.",
  "start": 165.828,
  "end": 167.518,
  "style": "proud",
  "speaker": "AMBO"
 },
 {
  "text": "Abogado, taga-Batangas din.",
  "start": 167.943,
  "end": 169.613,
  "style": "proud",
  "speaker": "AMBO"
 },
 {
  "text": "Sugo natin.",
  "start": 169.999,
  "end": 170.729,
  "style": "proud",
  "speaker": "AMBO"
 },
 {
  "text": "Ilang linggo na siyang kumakatok sa kanila.",
  "start": 171.154,
  "end": 173.024,
  "style": "proud",
  "speaker": "AMBO"
 },
 {
  "text": "Hindi siya pinapasok kahit minsan.",
  "start": 173.39,
  "end": 175.06,
  "style": "proud",
  "speaker": "AMBO"
 },
 {
  "text": "Idinikit ng lalaki sa noo niya ang isang liham.",
  "start": 175.525,
  "end": 178.115,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sulat ng asawa niya.",
  "start": 178.58,
  "end": 179.61,
  "style": "soft",
  "speaker": "AMBO"
 },
 {
  "text": "Si Doña Marcela.",
  "start": 179.957,
  "end": 180.937,
  "style": "soft",
  "speaker": "AMBO"
 },
 {
  "text": "Nasa Hong Kong.",
  "start": 181.362,
  "end": 182.082,
  "style": "soft",
  "speaker": "AMBO"
 },
 {
  "text": "Tutol ako sa anumang pasyang ginawa rito, hangga't hindi kinikilala ang kalayaan ng bayang Pilipino.",
  "start": 182.727,
  "end": 189.017,
  "style": "steady",
  "speaker": "AGONCILLO"
 },
 {
  "text": "Lumamlam ang lampara ng lalaki.",
  "start": 189.482,
  "end": 191.322,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala na siyang langis.",
  "start": 191.787,
  "end": 192.757,
  "style": "worried",
  "speaker": "AMBO"
 },
 {
  "text": "At wala na akong pambili.",
  "start": 193.182,
  "end": 194.327,
  "style": "worried",
  "speaker": "AMBO"
 },
 {
  "text": "Ito.",
  "start": 194.792,
  "end": 195.082,
  "style": "pained",
  "speaker": "INDIO"
 },
 {
  "text": "Huling pera ko 'to.",
  "start": 195.507,
  "end": 196.287,
  "style": "pained",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi 'yan tatanggapin dito.",
  "start": 196.752,
  "end": 198.042,
  "style": "puzzled",
  "speaker": "AMBO"
 },
 {
  "text": "Sino 'yang nakaguhit?",
  "start": 198.467,
  "end": 199.397,
  "style": "puzzled",
  "speaker": "AMBO"
 },
 {
  "text": "Si Quezon.",
  "start": 199.862,
  "end": 200.512,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Presidente natin.",
  "start": 200.879,
  "end": 201.749,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Balang araw.",
  "start": 202.174,
  "end": 202.789,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Presidente.",
  "start": 203.254,
  "end": 204.054,
  "style": "moved",
  "speaker": "AMBO"
 },
 {
  "text": "Natin.",
  "start": 204.479,
  "end": 204.949,
  "style": "moved",
  "speaker": "AMBO"
 },
 {
  "text": "Itatago ko 'to, kuya.",
  "start": 205.374,
  "end": 206.624,
  "style": "moved",
  "speaker": "AMBO"
 },
 {
  "text": "Ako nang bahala sa langis.",
  "start": 207.049,
  "end": 208.639,
  "style": "moved",
  "speaker": "AMBO"
 },
 {
  "text": "Dinala ni Ambo ang sarili niyang lampara sa kabilang kalye.",
  "start": 209.104,
  "end": 212.274,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sumunod si Indio at tatlo pang tagahugas, at tumayo sila sa niyebe.",
  "start": 212.699,
  "end": 217.169,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bilangin mo ulit, par.",
  "start": 217.634,
  "end": 218.704,
  "style": "soft",
  "speaker": "USMAN"
 },
 {
  "text": "Isa, dalawa, tatlo, apat, lima.",
  "start": 219.169,
  "end": 222.569,
  "style": "warm",
  "speaker": "INDIO"
 },
 {
  "text": "Lima kaming Pilipino sa kalyeng ito.",
  "start": 222.935,
  "end": 224.555,
  "style": "warm",
  "speaker": "INDIO"
 },
 {
  "text": "Lumamig ang medalyon.",
  "start": 225.4,
  "end": 226.78,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumalik si Indio sa kasalukuyan, may ikalimang marka.",
  "start": 227.205,
  "end": 230.475,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Aray.",
  "start": 230.94,
  "end": 231.4,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Lima.",
  "start": 231.825,
  "end": 232.295,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "At ang natira sa akin, bente ng ibang tao.",
  "start": 232.72,
  "end": 235.53,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kabilang kalsada, may babaeng may pulang payong na hindi niya kilala.",
  "start": 235.995,
  "end": 240.485,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinaas nito ang limang daliri, tapos nawala.",
  "start": 240.91,
  "end": 243.64,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Lima.",
  "start": 244.105,
  "end": 244.425,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Bakit parang binibilang niya ako?",
  "start": 244.85,
  "end": 246.29,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: kung hindi ka pinapasok sa silid, saan ka tatayo para marinig ka pa rin?",
  "start": 247.135,
  "end": 251.985,
  "style": "curious",
  "speaker": "INDIO"
 }
]