[
 {
  "text": "Bumigay na ang pader!",
  "start": 0.01,
  "end": 1.21,
  "style": "shout",
  "speaker": "SEPA"
 },
 {
  "text": "Naghatid lang ako ng pancit.",
  "start": 1.61,
  "end": 2.99,
  "style": "dramatic",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ngayon, hinahabol na ako ng giyera.",
  "start": 3.37,
  "end": 5.53,
  "style": "dramatic",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 5.92,
  "end": 7.08,
  "style": "playful",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "At oo, late na naman ako.",
  "start": 7.45,
  "end": 9.08,
  "style": "playful",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ngayon.",
  "start": 9.86,
  "end": 10.41,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Intramuros.",
  "start": 10.77,
  "end": 11.71,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Unang araw ni Indio bilang delivery rider.",
  "start": 12.13,
  "end": 14.67,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang order: pancit para sa isang nagngangalang M, na hindi niya kilala, sa lumang pader ng Intramuros.",
  "start": 15.02,
  "end": 21.26,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Walang naghihintay.",
  "start": 21.63,
  "end": 22.76,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pancit: sabi nila, galing sa salitang Hokkien na ang ibig sabihin, pagkaing madaling lutuin.",
  "start": 23.14,
  "end": 28.74,
  "style": "playful",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Madaling lutuin, mahirap tiisin.",
  "start": 29.1,
  "end": 31.13,
  "style": "playful",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Bawal ko kasing tikman.",
  "start": 31.51,
  "end": 32.87,
  "style": "playful",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Isang bituin lang ang rating niya sa app.",
  "start": 33.26,
  "end": 35.24,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "May ibang rider na laging nauuna.",
  "start": 35.61,
  "end": 38.03,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sige.",
  "start": 38.41,
  "end": 38.73,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Babasahin ko na lang 'tong karatula habang naghihintay.",
  "start": 39.09,
  "end": 41.74,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Binasa niya nang malakas ang karatula.",
  "start": 42.16,
  "end": 44.22,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Uminit ang medalyong mana niya sa Lolo niya, at dinala siya sa nakaraan.",
  "start": 44.57,
  "end": 48.71,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mula sa liwanag, lumundag si Usman: ang asong itim na siya lang ang nakakarinig, at sa nakaraan lang lumilitaw.",
  "start": 49.12,
  "end": 56.35,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Usman!",
  "start": 56.73,
  "end": 57.22,
  "style": "glad",
  "speaker": "INDIO"
 },
 {
  "text": "Ang asong madaldal.",
  "start": 57.58,
  "end": 58.55,
  "style": "glad",
  "speaker": "INDIO"
 },
 {
  "text": "Ayan ka na naman.",
  "start": 58.97,
  "end": 59.87,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "May dala ka pang baon.",
  "start": 60.22,
  "end": 61.27,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Oktubre 1762.",
  "start": 62.08,
  "end": 64.83,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa loob ng pader ng Maynila.",
  "start": 65.17,
  "end": 66.85,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumagsak si Indio sa gitna ng putukan.",
  "start": 67.25,
  "end": 69.94,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinila siya papasok sa isang kusina ni Sepa, isang batang babaeng nakatira roon kasama ang lola niya.",
  "start": 70.32,
  "end": 76.4,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Yumuko ka!",
  "start": 76.79,
  "end": 77.57,
  "style": "urgent",
  "speaker": "SEPA"
 },
 {
  "text": "Halos dalawang linggo na silang nagpapaputok.",
  "start": 77.94,
  "end": 79.95,
  "style": "urgent",
  "speaker": "SEPA"
 },
 {
  "text": "Sino?",
  "start": 80.33,
  "end": 80.62,
  "style": "confused",
  "speaker": "INDIO"
 },
 {
  "text": "Mga Kastila?",
  "start": 80.98,
  "end": 81.61,
  "style": "confused",
  "speaker": "INDIO"
 },
 {
  "text": "Mga Ingles.",
  "start": 82.03,
  "end": 82.73,
  "style": "flat",
  "speaker": "SEPA"
 },
 {
  "text": "Galing sa dagat, kasama ang mga sundalong taga-India.",
  "start": 83.08,
  "end": 85.74,
  "style": "flat",
  "speaker": "SEPA"
 },
 {
  "text": "Sabi ng titser ko: Kastila, Amerikano, Hapon.",
  "start": 86.15,
  "end": 89.66,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Walang nagbanggit ng British.",
  "start": 90.0,
  "end": 91.5,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Pero pader 'to ng Intramuros.",
  "start": 91.9,
  "end": 93.74,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi 'to matitibag, 'di ba?",
  "start": 94.12,
  "end": 95.49,
  "style": "nervous",
  "speaker": "INDIO"
 },
 {
  "text": "Pader lang 'yan.",
  "start": 95.88,
  "end": 96.66,
  "style": "flat",
  "speaker": "SEPA"
 },
 {
  "text": "May kanyon sila.",
  "start": 97.03,
  "end": 97.94,
  "style": "flat",
  "speaker": "SEPA"
 },
 {
  "text": "Hindi na makalakad ang lola ni Sepa.",
  "start": 98.32,
  "end": 100.48,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kaya hindi sila makatakas.",
  "start": 100.84,
  "end": 102.49,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si Lola.",
  "start": 102.91,
  "end": 103.59,
  "style": "soft",
  "speaker": "SEPA"
 },
 {
  "text": "Hindi ko siya maiiwan.",
  "start": 103.94,
  "end": 104.96,
  "style": "soft",
  "speaker": "SEPA"
 },
 {
  "text": "Tumakbo si Indio sa isang guwardiyang Kastila sa pader, para humingi ng tulong.",
  "start": 105.77,
  "end": 110.52,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Señor!",
  "start": 110.9,
  "end": 111.53,
  "style": "urgent",
  "speaker": "INDIO"
 },
 {
  "text": "Malapit nang bumigay ang pader sa baluarte.",
  "start": 111.89,
  "end": 114.02,
  "style": "urgent",
  "speaker": "INDIO"
 },
 {
  "text": "May mga tao pa roon!",
  "start": 114.4,
  "end": 115.39,
  "style": "urgent",
  "speaker": "INDIO"
 },
 {
  "text": "Indio, bumalik ka sa kusina.",
  "start": 115.78,
  "end": 117.52,
  "style": "cold",
  "speaker": "GUWARDIYA"
 },
 {
  "text": "Paano mo nalaman ang pangalan ko?",
  "start": 117.93,
  "end": 119.33,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Itinulak siya sa putik, at pinagtawanan.",
  "start": 119.71,
  "end": 122.47,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ah.",
  "start": 122.87,
  "end": 123.09,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Hindi pala pangalan.",
  "start": 123.469,
  "end": 124.359,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Tawag pala 'yon sa aming lahat.",
  "start": 124.709,
  "end": 126.189,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "At gumuho ang pader.",
  "start": 126.599,
  "end": 128.229,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pumasok ang mga sundalong naka-pula.",
  "start": 128.569,
  "end": 130.629,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumigay na ang pader!",
  "start": 131.029,
  "end": 132.229,
  "style": "shout",
  "speaker": "SEPA"
 },
 {
  "text": "Huli na ako.",
  "start": 132.649,
  "end": 133.199,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Puwede ka palang mahuli kahit sa nakaraan.",
  "start": 133.549,
  "end": 135.419,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Noon napansin ni Usman ang mga daga, tumatakbo sa iisang direksyon.",
  "start": 136.229,
  "end": 140.649,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Par, tumahimik ka muna.",
  "start": 141.029,
  "end": 142.589,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "May sinasabi sila.",
  "start": 142.949,
  "end": 143.899,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Tumahimik si Indio.",
  "start": 144.319,
  "end": 145.529,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At naintindihan niya ang mga hayop.",
  "start": 145.879,
  "end": 147.779,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "\"Ilalim.\"",
  "start": 148.189,
  "end": 148.779,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "'Yun ang sabi nila.",
  "start": 149.119,
  "end": 149.989,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ilalim.",
  "start": 150.349,
  "end": 150.839,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "May labasan sila.",
  "start": 151.259,
  "end": 152.109,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Pero walang libre sa hayop, par.",
  "start": 152.459,
  "end": 154.109,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Order 'to ng customer.",
  "start": 154.519,
  "end": 155.709,
  "style": "pained",
  "speaker": "INDIO"
 },
 {
  "text": "Unang sahod ko 'to.",
  "start": 156.049,
  "end": 156.969,
  "style": "pained",
  "speaker": "INDIO"
 },
 {
  "text": "Ibinuhos niya ang pancit.",
  "start": 157.369,
  "end": 158.749,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Itinuro ng mga daga ang isang lumang imburnal.",
  "start": 159.129,
  "end": 162.269,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sepa!",
  "start": 162.659,
  "end": 163.039,
  "style": "sure",
  "speaker": "INDIO"
 },
 {
  "text": "Ang lola mo.",
  "start": 163.409,
  "end": 164.019,
  "style": "sure",
  "speaker": "INDIO"
 },
 {
  "text": "Bubuhatin ko.",
  "start": 164.359,
  "end": 165.239,
  "style": "sure",
  "speaker": "INDIO"
 },
 {
  "text": "Pinasan niya ang lola, at gumapang silang lahat palabas.",
  "start": 165.639,
  "end": 168.959,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pati ang guwardiya, sumunod.",
  "start": 169.339,
  "end": 171.019,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Indio!",
  "start": 171.409,
  "end": 171.939,
  "style": "scared",
  "speaker": "GUWARDIYA"
 },
 {
  "text": "Saan ang labasan?",
  "start": 172.309,
  "end": 173.499,
  "style": "scared",
  "speaker": "GUWARDIYA"
 },
 {
  "text": "Sundan mo ang daga, señor.",
  "start": 173.879,
  "end": 175.859,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Sila ang mas nakakaalam dito.",
  "start": 176.219,
  "end": 177.979,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Nakalabas silang lahat sa tabing-ilog, buhay.",
  "start": 178.799,
  "end": 181.259,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa Maynila, may bagong watawat na.",
  "start": 181.609,
  "end": 183.879,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Labing-apat, par.",
  "start": 184.289,
  "end": 185.369,
  "style": "proud",
  "speaker": "USMAN"
 },
 {
  "text": "Bilangin mo.",
  "start": 185.709,
  "end": 186.499,
  "style": "proud",
  "speaker": "USMAN"
 },
 {
  "text": "Sa isang supot ng pancit.",
  "start": 186.859,
  "end": 188.079,
  "style": "proud",
  "speaker": "USMAN"
 },
 {
  "text": "Sumuko na raw ang lungsod.",
  "start": 188.499,
  "end": 189.729,
  "style": "quiet",
  "speaker": "SEPA"
 },
 {
  "text": "Ang arsobispo mismo.",
  "start": 190.079,
  "end": 191.239,
  "style": "quiet",
  "speaker": "SEPA"
 },
 {
  "text": "Tapos na pala.",
  "start": 191.649,
  "end": 192.339,
  "style": "sad",
  "speaker": "INDIO"
 },
 {
  "text": "Sa kanila na tayo.",
  "start": 192.679,
  "end": 193.619,
  "style": "sad",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi pa.",
  "start": 194.019,
  "end": 194.529,
  "style": "fierce",
  "speaker": "SEPA"
 },
 {
  "text": "May isang hukom na nakaalis bago bumagsak ang pader.",
  "start": 194.909,
  "end": 197.589,
  "style": "fierce",
  "speaker": "SEPA"
 },
 {
  "text": "Nasa Pampanga na raw.",
  "start": 197.939,
  "end": 199.019,
  "style": "fierce",
  "speaker": "SEPA"
 },
 {
  "text": "Lalaban.",
  "start": 199.389,
  "end": 199.919,
  "style": "fierce",
  "speaker": "SEPA"
 },
 {
  "text": "Hindi ko nailigtas ang Maynila.",
  "start": 200.299,
  "end": 201.799,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Isang kusina lang.",
  "start": 202.159,
  "end": 203.129,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Para sa susunod mong hatid, Indio.",
  "start": 203.549,
  "end": 205.219,
  "style": "warm",
  "speaker": "SEPA"
 },
 {
  "text": "'Yung pangalan, ha.",
  "start": 205.569,
  "end": 206.419,
  "style": "warm",
  "speaker": "SEPA"
 },
 {
  "text": "Hindi 'yung tawag.",
  "start": 206.789,
  "end": 207.469,
  "style": "warm",
  "speaker": "SEPA"
 },
 {
  "text": "Itinali ni Sepa ang tapis niya sa supot ni Indio.",
  "start": 207.849,
  "end": 210.659,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At ang guwardiyang tumulak sa kanya, yumuko bilang pasasalamat.",
  "start": 211.019,
  "end": 214.769,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Lumamig ang medalyon.",
  "start": 215.589,
  "end": 216.989,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumalik si Indio sa kasalukuyan.",
  "start": 217.379,
  "end": 219.389,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa braso niya, may pangalawa nang marka.",
  "start": 219.759,
  "end": 222.119,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Aray.",
  "start": 222.499,
  "end": 222.909,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Dalawa na.",
  "start": 223.269,
  "end": 223.959,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "At wala na akong pancit.",
  "start": 224.339,
  "end": 225.499,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Tapis na lang.",
  "start": 225.849,
  "end": 226.599,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Paano ko ipapaliwanag 'to sa app?",
  "start": 226.969,
  "end": 228.689,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "\"Kinain po ng daga, noong 1762.\"",
  "start": 229.029,
  "end": 232.449,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Kinansela ng app ang order.",
  "start": 232.849,
  "end": 234.479,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pero may isa pang dumating.",
  "start": 234.859,
  "end": 236.279,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Teka.",
  "start": 236.669,
  "end": 237.009,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "\"Delivered.\"",
  "start": 237.379,
  "end": 237.949,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "May tip pa.",
  "start": 238.289,
  "end": 238.879,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Galing kay M.",
  "start": 239.239,
  "end": 240.019,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "\"Basahin mo nang malakas ang susunod.\"",
  "start": 240.439,
  "end": 242.309,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Sino ka ba, M?",
  "start": 242.659,
  "end": 244.139,
  "style": "whispers",
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ikaw, ka-Indio: kung isang pamilya lang ang kaya mong ilabas, tatakbo ka pa rin ba pabalik?",
