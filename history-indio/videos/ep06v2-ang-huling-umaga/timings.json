[
 {
  "text": "Fuego!",
  "start": 0.015,
  "end": 0.435,
  "style": "shout",
  "speaker": "OPISYAL"
 },
 {
  "text": "Sabi niya, huwag akong pipikit.",
  "start": 2.5,
  "end": 4.32,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Isang segundo lang akong pumikit.",
  "start": 4.745,
  "end": 6.115,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Isang segundo lang.",
  "start": 6.54,
  "end": 7.43,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 7.855,
  "end": 8.845,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "At ito ang una kong date.",
  "start": 9.253,
  "end": 10.303,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon.",
  "start": 11.148,
  "end": 11.688,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Luneta, bago mag-alas-sais ng umaga.",
  "start": 12.113,
  "end": 14.803,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nag-message si M, ang hindi niya kilalang nagpapadala ng mga order at tip: magkikita na raw sila, alas-sais ng umaga, sa Luneta.",
  "start": 15.228,
  "end": 23.998,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kaya namalantsa si Indio ng polo, sa unang pagkakataon.",
  "start": 24.423,
  "end": 28.053,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Taho: galing sa salitang Tsino para sa tokwa.",
  "start": 28.518,
  "end": 32.018,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Dinala rito ng mga mangangalakal, tapos nilagyan natin ng arnibal at sago.",
  "start": 32.443,
  "end": 36.773,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Bente niya ang ipinambili ko.",
  "start": 37.198,
  "end": 38.608,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Libre niya ako, hindi niya alam.",
  "start": 39.033,
  "end": 40.803,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Dito?",
  "start": 41.228,
  "end": 41.558,
  "style": "uneasy",
  "speaker": "INDIO"
 },
 {
  "text": "Ito 'yung lugar kung saan...",
  "start": 41.966,
  "end": 43.236,
  "style": "uneasy",
  "speaker": "INDIO"
 },
 {
  "text": "Sige na nga.",
  "start": 43.661,
  "end": 44.131,
  "style": "uneasy",
  "speaker": "INDIO"
 },
 {
  "text": "Para sa'yo.",
  "start": 44.556,
  "end": 45.036,
  "style": "uneasy",
  "speaker": "INDIO"
 },
 {
  "text": "Pero walang tao sa tagpuan.",
  "start": 45.501,
  "end": 47.151,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Marker lang, at isang mensahe: basahin mo nang malakas.",
  "start": 47.576,
  "end": 51.386,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Binasa niya, at uminit ang medalyon.",
  "start": 51.811,
  "end": 54.181,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bagumbayan.",
  "start": 55.026,
  "end": 55.836,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ikatatlumpu ng Disyembre, 1896.",
  "start": 56.261,
  "end": 60.781,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Umaga.",
  "start": 61.206,
  "end": 61.686,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Napunta siya sa isang malawak na parang, puno ng taong tahimik.",
  "start": 62.111,
  "end": 66.021,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Lumitaw sa tabi niya si Usman, ang aso niyang nagsasalita, pero hindi ito bumati.",
  "start": 66.446,
  "end": 71.846,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Usman?",
  "start": 72.311,
  "end": 72.691,
  "style": "low",
  "speaker": "INDIO"
 },
 {
  "text": "Bakit ganyan ka?",
  "start": 73.116,
  "end": 73.916,
  "style": "low",
  "speaker": "INDIO"
 },
 {
  "text": "Kilala ko ang araw na ito, par.",
  "start": 74.381,
  "end": 75.841,
  "style": "quiet",
  "speaker": "USMAN"
 },
 {
  "text": "Huwag mo akong tanungin.",
  "start": 76.266,
  "end": 77.421,
  "style": "quiet",
  "speaker": "USMAN"
 },
 {
  "text": "May batang lumapit, may pasang banga: si Kiko, tagatinda ng tubig sa parang.",
  "start": 77.886,
  "end": 83.356,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tubig, kuya?",
  "start": 83.821,
  "end": 84.621,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Libre na ngayong umaga.",
  "start": 85.046,
  "end": 86.176,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Walang gustong uminom.",
  "start": 86.601,
  "end": 87.481,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Ano'ng meron?",
  "start": 87.946,
  "end": 88.626,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Babarilin si Doktor Rizal.",
  "start": 89.091,
  "end": 90.561,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Ayun siya.",
  "start": 90.986,
  "end": 91.516,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Sa gitna ng mga sundalo, naglalakad ang isang lalaking nakaitim.",
  "start": 91.981,
  "end": 95.901,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si Pepe.",
  "start": 96.366,
  "end": 96.856,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Si Rizal.",
  "start": 97.281,
  "end": 97.841,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung batang umiiyak sa Calamba.",
  "start": 98.266,
  "end": 99.836,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Tatlumpu't lima na siya.",
  "start": 100.261,
  "end": 101.381,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "At sa tabi ni Indio, bumukas ang isang pulang payong.",
  "start": 102.226,
  "end": 105.406,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si M.",
  "start": 105.831,
  "end": 106.4,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa unang pagkakataon, katabi niya.",
  "start": 106.825,
  "end": 109.375,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Indio.",
  "start": 109.84,
  "end": 110.28,
  "style": "calm",
  "speaker": "M"
 },
 {
  "text": "M?",
  "start": 110.745,
  "end": 110.975,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw 'yon?",
  "start": 111.4,
  "end": 111.83,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Nagplantsa pa ako.",
  "start": 112.178,
  "end": 112.958,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Dito mo ako dinala?",
  "start": 113.383,
  "end": 114.363,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Kailangan mong makita ito.",
  "start": 114.828,
  "end": 115.968,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Buong-buo.",
  "start": 116.393,
  "end": 116.983,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Hinawakan ni M ang kamay niya.",
  "start": 117.448,
  "end": 119.098,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sabi ng titser ko, mga Kastila ang bumaril sa kanya.",
  "start": 119.563,
  "end": 122.843,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi, kuya.",
  "start": 123.308,
  "end": 124.068,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Tingnan mo kung sino ang may hawak ng riple.",
  "start": 124.454,
  "end": 126.074,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Mga kababayan natin.",
  "start": 126.499,
  "end": 127.629,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Ang mga Kastila, nasa likod nila, nakatutok.",
  "start": 128.054,
  "end": 131.024,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Kaninang madaling-araw, sa pinto ng kuta, may babaeng lumabas na umiiyak.",
  "start": 131.449,
  "end": 135.159,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Si Josephine raw, ang mahal niya.",
  "start": 135.584,
  "end": 137.014,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Yakap niya ang isang libro.",
  "start": 137.42,
  "end": 138.46,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Bigay raw ni Doktor.",
  "start": 138.885,
  "end": 139.865,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Kinapa ng isang doktor ang pulso ng lalaking nakaitim.",
  "start": 140.71,
  "end": 143.93,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kalmado pa rin daw ang pulso niya.",
  "start": 144.395,
  "end": 145.995,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Humarap ang lalaki sa mga riple.",
  "start": 146.46,
  "end": 148.13,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pero pinatalikod siya ulit.",
  "start": 148.555,
  "end": 150.005,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Gusto niyang humarap.",
  "start": 150.47,
  "end": 151.35,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Ayaw nila.",
  "start": 151.716,
  "end": 152.316,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Traydor daw ang binabaril nang nakatalikod.",
  "start": 152.741,
  "end": 154.831,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Sabi sa pelikula, bumaling siya at bumagsak nang nakaharap sa langit.",
  "start": 155.296,
  "end": 159.306,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Huwag kang pipikit, Indio.",
  "start": 159.771,
  "end": 161.081,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Hindi ko kaya.",
  "start": 161.546,
  "end": 162.336,
  "style": "shaking",
  "speaker": "INDIO"
 },
 {
  "text": "Saksi ka.",
  "start": 162.801,
  "end": 163.331,
  "style": "firm",
  "speaker": "M"
 },
 {
  "text": "Huwag kang pipikit.",
  "start": 163.756,
  "end": 164.506,
  "style": "firm",
  "speaker": "M"
 },
 {
  "text": "Itinaas ng opisyal ang espada.",
  "start": 164.971,
  "end": 166.891,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Consummatum est!",
  "start": 167.536,
  "end": 168.686,
  "style": "clear",
  "speaker": "RIZAL"
 },
 {
  "text": "Fuego!",
  "start": 169.151,
  "end": 169.571,
  "style": "shout",
  "speaker": "OPISYAL"
 },
 {
  "text": "Pumikit si Indio.",
  "start": 173.836,
  "end": 174.916,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pagdilat niya, tahimik na ang parang.",
  "start": 177.741,
  "end": 180.141,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa damuhan, isang itim na sombrero.",
  "start": 180.566,
  "end": 182.951,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Narinig mo, kuya?",
  "start": 183.416,
  "end": 184.276,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "\"Tapos na,\" sabi niya.",
  "start": 184.683,
  "end": 185.823,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Sa wikang Latin.",
  "start": 186.248,
  "end": 186.998,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Hindi ko nakita kung bumaling siya.",
  "start": 187.463,
  "end": 189.093,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Pumikit ako.",
  "start": 189.518,
  "end": 190.178,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Saka lang niya napansin: wala na ang kamay ni M.",
  "start": 190.643,
  "end": 193.613,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala na ang pulang payong.",
  "start": 194.038,
  "end": 195.408,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At wala na ang medalyon sa leeg niya.",
  "start": 195.833,
  "end": 197.693,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "M?",
  "start": 198.158,
  "end": 198.368,
  "style": "panicked",
  "speaker": "INDIO"
 },
 {
  "text": "M!",
  "start": 198.793,
  "end": 199.113,
  "style": "panicked",
  "speaker": "INDIO"
 },
 {
  "text": "Ang medalyon ko!",
  "start": 199.481,
  "end": 200.261,
  "style": "panicked",
  "speaker": "INDIO"
 },
 {
  "text": "Sa bulsa niya, may iniwang sulat.",
  "start": 200.726,
  "end": 202.996,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "\"Pasensya na, Indio.",
  "start": 203.461,
  "end": 204.771,
  "style": "reading",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi sa'yo ang medalyon.",
  "start": 205.196,
  "end": 206.356,
  "style": "reading",
  "speaker": "INDIO"
 },
 {
  "text": "Ibabalik ko lang sa pinanggalingan.\"",
  "start": 206.781,
  "end": 208.361,
  "style": "reading",
  "speaker": "INDIO"
 },
 {
  "text": "Bawat order ng pancit.",
  "start": 208.786,
  "end": 210.016,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Bawat tip.",
  "start": 210.441,
  "end": 211.001,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Bawat bente.",
  "start": 211.408,
  "end": 212.198,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Siya pala ang nagdala sa akin dito, hakbang-hakbang.",
  "start": 212.623,
  "end": 215.283,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hinintay ni Indio na lumamig ang medalyon at iuwi siya.",
  "start": 216.128,
  "end": 219.748,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pero wala na siyang medalyon.",
  "start": 220.173,
  "end": 221.583,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi siya makakauwi.",
  "start": 222.008,
  "end": 223.108,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Walang bagong marka.",
  "start": 223.573,
  "end": 224.743,
  "style": "hollow",
  "speaker": "INDIO"
 },
 {
  "text": "Pumikit ka, par.",
  "start": 225.208,
  "end": 226.108,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Kaya walang marka.",
  "start": 226.533,
  "end": 227.393,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Kaya rin niya nakuha.",
  "start": 227.818,
  "end": 228.628,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Teka.",
  "start": 229.093,
  "end": 229.493,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Wala na ang medalyon.",
  "start": 229.918,
  "end": 230.878,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Bakit naririnig pa rin kita?",
  "start": 231.303,
  "end": 232.583,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi ko rin alam.",
  "start": 233.048,
  "end": 233.858,
  "style": "quiet",
  "speaker": "USMAN"
 },
 {
  "text": "Akala ko rin, sa medalyon 'yon.",
  "start": 234.283,
  "end": 235.793,
  "style": "quiet",
  "speaker": "USMAN"
 },
 {
  "text": "Taga-saan ka ba, kuya?",
  "start": 236.258,
  "end": 237.358,
  "style": "kind",
  "speaker": "KIKO"
 },
 {
  "text": "Mukhang malayo ang uuwian mo.",
  "start": 237.783,
  "end": 239.098,
  "style": "kind",
  "speaker": "KIKO"
 },
 {
  "text": "Isandaan at tatlumpung taon mula rito.",
  "start": 239.563,
  "end": 241.673,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Walang jeep.",
  "start": 242.098,
  "end": 242.748,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Sumikat ang araw sa parang.",
  "start": 243.213,
  "end": 244.793,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si Usman, nasa tabi pa rin niya.",
  "start": 245.218,
  "end": 247.328,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa unang pagkakataon, hindi siya naglaho.",
  "start": 247.793,
  "end": 250.333,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong medalyon.",
  "start": 250.758,
  "end": 251.768,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong daan pauwi.",
  "start": 252.193,
  "end": 253.333,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Pero may kasama ako.",
  "start": 253.758,
  "end": 254.858,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: may bagay ka bang hindi mo kinayang tingnan, na sana tiningnan mo?",
  "start": 255.703,
