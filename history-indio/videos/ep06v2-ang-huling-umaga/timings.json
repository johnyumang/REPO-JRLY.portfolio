[
 {
  "text": "Fuego!",
  "start": 0.015,
  "end": 0.435,
  "style": "shout",
  "speaker": "OPISYAL"
 },
 {
  "text": "Sabi niya, huwag akong pipikit.",
  "start": 2.5,
  "end": 4.32,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Isang segundo lang akong pumikit.",
  "start": 4.745,
  "end": 6.115,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Isang segundo lang.",
  "start": 6.54,
  "end": 7.43,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 7.855,
  "end": 8.845,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "At ito ang una kong date.",
  "start": 9.253,
  "end": 10.303,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon.",
  "start": 11.148,
  "end": 11.688,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Luneta, bago mag-alas-sais ng umaga.",
  "start": 12.113,
  "end": 14.803,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Nag-message si M, ang hindi niya kilalang nagpapadala ng mga order at tip: magkikita na raw sila, alas-sais ng umaga, sa Luneta.",
  "start": 15.228,
  "end": 23.998,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kaya namalantsa si Indio ng polo, sa unang pagkakataon.",
  "start": 24.423,
  "end": 28.053,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Taho: galing sa salitang Tsino para sa tokwa.",
  "start": 28.518,
  "end": 32.018,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Dinala rito ng mga mangangalakal, tapos nilagyan natin ng arnibal at sago.",
  "start": 32.443,
  "end": 36.773,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Bente niya ang ipinambili ko.",
  "start": 37.198,
  "end": 38.608,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Libre niya ako, hindi niya alam.",
  "start": 39.033,
  "end": 40.803,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Dito?",
  "start": 41.228,
  "end": 41.558,
  "style": "uneasy",
  "speaker": "INDIO"
 },
 {
  "text": "Ito 'yung lugar kung saan...",
  "start": 41.966,
  "end": 43.236,
  "style": "uneasy",
  "speaker": "INDIO"
 },
 {
  "text": "Sige na nga.",
  "start": 43.661,
  "end": 44.131,
  "style": "uneasy",
  "speaker": "INDIO"
 },
 {
  "text": "Para sa'yo.",
  "start": 44.556,
  "end": 45.036,
  "style": "uneasy",
  "speaker": "INDIO"
 },
 {
  "text": "Pero walang tao sa tagpuan.",
  "start": 45.501,
  "end": 47.151,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Marker lang, at isang mensahe: basahin mo nang malakas.",
  "start": 47.576,
  "end": 51.386,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Binasa niya, at uminit ang medalyon.",
  "start": 51.811,
  "end": 54.181,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bagumbayan.",
  "start": 55.026,
  "end": 55.836,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ikatatlumpu ng Disyembre, 1896.",
  "start": 56.261,
  "end": 60.781,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Umaga.",
  "start": 61.206,
  "end": 61.686,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Napunta siya sa isang malawak na parang, puno ng taong tahimik.",
  "start": 62.111,
  "end": 66.021,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Lumitaw sa tabi niya si Usman, ang aso niyang nagsasalita, pero hindi ito bumati.",
  "start": 66.446,
  "end": 71.846,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Usman?",
  "start": 72.311,
  "end": 72.701,
  "style": "low",
  "speaker": "INDIO"
 },
 {
  "text": "Bakit ganyan ka?",
  "start": 73.126,
  "end": 73.926,
  "style": "low",
  "speaker": "INDIO"
 },
 {
  "text": "Kilala ko ang araw na ito, par.",
  "start": 74.391,
  "end": 75.851,
  "style": "quiet",
  "speaker": "USMAN"
 },
 {
  "text": "Huwag mo akong tanungin.",
  "start": 76.276,
  "end": 77.431,
  "style": "quiet",
  "speaker": "USMAN"
 },
 {
  "text": "May batang lumapit, may pasang banga: si Kiko, tagatinda ng tubig sa parang.",
  "start": 77.896,
  "end": 83.366,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tubig, kuya?",
  "start": 83.831,
  "end": 84.631,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Libre na ngayong umaga.",
  "start": 85.056,
  "end": 86.186,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Walang gustong uminom.",
  "start": 86.611,
  "end": 87.491,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Ano'ng meron?",
  "start": 87.956,
  "end": 88.636,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Babarilin si Doktor Rizal.",
  "start": 89.101,
  "end": 90.571,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Ayun siya.",
  "start": 90.996,
  "end": 91.526,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Sa gitna ng mga sundalo, naglalakad ang isang lalaking nakaitim.",
  "start": 91.991,
  "end": 95.911,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si Pepe.",
  "start": 96.376,
  "end": 96.866,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Si Rizal.",
  "start": 97.291,
  "end": 97.851,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung batang umiiyak sa Calamba.",
  "start": 98.276,
  "end": 99.846,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Tatlumpu't lima na siya.",
  "start": 100.271,
  "end": 101.391,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "At sa tabi ni Indio, bumukas ang isang pulang payong.",
  "start": 102.236,
  "end": 105.326,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si M.",
  "start": 105.751,
  "end": 106.24,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa unang pagkakataon, katabi niya.",
  "start": 106.665,
  "end": 109.015,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Indio.",
  "start": 109.48,
  "end": 109.92,
  "style": "calm",
  "speaker": "M"
 },
 {
  "text": "M?",
  "start": 110.385,
  "end": 110.615,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw 'yon?",
  "start": 111.04,
  "end": 111.47,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Nagplantsa pa ako.",
  "start": 111.818,
  "end": 112.598,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Dito mo ako dinala?",
  "start": 113.023,
  "end": 114.013,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Kailangan mong makita ito.",
  "start": 114.478,
  "end": 115.618,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Buong-buo.",
  "start": 116.043,
  "end": 116.633,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Hinawakan ni M ang kamay niya.",
  "start": 117.098,
  "end": 118.748,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sabi ng titser ko, mga Kastila ang bumaril sa kanya.",
  "start": 119.213,
  "end": 122.493,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi, kuya.",
  "start": 122.958,
  "end": 123.718,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Tingnan mo kung sino ang may hawak ng riple.",
  "start": 124.104,
  "end": 125.724,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Mga kababayan natin.",
  "start": 126.149,
  "end": 127.279,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Ang mga Kastila, nasa likod nila, nakatutok.",
  "start": 127.704,
  "end": 130.674,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Kaninang madaling-araw, sa pinto ng kuta, may babaeng lumabas na umiiyak.",
  "start": 131.099,
  "end": 134.809,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Si Josephine raw, ang mahal niya.",
  "start": 135.234,
  "end": 136.654,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Yakap niya ang isang libro.",
  "start": 137.06,
  "end": 138.11,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Bigay raw ni Doktor.",
  "start": 138.535,
  "end": 139.515,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Kinapa ng isang doktor ang pulso ng lalaking nakaitim.",
  "start": 140.36,
  "end": 143.59,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kalmado pa rin daw ang pulso niya.",
  "start": 144.055,
  "end": 145.645,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Humarap ang lalaki sa mga riple.",
  "start": 146.11,
  "end": 147.77,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pero pinatalikod siya ulit.",
  "start": 148.195,
  "end": 149.645,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Gusto niyang humarap.",
  "start": 150.11,
  "end": 150.99,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Ayaw nila.",
  "start": 151.356,
  "end": 151.956,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Traydor daw ang binabaril nang nakatalikod.",
  "start": 152.381,
  "end": 154.471,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Sabi sa pelikula, bumaling siya at bumagsak nang nakaharap sa langit.",
  "start": 154.936,
  "end": 158.956,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Huwag kang pipikit, Indio.",
  "start": 159.421,
  "end": 160.731,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Hindi ko kaya.",
  "start": 161.196,
  "end": 161.986,
  "style": "shaking",
  "speaker": "INDIO"
 },
 {
  "text": "Saksi ka.",
  "start": 162.451,
  "end": 162.981,
  "style": "firm",
  "speaker": "M"
 },
 {
  "text": "Huwag kang pipikit.",
  "start": 163.406,
  "end": 164.156,
  "style": "firm",
  "speaker": "M"
 },
 {
  "text": "Itinaas ng opisyal ang espada.",
  "start": 164.621,
  "end": 166.531,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Consummatum est!",
  "start": 167.176,
  "end": 168.316,
  "style": "clear",
  "speaker": "RIZAL"
 },
 {
  "text": "Fuego!",
  "start": 168.781,
  "end": 169.201,
  "style": "shout",
  "speaker": "OPISYAL"
 },
 {
  "text": "Pumikit si Indio.",
  "start": 173.466,
  "end": 174.556,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pagdilat niya, tahimik na ang parang.",
  "start": 177.381,
  "end": 179.781,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa damuhan, isang itim na sombrero.",
  "start": 180.206,
  "end": 182.591,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Narinig mo, kuya?",
  "start": 183.056,
  "end": 183.916,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "\"Tapos na,\" sabi niya.",
  "start": 184.323,
  "end": 185.463,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Sa wikang Latin.",
  "start": 185.888,
  "end": 186.638,
  "style": "whispers",
  "speaker": "KIKO"
 },
 {
  "text": "Hindi ko nakita kung bumaling siya.",
  "start": 187.103,
  "end": 188.733,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Pumikit ako.",
  "start": 189.158,
  "end": 189.808,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Saka lang niya napansin: wala na ang kamay ni M.",
  "start": 190.273,
  "end": 193.233,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala na ang pulang payong.",
  "start": 193.658,
  "end": 195.038,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At wala na ang medalyon sa leeg niya.",
  "start": 195.463,
  "end": 197.323,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "M?",
  "start": 197.788,
  "end": 198.008,
  "style": "panicked",
  "speaker": "INDIO"
 },
 {
  "text": "M!",
  "start": 198.433,
  "end": 198.753,
  "style": "panicked",
  "speaker": "INDIO"
 },
 {
  "text": "Ang medalyon ko!",
  "start": 199.121,
  "end": 199.901,
  "style": "panicked",
  "speaker": "INDIO"
 },
 {
  "text": "Sa bulsa niya, may iniwang sulat.",
  "start": 200.366,
  "end": 202.626,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "\"Pasensya na, Indio.",
  "start": 203.091,
  "end": 204.401,
  "style": "reading",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi sa'yo ang medalyon.",
  "start": 204.826,
  "end": 205.986,
  "style": "reading",
  "speaker": "INDIO"
 },
 {
  "text": "Ibabalik ko lang sa pinanggalingan.\"",
  "start": 206.411,
  "end": 208.001,
  "style": "reading",
  "speaker": "INDIO"
 },
 {
  "text": "Bawat order ng pancit.",
  "start": 208.426,
  "end": 209.656,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Bawat tip.",
  "start": 210.081,
  "end": 210.641,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Bawat bente.",
  "start": 211.048,
  "end": 211.838,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Siya pala ang nagdala sa akin dito, hakbang-hakbang.",
  "start": 212.263,
  "end": 214.923,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hinintay ni Indio na lumamig ang medalyon at iuwi siya.",
  "start": 215.768,
  "end": 219.398,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pero wala na siyang medalyon.",
  "start": 219.823,
  "end": 221.233,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hindi siya makakauwi.",
  "start": 221.658,
  "end": 222.758,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Walang bagong marka.",
  "start": 223.223,
  "end": 224.383,
  "style": "hollow",
  "speaker": "INDIO"
 },
 {
  "text": "Pumikit ka, par.",
  "start": 224.848,
  "end": 225.768,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Kaya walang marka.",
  "start": 226.193,
  "end": 227.043,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Kaya rin niya nakuha.",
  "start": 227.468,
  "end": 228.278,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Teka.",
  "start": 228.743,
  "end": 228.963,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Wala na ang medalyon.",
  "start": 229.388,
  "end": 230.308,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Bakit naririnig pa rin kita?",
  "start": 230.733,
  "end": 232.223,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi ko rin alam.",
  "start": 232.688,
  "end": 233.498,
  "style": "quiet",
  "speaker": "USMAN"
 },
 {
  "text": "Akala ko rin, sa medalyon 'yon.",
  "start": 233.923,
  "end": 235.433,
  "style": "quiet",
  "speaker": "USMAN"
 },
 {
  "text": "Taga-saan ka ba, kuya?",
  "start": 235.898,
  "end": 236.988,
  "style": "kind",
  "speaker": "KIKO"
 },
 {
  "text": "Mukhang malayo ang uuwian mo.",
  "start": 237.413,
  "end": 238.728,
  "style": "kind",
  "speaker": "KIKO"
 },
 {
  "text": "Isandaan at tatlumpung taon mula rito.",
  "start": 239.193,
  "end": 241.313,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Walang jeep.",
  "start": 241.738,
  "end": 242.378,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Sumikat ang araw sa parang.",
  "start": 242.843,
  "end": 244.433,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si Usman, nasa tabi pa rin niya.",
  "start": 244.858,
  "end": 246.958,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa unang pagkakataon, hindi siya naglaho.",
  "start": 247.423,
  "end": 249.963,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong medalyon.",
  "start": 250.388,
  "end": 251.398,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong daan pauwi.",
  "start": 251.823,
  "end": 252.963,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Pero may kasama ako.",
  "start": 253.388,
  "end": 254.498,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: may bagay ka bang hindi mo kinayang tingnan, na sana tiningnan mo?",
  "start": 255.343,
