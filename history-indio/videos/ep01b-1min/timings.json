[
 {
  "text": "Nasaan ang cedula mo?!",
  "start": 0.015,
  "end": 1.12,
  "style": "shout",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Papatayin ako dahil sa isang papel?",
  "start": 1.585,
  "end": 4.075,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Kaninang umaga, tinanggihan si Indio sa trabaho.",
  "start": 4.92,
  "end": 8.1,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Walang cedula, walang trabaho.",
  "start": 8.565,
  "end": 10.375,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Gabi, sa Pugad Lawin, uminit ang medalyon niya.",
  "start": 11.22,
  "end": 14.55,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Agosto 1896: bumagsak siya sa kampo ng mga Katipunero.",
  "start": 15.395,
  "end": 20.585,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isinumbong na kami sa Kastila.",
  "start": 21.05,
  "end": 22.46,
  "style": "cold",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Walang cedula, espiya!",
  "start": 22.885,
  "end": 24.795,
  "style": "shout",
  "speaker": "KATIPUNERO"
 },
 {
  "text": "Itinutok ulit ang itak sa leeg niya.",
  "start": 25.26,
  "end": 27.38,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa tabi niya, may asong itim.",
  "start": 27.805,
  "end": 30.055,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Par, umamin ka na.",
  "start": 30.52,
  "end": 31.67,
  "style": "playful",
  "speaker": "USMAN"
 },
 {
  "text": "Nagsasalita ang aso?!",
  "start": 32.135,
  "end": 33.345,
  "style": "shout",
  "speaker": "INDIO"
 },
 {
  "text": "Totoo po, wala akong papel.",
  "start": 33.77,
  "end": 35.58,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Lumapit si Islaw, bantay na dose anyos.",
  "start": 36.045,
  "end": 38.795,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ako rin, walang cedula.",
  "start": 39.26,
  "end": 40.92,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "Pakawalan n'yo siya.",
  "start": 41.345,
  "end": 42.245,
  "style": "hard",
  "speaker": "ISLAW"
 },
 {
  "text": "Ibinaba ang itak.",
  "start": 42.71,
  "end": 43.85,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Humakbang sa liwanag ang Supremo, si Andres Bonifacio.",
  "start": 44.695,
  "end": 48.585,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Punitin ang mga cedula!",
  "start": 49.13,
  "end": 50.33,
  "style": "shout",
  "speaker": "BONIFACIO"
 },
 {
  "text": "Pinunit niya.",
  "start": 50.795,
  "end": 51.485,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sumabay ang daan-daan.",
  "start": 51.91,
  "end": 53.2,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mabuhay ang Pilipinas!",
  "start": 53.665,
  "end": 55.095,
  "style": "shout",
  "speaker": "MGA KATIPUNERO"
 },
 {
  "text": "Buwis ng Kastila 'yon, Kuya.",
  "start": 55.56,
  "end": 56.91,
  "style": "awed",
  "speaker": "ISLAW"
 },
 {
  "text": "Ang papel na muntik kong ikamatay, pinunit nila para lumaya.",
  "start": 57.375,
  "end": 60.725,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, anong papel ang pupunitin mo?",
  "start": 61.15,
  "end": 63.23,
  "style": "curious",
  "speaker": "INDIO"
 }
]