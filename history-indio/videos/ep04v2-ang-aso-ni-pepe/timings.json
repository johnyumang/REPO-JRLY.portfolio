[
 {
  "text": "Atras!",
  "start": 0.015,
  "end": 0.67,
  "style": "shout",
  "speaker": "ANDOY"
 },
 {
  "text": "Kakagatin ka niyan!",
  "start": 1.095,
  "end": 2.165,
  "style": "shout",
  "speaker": "ANDOY"
 },
 {
  "text": "Iniwan ako ng sarili kong aso.",
  "start": 2.63,
  "end": 4.39,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Tapos itong kamukha niya, gusto akong kainin.",
  "start": 4.815,
  "end": 7.665,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 8.09,
  "end": 9.17,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Malas pati sa aso.",
  "start": 9.595,
  "end": 10.795,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon.",
  "start": 11.64,
  "end": 12.16,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Calamba, Laguna.",
  "start": 12.585,
  "end": 14.045,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang salita lang ang iniwan ng Lolo ni Indio: Calamba.",
  "start": 14.47,
  "end": 17.46,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kaya nagpunta siya roon.",
  "start": 17.885,
  "end": 19.105,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa huling pera niya, bumili siya ng isang buko pie.",
  "start": 19.53,
  "end": 22.34,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Buko pie: sabi nila, sa Los Baños ito nagsimula.",
  "start": 22.805,
  "end": 25.945,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "May magkakapatid na gustong gumawa ng apple pie, pero walang mansanas.",
  "start": 26.37,
  "end": 30.39,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya buko.",
  "start": 30.815,
  "end": 31.395,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Kapag walang-wala ka, may paraan pa rin.",
  "start": 31.82,
  "end": 34.0,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Hapunan kita mamaya.",
  "start": 34.425,
  "end": 35.595,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Babasahin ko muna 'to nang malakas.",
  "start": 36.02,
  "end": 37.74,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Binasa niya ang marker sa harap ng bahay na bato.",
  "start": 38.205,
  "end": 40.865,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Uminit ang medalyon.",
  "start": 41.29,
  "end": 42.5,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Calamba.",
  "start": 43.345,
  "end": 43.905,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hunyo 1869.",
  "start": 44.33,
  "end": 46.86,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang hapon ng Linggo.",
  "start": 47.285,
  "end": 48.455,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Lumabas sa liwanag si Usman, ang asong itim na kasama niya sa bawat talon.",
  "start": 48.88,
  "end": 53.41,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pero hindi siya bumati.",
  "start": 53.835,
  "end": 55.035,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tumakbo siya.",
  "start": 55.46,
  "end": 56.12,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Usman!",
  "start": 56.585,
  "end": 57.055,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi ka man lang babati?",
  "start": 57.48,
  "end": 58.43,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw pa namang asong madaldal.",
  "start": 58.855,
  "end": 60.025,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Hoy!",
  "start": 60.45,
  "end": 60.8,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Huminto si Usman sa isang tarangkahan, at tinitigan ang isang maliit na batang lalaki sa bakuran.",
  "start": 61.265,
  "end": 67.045,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Usman.",
  "start": 67.51,
  "end": 67.94,
  "style": "calling",
  "speaker": "INDIO"
 },
 {
  "text": "Halika na.",
  "start": 68.365,
  "end": 68.795,
  "style": "calling",
  "speaker": "INDIO"
 },
 {
  "text": "Usman!",
  "start": 69.22,
  "end": 69.64,
  "style": "calling",
  "speaker": "INDIO"
 },
 {
  "text": "May iba pala siyang amo.",
  "start": 70.065,
  "end": 71.295,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Paglapit ni Indio, sinugod siya ng isang malaking itim na aso, kamukhang-kamukha ni Usman.",
  "start": 72.14,
  "end": 77.97,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinila siya palayo ni Andoy, ang batang kutsero ng pamilya.",
  "start": 78.395,
  "end": 82.165,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Atras!",
  "start": 82.63,
  "end": 83.31,
  "style": "shout",
  "speaker": "ANDOY"
 },
 {
  "text": "Kakagatin ka niyan!",
  "start": 83.735,
  "end": 84.805,
  "style": "shout",
  "speaker": "ANDOY"
 },
 {
  "text": "Aso 'yan ng bunsong lalaki rito.",
  "start": 85.23,
  "end": 87.15,
  "style": "flat",
  "speaker": "ANDOY"
 },
 {
  "text": "Si Pepe.",
  "start": 87.575,
  "end": 88.415,
  "style": "flat",
  "speaker": "ANDOY"
 },
 {
  "text": "José Rizal ang buong pangalan.",
  "start": 88.84,
  "end": 90.69,
  "style": "flat",
  "speaker": "ANDOY"
 },
 {
  "text": "Siya lang ang nakakalapit diyan.",
  "start": 91.115,
  "end": 92.595,
  "style": "flat",
  "speaker": "ANDOY"
 },
 {
  "text": "Rizal?",
  "start": 93.06,
  "end": 93.56,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung nasa piso?",
  "start": 93.908,
  "end": 94.578,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Anong piso?",
  "start": 95.043,
  "end": 95.862,
  "style": "puzzled",
  "speaker": "ANDOY"
 },
 {
  "text": "Wala.",
  "start": 96.327,
  "end": 96.617,
  "style": "hurt",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung aso ko, ayaw nang umalis diyan.",
  "start": 97.042,
  "end": 98.912,
  "style": "hurt",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi man lang ako nililingon.",
  "start": 99.337,
  "end": 100.747,
  "style": "hurt",
  "speaker": "INDIO"
 },
 {
  "text": "Eh di hindi mo aso 'yon.",
  "start": 101.212,
  "end": 102.702,
  "style": "shrug",
  "speaker": "ANDOY"
 },
 {
  "text": "Napaupo si Indio sa kalsada.",
  "start": 103.167,
  "end": 105.067,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At si Usman, nakatalikod pa rin sa kanya.",
  "start": 105.492,
  "end": 108.042,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tatlong beses na kaming tumalon sa nakaraan.",
  "start": 108.507,
  "end": 110.627,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Akala ko, kakampi ko siya.",
  "start": 111.033,
  "end": 112.713,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Nakikisakay lang pala siya pauwi.",
  "start": 113.138,
  "end": 114.598,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Kuya, mali ang ginagawa mo.",
  "start": 115.443,
  "end": 117.173,
  "style": "kind",
  "speaker": "ANDOY"
 },
 {
  "text": "Huwag mong titigan sa mata.",
  "start": 117.58,
  "end": 118.78,
  "style": "kind",
  "speaker": "ANDOY"
 },
 {
  "text": "Umupo ka.",
  "start": 119.205,
  "end": 119.835,
  "style": "kind",
  "speaker": "ANDOY"
 },
 {
  "text": "Maghintay ka.",
  "start": 120.26,
  "end": 121.08,
  "style": "kind",
  "speaker": "ANDOY"
 },
 {
  "text": "Ganyan sa kabayo, ganyan din sa aso.",
  "start": 121.505,
  "end": 123.675,
  "style": "kind",
  "speaker": "ANDOY"
 },
 {
  "text": "Sinunod ni Indio ang turo ni Andoy.",
  "start": 124.14,
  "end": 126.19,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Umupo siya, hindi tumingin, at naghintay.",
  "start": 126.615,
  "end": 129.175,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang pie ko.",
  "start": 129.64,
  "end": 130.09,
  "style": "pained",
  "speaker": "INDIO"
 },
 {
  "text": "Huling pera ko 'yan.",
  "start": 130.515,
  "end": 131.305,
  "style": "pained",
  "speaker": "INDIO"
 },
 {
  "text": "Ibinigay niya sa aso ang pie niya.",
  "start": 131.77,
  "end": 133.74,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At narinig niya ang sinasabi nito.",
  "start": 134.165,
  "end": 136.075,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "\"Aalis siya.\"",
  "start": 136.54,
  "end": 137.17,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "'Yun ang sinasabi niya.",
  "start": 137.595,
  "end": 138.505,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi siya galit sa akin.",
  "start": 138.93,
  "end": 140.02,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Nalulungkot siya.",
  "start": 140.445,
  "end": 141.365,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sa wakas, lumingon si Usman.",
  "start": 141.83,
  "end": 143.97,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Magkamukha ang dalawang aso, hanggang sa puting batik sa dibdib.",
  "start": 144.395,
  "end": 148.115,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ako 'yan, par.",
  "start": 148.58,
  "end": 149.45,
  "style": "quiet",
  "speaker": "USMAN"
 },
 {
  "text": "Noong hindi pa kita kilala.",
  "start": 149.875,
  "end": 151.135,
  "style": "quiet",
  "speaker": "USMAN"
 },
 {
  "text": "Ikaw 'yan?",
  "start": 151.6,
  "end": 152.05,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi kita iniwan.",
  "start": 152.515,
  "end": 153.475,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Gusto ko lang siyang makita ulit.",
  "start": 153.9,
  "end": 155.02,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Minsan pa.",
  "start": 155.445,
  "end": 156.045,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Lumabas ang batang aso, at umupo sa tabi ni Indio.",
  "start": 156.51,
  "end": 159.87,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si Pepe lang ang nakakagawa niyan.",
  "start": 160.335,
  "end": 162.205,
  "style": "awed",
  "speaker": "ANDOY"
 },
 {
  "text": "Mahal ang bayad.",
  "start": 162.67,
  "end": 163.51,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Isang buong pie.",
  "start": 163.935,
  "end": 164.725,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Sa hagdan, lumuhod si Teodora, ang ina ni Pepe, at hinawakan ang mukha ng bata.",
  "start": 165.57,
  "end": 171.23,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sabi sa libro, bayani na siya mula pagkabata.",
  "start": 171.695,
  "end": 174.345,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi umiiyak.",
  "start": 174.77,
  "end": 175.49,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Tingnan mo.",
  "start": 175.915,
  "end": 176.415,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Huwag mong tularan ang batang gamu-gamo, at huwag kang susuway.",
  "start": 177.06,
  "end": 180.44,
  "style": "gentle",
  "speaker": "TEODORA"
 },
 {
  "text": "Masusunog ka ring gaya niya.",
  "start": 180.865,
  "end": 182.195,
  "style": "gentle",
  "speaker": "TEODORA"
 },
 {
  "text": "Gamu-gamo.",
  "start": 182.66,
  "end": 183.42,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung lumapit sa apoy kahit pinagbawalan.",
  "start": 183.845,
  "end": 186.075,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Niyakap ng bata ang nanay niya, tapos ang aso niya.",
  "start": 186.54,
  "end": 189.78,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa Biñan siya mag-aaral.",
  "start": 190.245,
  "end": 191.735,
  "style": "soft",
  "speaker": "ANDOY"
 },
 {
  "text": "Ihahatid ng kuya niya.",
  "start": 192.16,
  "end": 193.53,
  "style": "soft",
  "speaker": "ANDOY"
 },
 {
  "text": "Ako ang hahawak ng renda.",
  "start": 193.936,
  "end": 195.371,
  "style": "soft",
  "speaker": "ANDOY"
 },
 {
  "text": "Umandar ang karomata.",
  "start": 195.836,
  "end": 197.196,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Naiwan ang aso sa tarangkahan, nakatingin sa daan.",
  "start": 197.621,
  "end": 200.841,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mga walong taon lang.",
  "start": 201.306,
  "end": 202.376,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Umiiyak.",
  "start": 202.723,
  "end": 203.213,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Bata lang pala siya, gaya ng lahat.",
  "start": 203.638,
  "end": 205.498,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Usman, kung aso ka niya, bakit ako ang kilala mo?",
  "start": 205.923,
  "end": 209.223,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Kaamoy mo ang bahay na 'to, par.",
  "start": 209.688,
  "end": 211.098,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi ko alam kung bakit.",
  "start": 211.523,
  "end": 212.393,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Lumamig ang medalyon.",
  "start": 213.238,
  "end": 214.708,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumalik si Indio sa kasalukuyan, mag-isa, may pang-apat na marka sa braso.",
  "start": 215.133,
  "end": 219.973,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Aray.",
  "start": 220.438,
  "end": 220.908,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Apat.",
  "start": 221.333,
  "end": 221.693,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "At kinain na naman ng aso ang hapunan ko.",
  "start": 222.1,
  "end": 224.2,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Nag-text si Lola.",
  "start": 224.665,
  "end": 225.795,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "\"Apo, may nakita akong lumang sobre ng Lolo mo.",
  "start": 226.26,
  "end": 228.5,
  "style": "reading",
  "speaker": "INDIO"
 },
 {
  "text": "Sabi niya rito, kadugo raw natin si Pepe.",
  "start": 228.925,
  "end": 231.215,
  "style": "reading",
  "speaker": "INDIO"
 },
 {
  "text": "At hindi raw ikaw ang unang nagtanong.\"",
  "start": 231.64,
  "end": 233.38,
  "style": "reading",
  "speaker": "INDIO"
 },
 {
  "text": "Sabi raw.",
  "start": 233.805,
  "end": 234.365,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Eh sino ang nauna sa akin?",
  "start": 234.753,
  "end": 236.163,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: kung may mahal kang gustong bumalik sa dati niyang tahanan, hahayaan mo ba?",
  "start": 237.008,
  "end": 241.978,
  "style": "curious",
  "speaker": "INDIO"
 }
]