[
 {
  "text": "Atras!",
  "start": 0.015,
  "end": 0.67,
  "style": "shout",
  "speaker": "ANDOY"
 },
 {
  "text": "Kakagatin ka niyan!",
  "start": 1.095,
  "end": 2.165,
  "style": "shout",
  "speaker": "ANDOY"
 },
 {
  "text": "Iniwan ako ng sarili kong aso.",
  "start": 2.63,
  "end": 4.39,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Tapos itong kamukha niya, gusto akong kainin.",
  "start": 4.815,
  "end": 7.665,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 8.09,
  "end": 9.17,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Malas pati sa aso.",
  "start": 9.595,
  "end": 10.805,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon.",
  "start": 11.65,
  "end": 12.17,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Calamba, Laguna.",
  "start": 12.595,
  "end": 14.055,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang salita lang ang iniwan ng Lolo ni Indio: Calamba.",
  "start": 14.48,
  "end": 17.47,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Kaya nagpunta siya roon.",
  "start": 17.895,
  "end": 19.115,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa huling pera niya, bumili siya ng isang buko pie.",
  "start": 19.54,
  "end": 22.35,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Buko pie: sabi nila, sa Los Baños ito nagsimula.",
  "start": 22.815,
  "end": 25.955,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "May magkakapatid na gustong gumawa ng apple pie, pero walang mansanas.",
  "start": 26.38,
  "end": 30.4,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Kaya buko.",
  "start": 30.825,
  "end": 31.405,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Kapag walang-wala ka, may paraan pa rin.",
  "start": 31.83,
  "end": 34.01,
  "style": "proud",
  "speaker": "INDIO"
 },
 {
  "text": "Hapunan kita mamaya.",
  "start": 34.435,
  "end": 35.605,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Babasahin ko muna 'to nang malakas.",
  "start": 36.03,
  "end": 37.75,
  "style": "bored",
  "speaker": "INDIO"
 },
 {
  "text": "Binasa niya ang marker sa harap ng bahay na bato.",
  "start": 38.215,
  "end": 40.875,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Uminit ang medalyon.",
  "start": 41.3,
  "end": 42.51,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Calamba.",
  "start": 43.355,
  "end": 43.915,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hunyo 1869.",
  "start": 44.34,
  "end": 46.87,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Isang hapon ng Linggo.",
  "start": 47.295,
  "end": 48.465,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Lumabas sa liwanag si Usman, ang asong itim na kasama niya sa bawat talon.",
  "start": 48.89,
  "end": 53.42,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pero hindi siya bumati.",
  "start": 53.845,
  "end": 55.045,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tumakbo siya.",
  "start": 55.47,
  "end": 56.13,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Usman!",
  "start": 56.595,
  "end": 57.005,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi ka man lang babati?",
  "start": 57.43,
  "end": 58.44,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw pa namang asong madaldal.",
  "start": 58.865,
  "end": 60.485,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Hoy!",
  "start": 60.91,
  "end": 61.26,
  "style": "surprised",
  "speaker": "INDIO"
 },
 {
  "text": "Huminto si Usman sa isang tarangkahan, at tinitigan ang isang maliit na batang lalaki sa bakuran.",
  "start": 61.725,
  "end": 67.505,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Usman.",
  "start": 67.97,
  "end": 68.4,
  "style": "calling",
  "speaker": "INDIO"
 },
 {
  "text": "Halika na.",
  "start": 68.825,
  "end": 69.255,
  "style": "calling",
  "speaker": "INDIO"
 },
 {
  "text": "Usman!",
  "start": 69.68,
  "end": 70.1,
  "style": "calling",
  "speaker": "INDIO"
 },
 {
  "text": "May iba pala siyang amo.",
  "start": 70.525,
  "end": 71.755,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Paglapit ni Indio, sinugod siya ng isang malaking itim na aso, kamukhang-kamukha ni Usman.",
  "start": 72.6,
  "end": 78.43,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hinila siya palayo ni Andoy, ang batang kutsero ng pamilya.",
  "start": 78.855,
  "end": 82.625,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Atras!",
  "start": 83.09,
  "end": 83.77,
  "style": "shout",
  "speaker": "ANDOY"
 },
 {
  "text": "Kakagatin ka niyan!",
  "start": 84.195,
  "end": 85.265,
  "style": "shout",
  "speaker": "ANDOY"
 },
 {
  "text": "Aso 'yan ng bunsong lalaki rito.",
  "start": 85.69,
  "end": 87.61,
  "style": "flat",
  "speaker": "ANDOY"
 },
 {
  "text": "Si Pepe.",
  "start": 88.035,
  "end": 88.875,
  "style": "flat",
  "speaker": "ANDOY"
 },
 {
  "text": "José Rizal ang buong pangalan.",
  "start": 89.3,
  "end": 91.15,
  "style": "flat",
  "speaker": "ANDOY"
 },
 {
  "text": "Siya lang ang nakakalapit diyan.",
  "start": 91.575,
  "end": 93.055,
  "style": "flat",
  "speaker": "ANDOY"
 },
 {
  "text": "Rizal?",
  "start": 93.52,
  "end": 94.02,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung nasa piso?",
  "start": 94.368,
  "end": 95.048,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Anong piso?",
  "start": 95.513,
  "end": 96.332,
  "style": "puzzled",
  "speaker": "ANDOY"
 },
 {
  "text": "Wala.",
  "start": 96.797,
  "end": 97.027,
  "style": "hurt",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung aso ko, ayaw nang umalis diyan.",
  "start": 97.452,
  "end": 99.402,
  "style": "hurt",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi man lang ako nililingon.",
  "start": 99.827,
  "end": 101.007,
  "style": "hurt",
  "speaker": "INDIO"
 },
 {
  "text": "Eh di hindi mo aso 'yon.",
  "start": 101.472,
  "end": 102.962,
  "style": "shrug",
  "speaker": "ANDOY"
 },
 {
  "text": "Napaupo si Indio sa kalsada.",
  "start": 103.427,
  "end": 105.327,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At si Usman, nakatalikod pa rin sa kanya.",
  "start": 105.752,
  "end": 108.302,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tatlong beses na kaming tumalon sa nakaraan.",
  "start": 108.767,
  "end": 110.887,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Akala ko, kakampi ko siya.",
  "start": 111.293,
  "end": 112.973,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Nakikisakay lang pala siya pauwi.",
  "start": 113.398,
  "end": 114.858,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Kuya, mali ang ginagawa mo.",
  "start": 115.703,
  "end": 117.433,
  "style": "kind",
  "speaker": "ANDOY"
 },
 {
  "text": "Huwag mong titigan sa mata.",
  "start": 117.84,
  "end": 119.05,
  "style": "kind",
  "speaker": "ANDOY"
 },
 {
  "text": "Umupo ka.",
  "start": 119.475,
  "end": 120.095,
  "style": "kind",
  "speaker": "ANDOY"
 },
 {
  "text": "Maghintay ka.",
  "start": 120.52,
  "end": 121.34,
  "style": "kind",
  "speaker": "ANDOY"
 },
 {
  "text": "Ganyan sa kabayo, ganyan din sa aso.",
  "start": 121.765,
  "end": 123.935,
  "style": "kind",
  "speaker": "ANDOY"
 },
 {
  "text": "Sinunod ni Indio ang turo ni Andoy.",
  "start": 124.4,
  "end": 126.45,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Umupo siya, hindi tumingin, at naghintay.",
  "start": 126.875,
  "end": 129.425,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang pie ko.",
  "start": 129.89,
  "end": 130.39,
  "style": "pained",
  "speaker": "INDIO"
 },
 {
  "text": "Huling pera ko 'yan.",
  "start": 130.815,
  "end": 131.655,
  "style": "pained",
  "speaker": "INDIO"
 },
 {
  "text": "Ibinigay niya sa aso ang pie niya.",
  "start": 132.12,
  "end": 134.09,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "At narinig niya ang sinasabi nito.",
  "start": 134.515,
  "end": 136.425,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "\"Aalis siya.\"",
  "start": 136.89,
  "end": 137.51,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "'Yun ang sinasabi niya.",
  "start": 137.935,
  "end": 138.845,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi siya galit sa akin.",
  "start": 139.27,
  "end": 140.36,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Nalulungkot siya.",
  "start": 140.785,
  "end": 141.705,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Sa wakas, lumingon si Usman.",
  "start": 142.17,
  "end": 144.37,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Magkamukha ang dalawang aso, hanggang sa puting batik sa dibdib.",
  "start": 144.795,
  "end": 148.535,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ako 'yan, par.",
  "start": 149.0,
  "end": 149.87,
  "style": "quiet",
  "speaker": "USMAN"
 },
 {
  "text": "Noong hindi pa kita kilala.",
  "start": 150.295,
  "end": 151.555,
  "style": "quiet",
  "speaker": "USMAN"
 },
 {
  "text": "Ikaw 'yan?",
  "start": 152.02,
  "end": 152.47,
  "style": "stunned",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi kita iniwan.",
  "start": 152.935,
  "end": 153.895,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Gusto ko lang siyang makita ulit.",
  "start": 154.32,
  "end": 155.44,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Minsan pa.",
  "start": 155.865,
  "end": 156.465,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Lumabas ang batang aso, at umupo sa tabi ni Indio.",
  "start": 156.93,
  "end": 160.29,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si Pepe lang ang nakakagawa niyan.",
  "start": 160.755,
  "end": 162.625,
  "style": "awed",
  "speaker": "ANDOY"
 },
 {
  "text": "Mahal ang bayad.",
  "start": 163.09,
  "end": 163.93,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Isang buong pie.",
  "start": 164.355,
  "end": 165.145,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Sa hagdan, lumuhod si Teodora, ang ina ni Pepe, at hinawakan ang mukha ng bata.",
  "start": 165.99,
  "end": 171.65,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sabi sa libro, bayani na siya mula pagkabata.",
  "start": 172.115,
  "end": 174.765,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi umiiyak.",
  "start": 175.19,
  "end": 175.91,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Tingnan mo.",
  "start": 176.335,
  "end": 176.835,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Huwag mong tularan ang batang gamu-gamo, at huwag kang susuway.",
  "start": 177.48,
  "end": 180.86,
  "style": "gentle",
  "speaker": "TEODORA"
 },
 {
  "text": "Masusunog ka ring gaya niya.",
  "start": 181.285,
  "end": 182.615,
  "style": "gentle",
  "speaker": "TEODORA"
 },
 {
  "text": "Gamu-gamo.",
  "start": 183.08,
  "end": 183.84,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "'Yung lumapit sa apoy kahit pinagbawalan.",
  "start": 184.265,
  "end": 186.495,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Niyakap ng bata ang nanay niya, tapos ang aso niya.",
  "start": 186.96,
  "end": 190.2,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa Biñan siya mag-aaral.",
  "start": 190.665,
  "end": 192.155,
  "style": "soft",
  "speaker": "ANDOY"
 },
 {
  "text": "Ihahatid ng kuya niya.",
  "start": 192.58,
  "end": 193.95,
  "style": "soft",
  "speaker": "ANDOY"
 },
 {
  "text": "Ako ang hahawak ng renda.",
  "start": 194.356,
  "end": 195.791,
  "style": "soft",
  "speaker": "ANDOY"
 },
 {
  "text": "Umandar ang karomata.",
  "start": 196.256,
  "end": 197.616,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Naiwan ang aso sa tarangkahan, nakatingin sa daan.",
  "start": 198.041,
  "end": 201.261,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mga walong taon lang.",
  "start": 201.726,
  "end": 202.796,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Umiiyak.",
  "start": 203.143,
  "end": 203.633,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Bata lang pala siya, gaya ng lahat.",
  "start": 204.058,
  "end": 205.918,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Usman, kung aso ka niya, bakit ako ang kilala mo?",
  "start": 206.343,
  "end": 209.643,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Kaamoy mo ang bahay na 'to, par.",
  "start": 210.108,
  "end": 211.518,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Hindi ko alam kung bakit.",
  "start": 211.943,
  "end": 212.813,
  "style": "low",
  "speaker": "USMAN"
 },
 {
  "text": "Lumamig ang medalyon.",
  "start": 213.658,
  "end": 215.128,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bumalik si Indio sa kasalukuyan, mag-isa, may pang-apat na marka sa braso.",
  "start": 215.553,
  "end": 220.393,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Aray.",
  "start": 220.858,
  "end": 221.238,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Apat.",
  "start": 221.663,
  "end": 221.983,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "At kinain na naman ng aso ang hapunan ko.",
  "start": 222.408,
  "end": 224.688,
  "style": "wince",
  "speaker": "INDIO"
 },
 {
  "text": "Nag-text si Lola.",
  "start": 225.153,
  "end": 226.283,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "\"Apo, may nakita akong lumang sobre ng Lolo mo.",
  "start": 226.748,
  "end": 228.988,
  "style": "reading",
  "speaker": "INDIO"
 },
 {
  "text": "Sabi niya rito, kadugo raw natin si Pepe.",
  "start": 229.413,
  "end": 231.703,
  "style": "reading",
  "speaker": "INDIO"
 },
 {
  "text": "At hindi raw ikaw ang unang nagtanong.\"",
  "start": 232.128,
  "end": 233.868,
  "style": "reading",
  "speaker": "INDIO"
 },
 {
  "text": "Sabi raw.",
  "start": 234.293,
  "end": 234.853,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Eh sino ang nauna sa akin?",
  "start": 235.241,
  "end": 236.651,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ikaw, ka-Indio: kung may mahal kang gustong bumalik sa dati niyang tahanan, hahayaan mo ba?",
  "start": 237.496,
  "end": 242.466,
  "style": "curious",
  "speaker": "INDIO"
 }
]