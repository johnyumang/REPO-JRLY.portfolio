[
 {
  "text": "Naki, nakita na, teka!",
  "start": 0.015,
  "end": 1.75,
  "style": "shout",
  "speaker": "INDIO"
 },
 {
  "text": "Isa pang take!",
  "start": 2.175,
  "end": 2.725,
  "style": "shout",
  "speaker": "INDIO"
 },
 {
  "text": "Tatlong salita lang: \"Nakita na kita.\"",
  "start": 3.15,
  "end": 5.42,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Sa harap ng buong isla, hindi ko nasabi.",
  "start": 5.845,
  "end": 8.475,
  "style": "dramatic",
  "speaker": "INDIO"
 },
 {
  "text": "Ako 'to si Indio.",
  "start": 8.9,
  "end": 9.82,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Mayaman.",
  "start": 10.245,
  "end": 10.725,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "At lasing.",
  "start": 11.15,
  "end": 11.62,
  "style": "dry",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon.",
  "start": 12.465,
  "end": 12.965,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa yate ni Indio, sa tapat ng Limasawa.",
  "start": 13.39,
  "end": 16.38,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tanghali pa lang, may alak na at videoke.",
  "start": 16.805,
  "end": 19.725,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Videoke.",
  "start": 20.19,
  "end": 21.37,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Sabi nila, Pinoy ang nag-imbento: si Roberto del Rosario, may patent ng Sing-Along System.",
  "start": 21.736,
  "end": 28.566,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "May mga Hapon ding nauna.",
  "start": 28.991,
  "end": 30.431,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Score ko, siyamnapu't walo.",
  "start": 30.856,
  "end": 33.006,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Lasing din yata ang makina.",
  "start": 33.431,
  "end": 35.131,
  "style": "playful",
  "speaker": "INDIO"
 },
 {
  "text": "Lumapit si M, ang babaeng may mapa ng mga medalyon.",
  "start": 35.596,
  "end": 38.756,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Indio.",
  "start": 39.221,
  "end": 39.671,
  "style": "quiet",
  "speaker": "M"
 },
 {
  "text": "Alas-dose pa lang.",
  "start": 40.077,
  "end": 41.067,
  "style": "quiet",
  "speaker": "M"
 },
 {
  "text": "Nasa islang ito ang susunod na medalyon.",
  "start": 41.492,
  "end": 43.542,
  "style": "quiet",
  "speaker": "M"
 },
 {
  "text": "Sa pampang, binasa ni Indio nang pasigaw ang marker ng unang misa.",
  "start": 44.007,
  "end": 48.627,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Uminit ang medalyon ni M, at dinala sila sa nakaraan.",
  "start": 49.052,
  "end": 52.342,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mazaua, Linggo ng Pagkabuhay, 31 Marso 1521.",
  "start": 53.187,
  "end": 59.667,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Bilisan natin, M.",
  "start": 60.132,
  "end": 61.882,
  "style": "slurred",
  "speaker": "INDIO"
 },
 {
  "text": "Sumalubong si Usman, ang aso niyang nagsasalita.",
  "start": 62.347,
  "end": 65.327,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Par.",
  "start": 65.792,
  "end": 66.002,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Amoy alak ka.",
  "start": 66.427,
  "end": 67.217,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Pati anino mo, pasuray.",
  "start": 67.642,
  "end": 69.012,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Hinila sila sa likod ng mga puno ni Mang Laon, isang matandang mangingisda.",
  "start": 69.477,
  "end": 73.807,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Dito lang tayo.",
  "start": 74.272,
  "end": 75.222,
  "style": "whispers",
  "speaker": "MANG LAON"
 },
 {
  "text": "Tahimik.",
  "start": 75.647,
  "end": 76.197,
  "style": "whispers",
  "speaker": "MANG LAON"
 },
 {
  "text": "Mula roon, tanaw nila sa malayo ang isang misa sa tabing-dagat.",
  "start": 76.662,
  "end": 80.642,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mga limampung dayuhang taga-barko ang naroon, at ang dalawang raha: si Kolambu at ang kapatid niyang si Siagu.",
  "start": 81.067,
  "end": 88.037,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Humalik ang dalawa sa krus, at lumuhod.",
  "start": 88.462,
  "end": 90.972,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tapos na.",
  "start": 91.437,
  "end": 92.027,
  "style": "low",
  "speaker": "MANG LAON"
 },
 {
  "text": "Sabi ng titser ko, sa araw na 'to, naging Kristiyano na tayong lahat.",
  "start": 92.492,
  "end": 96.752,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong nakitang bininyagan.",
  "start": 97.118,
  "end": 98.718,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Panauhin lang sila ng mga raha namin.",
  "start": 99.183,
  "end": 101.263,
  "style": "plain",
  "speaker": "MANG LAON"
 },
 {
  "text": "Bukas, kalakal.",
  "start": 101.688,
  "end": 103.148,
  "style": "plain",
  "speaker": "MANG LAON"
 },
 {
  "text": "Itinapat ni Indio sa mata ang lente ng Lolo niya, na nagpapakita ng totoong nangyari sa lugar na tinitingnan.",
  "start": 103.993,
  "end": 110.453,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Wala akong makita.",
  "start": 110.918,
  "end": 111.818,
  "style": "slurred",
  "speaker": "INDIO"
 },
 {
  "text": "Hindi lente ang malabo, par.",
  "start": 112.283,
  "end": 113.603,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Ikaw.",
  "start": 114.028,
  "end": 114.448,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Heto, gintong relo.",
  "start": 114.913,
  "end": 116.243,
  "style": "slurred",
  "speaker": "INDIO"
 },
 {
  "text": "Ituro mo ang medalyong tanso.",
  "start": 116.668,
  "end": 118.108,
  "style": "slurred",
  "speaker": "INDIO"
 },
 {
  "text": "Isang isda, isang takal ng bigas: 'yan ang tapat.",
  "start": 118.573,
  "end": 121.782,
  "style": "plain",
  "speaker": "MANG LAON"
 },
 {
  "text": "Ang sobra, hindi bayad.",
  "start": 122.189,
  "end": 123.989,
  "style": "plain",
  "speaker": "MANG LAON"
 },
 {
  "text": "Utang.",
  "start": 124.355,
  "end": 124.865,
  "style": "plain",
  "speaker": "MANG LAON"
 },
 {
  "text": "Kinagabihan, pinukpok ng buong pampang ang mga palayok.",
  "start": 125.71,
  "end": 129.03,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Mula sa dagat, umahon ang isang dambuhalang ahas, paakyat sa buwan.",
  "start": 129.455,
  "end": 133.975,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ang Bakunawa!",
  "start": 134.44,
  "end": 135.37,
  "style": "frightened",
  "speaker": "MANG LAON"
 },
 {
  "text": "Kakainin niya ang buwan!",
  "start": 135.795,
  "end": 136.935,
  "style": "frightened",
  "speaker": "MANG LAON"
 },
 {
  "text": "Indio, ngayon na.",
  "start": 137.4,
  "end": 138.68,
  "style": "urgent",
  "speaker": "M"
 },
 {
  "text": "Sabihin mo: \"Nakita na kita.\"",
  "start": 139.105,
  "end": 140.995,
  "style": "urgent",
  "speaker": "M"
 },
 {
  "text": "Magiging pangatlong buhol siya, pangatlong kakampi.",
  "start": 141.42,
  "end": 144.09,
  "style": "urgent",
  "speaker": "M"
 },
 {
  "text": "Phone ang itinaas ni Indio.",
  "start": 144.555,
  "end": 146.325,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Guys!",
  "start": 146.79,
  "end": 147.34,
  "style": "slurred",
  "speaker": "INDIO"
 },
 {
  "text": "Content 'to!",
  "start": 147.75,
  "end": 148.37,
  "style": "slurred",
  "speaker": "INDIO"
 },
 {
  "text": "Par, may sinasabi ang Bakunawa!",
  "start": 148.835,
  "end": 150.415,
  "style": "sharp",
  "speaker": "USMAN"
 },
 {
  "text": "Tumahimik ka muna!",
  "start": 150.84,
  "end": 151.74,
  "style": "sharp",
  "speaker": "USMAN"
 },
 {
  "text": "Ungol lang 'yan!",
  "start": 152.205,
  "end": 152.795,
  "style": "slurred",
  "speaker": "INDIO"
 },
 {
  "text": "Tumitig kay Indio ang dambuhalang mata nito.",
  "start": 153.26,
  "end": 155.68,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Tumahimik ang pampang.",
  "start": 156.105,
  "end": 157.235,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Naki, nakita na, teka!",
  "start": 157.7,
  "end": 159.45,
  "style": "shout",
  "speaker": "INDIO"
 },
 {
  "text": "Isa pang take!",
  "start": 159.875,
  "end": 160.425,
  "style": "shout",
  "speaker": "INDIO"
 },
 {
  "text": "Tumalikod ang Bakunawa at lumubog.",
  "start": 160.89,
  "end": 162.87,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Malamig pa rin.",
  "start": 163.335,
  "end": 164.105,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Dalawa pa rin ang buhol mo.",
  "start": 164.53,
  "end": 165.67,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Sa video, naka-selfie pala.",
  "start": 166.135,
  "end": 167.925,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Mukha ko lang ang nakunan.",
  "start": 168.311,
  "end": 169.421,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Tumatawa.",
  "start": 169.846,
  "end": 170.446,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Kinaumagahan, hindi na lasing si Indio.",
  "start": 171.291,
  "end": 173.831,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Gutom po ako.",
  "start": 174.296,
  "end": 175.016,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Wala akong tapat na pambayad.",
  "start": 175.441,
  "end": 176.721,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "May kamay ka.",
  "start": 177.186,
  "end": 178.026,
  "style": "plain",
  "speaker": "MANG LAON"
 },
 {
  "text": "Hilahin mo ang lambat.",
  "start": 178.451,
  "end": 179.521,
  "style": "plain",
  "speaker": "MANG LAON"
 },
 {
  "text": "Isang isda ang upa.",
  "start": 179.946,
  "end": 181.146,
  "style": "plain",
  "speaker": "MANG LAON"
 },
 {
  "text": "Pagsapit ng tanghali, dalawang isda ang iniabot ng matanda.",
  "start": 181.611,
  "end": 185.461,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sobra po ng isa.",
  "start": 185.926,
  "end": 186.816,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Sabi n'yo, ang sobra, utang.",
  "start": 187.241,
  "end": 189.641,
  "style": "quiet",
  "speaker": "INDIO"
 },
 {
  "text": "Par!",
  "start": 190.106,
  "end": 190.406,
  "style": "pained",
  "speaker": "USMAN"
 },
 {
  "text": "Gutom din ako!",
  "start": 190.831,
  "end": 191.601,
  "style": "pained",
  "speaker": "USMAN"
 },
 {
  "text": "Ngumiti ang matanda, at kinalas ang pabigat ng lambat niya: isang medalyong tanso.",
  "start": 192.066,
  "end": 197.356,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Galing 'yan sa raha namin.",
  "start": 197.821,
  "end": 199.331,
  "style": "warm",
  "speaker": "MANG LAON"
 },
 {
  "text": "Sa tapat lang 'yan sumasama.",
  "start": 199.756,
  "end": 201.406,
  "style": "warm",
  "speaker": "MANG LAON"
 },
 {
  "text": "Uminit ito sa palad ni Indio, pero malamlam, at may mahinang tinig.",
  "start": 201.871,
  "end": 206.881,
  "style": "low",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Sa tapat na palitan, walang natatalo.",
  "start": 207.346,
  "end": 209.696,
  "style": "faint",
  "speaker": "DIWA"
 },
 {
  "text": "Diwa 'yan ni Raha Kolambu, 'yung nasa misa.",
  "start": 210.161,
  "end": 212.001,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Ang Kalakal ang medalyon niya: tunay na halaga ang ipapakita.",
  "start": 212.426,
  "end": 215.746,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Malamlam, kasi kagabi, bulag ka.",
  "start": 216.171,
  "end": 218.351,
  "style": "dry",
  "speaker": "USMAN"
 },
 {
  "text": "Dito ka, iho.",
  "start": 218.816,
  "end": 219.736,
  "style": "warm",
  "speaker": "MANG LAON"
 },
 {
  "text": "May lugar sa apoy ang nagbabalik ng sobra.",
  "start": 220.161,
  "end": 222.401,
  "style": "warm",
  "speaker": "MANG LAON"
 },
 {
  "text": "Dalawampu't dalawang sasakyan, at ito ang una kong pinaghirapan: isang isda.",
  "start": 222.866,
  "end": 227.526,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Hinati pa ni Usman.",
  "start": 227.951,
  "end": 229.021,
  "style": "whispers",
  "speaker": "INDIO"
 },
 {
  "text": "Ngayon.",
  "start": 229.866,
  "end": 230.396,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Pagbalik sa yate, sa buwan nakatingala si M, hindi kay Indio.",
  "start": 230.782,
  "end": 235.182,
  "style": "calm",
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Unang beses, Indio, na may nawala sa atin.",
  "start": 235.647,
  "end": 238.457,
  "style": "low",
  "speaker": "M"
 },
 {
  "text": "Ikaw, ka-Indio: kailan ka huling nag-video sa halip na tumingin?",
  "start": 239.302,
  "end": 242.392,
  "style": "curious",
  "speaker": "INDIO"
 }
]