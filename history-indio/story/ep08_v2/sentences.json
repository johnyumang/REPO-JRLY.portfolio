[
 {
  "text": "Huwag!",
  "say": "huwag!",
  "style": "sharp",
  "pre": 0,
  "pause": 0.5,
  "speaker": "M"
 },
 {
  "text": "Limandaan at dalawampu't siyam na araw akong naghintay para bawiin ang medalyon ko.",
  "say": "limandaan at dalawamput siyam na araw akong naghintay para bawiin ang medalyon ko.",
  "style": "dramatic",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Pinigilan ako ng mismong nagnakaw nito.",
  "say": "pinigilan ako ng mismong nagnakaw nito.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ako 'to si Indio.",
  "say": "ako to si indio.",
  "style": "dry",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Panadero na ako ngayon.",
  "say": "panadero na ako ngayon.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Cavite.",
  "say": "cavite.",
  "style": "calm",
  "pre": 0,
  "pause": 0.4,
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hunyo 1898.",
  "say": "hunyo mil otsosyentos nobentay otso.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Madaling-araw.",
  "say": "madaling-araw.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Unang trabahong hindi ako natanggal.",
  "say": "unang trabahong hindi ako natanggal.",
  "style": "dry",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Kinailangan ko pang mapadpad sa ibang siglo.",
  "say": "kinailangan ko pang mapadpad sa ibang siglo.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Sinigang: galing sa salitang \"sigang\", ibig sabihin, pakuluan.",
  "say": "siniGANG: galing sa salitang siGANG, ibig sabihin, pakuluan.",
  "style": "wistful",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Atin 'yan mula pa noong una.",
  "say": "atin yan mula pa noong una.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ang tagal ko nang hindi nakakatikim ng sinigang ni Lola.",
  "say": "ang tagal ko nang hindi nakakatikim ng siniGANG ni lola.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ngayong araw, uuwi na ako.",
  "say": "ngayong araw, uuwi na ako.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Indio!",
  "say": "indio!",
  "style": "brisk",
  "pre": 0,
  "pause": 0.4,
  "speaker": "ALING PINING"
 },
 {
  "text": "Tatlong bilao para sa handaan sa bahay ng Heneral.",
  "say": "tatlong bilao para sa handaan sa bahay ng heneRAL.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "ALING PINING"
 },
 {
  "text": "Ikaw ang magdala, at huwag mong ipakain sa aso.",
  "say": "ikaw ang magdala, at huwag mong ipakain sa aso.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "ALING PINING"
 },
 {
  "text": "Naririnig kita, Aling Pining.",
  "say": "naririnig kita, aling PIning.",
  "style": "sleepy",
  "pre": 0,
  "pause": 0.5,
  "speaker": "USMAN"
 },
 {
  "text": "Kawit.",
  "say": "KAwit.",
  "style": "low",
  "pre": 0,
  "pause": 0.4,
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Ikalabindalawa ng Hunyo, 1898.",
  "say": "ikalabindalawa ng hunyo, mil otsosyentos nobentay otso.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Hapon.",
  "say": "hapon.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "TAGAPAGSALAYSAY"
 },
 {
  "text": "Si Mabini.",
  "say": "si maBIni.",
  "style": "whisper",
  "pre": 0,
  "pause": 0.4,
  "speaker": "ALING PINING"
 },
 {
  "text": "Lumpo ang paa, pero siya ang pinakamatalas dito.",
  "say": "lumpo ang paa, pero siya ang pinakamatalas dito.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "ALING PINING"
 },
 {
  "text": "Binuhat siya sa duyan papunta rito.",
  "say": "binuhat siya sa duyan papunta rito.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "ALING PINING"
 },
 {
  "text": "Sabi sa libro, buong kalayaan ang idineklara ngayon.",
  "say": "sabi sa libro, buong kalayaan ang idineklara ngayon.",
  "style": "whisper",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Lahat masaya.",
  "say": "lahat masaya.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Maaga pa ito.",
  "say": "maaga pa ito.",
  "style": "quiet",
  "pre": 0,
  "pause": 0.4,
  "speaker": "MABINI"
 },
 {
  "text": "At padalos-dalos.",
  "say": "at padalos-dalos.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "MABINI"
 },
 {
  "text": "Hindi lahat masaya, par.",
  "say": "hindi lahat masaya, par.",
  "style": "low",
  "pre": 0,
  "pause": 0.5,
  "speaker": "USMAN"
 },
 {
  "text": "Ako 'yon.",
  "say": "ako yon.",
  "style": "stunned",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO"
 },
 {
  "text": "Noong una akong dumating dito.",
  "say": "noong una akong dumating dito.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO"
 },
 {
  "text": "At ako 'yon.",
  "say": "at ako yon.",
  "style": "urgent",
  "pre": 0,
  "pause": 0.4,
  "speaker": "USMAN"
 },
 {
  "text": "Huwag kang lalapit, par.",
  "say": "huwag kang lalapit, par.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "USMAN"
 },
 {
  "text": "Bawal magkita ang iisang tao.",
  "say": "bawal magkita ang iisang tao.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "USMAN"
 },
 {
  "text": "Si M.",
  "say": "si m.",
  "style": "fierce",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO"
 },
 {
  "text": "At ang medalyon ko.",
  "say": "at ang medalyon ko.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO"
 },
 {
  "text": "Huwag!",
  "say": "huwag!",
  "style": "sharp",
  "pre": 0,
  "pause": 0.5,
  "speaker": "M"
 },
 {
  "text": "Isang taon at kalahati, M.",
  "say": "isang taon at kalahati, m.",
  "style": "bitter",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO"
 },
 {
  "text": "Nagmasa ako ng tinapay para makakain.",
  "say": "nagmasa ako ng tinapay para makakain.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO"
 },
 {
  "text": "Akin 'yan.",
  "say": "akin yan.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO"
 },
 {
  "text": "Hiningi ko ito sa Lolo mo noon.",
  "say": "hiningi ko ito sa lolo mo noon.",
  "style": "low",
  "pre": 0,
  "pause": 0.4,
  "speaker": "M"
 },
 {
  "text": "Tumanggi siya, kaya sa'yo ko kinuha.",
  "say": "tumanggi siya, kaya sayo ko kinuha.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "M"
 },
 {
  "text": "At kung kukunin mo ngayon, hindi na ito makakarating sa'yo kailanman.",
  "say": "at kung kukunin mo ngayon, hindi na ito makakarating sayo kailanman.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "M"
 },
 {
  "text": "Ano'ng ibig mong sabihin?",
  "say": "anong ibig mong sabihin?",
  "style": "confused",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO"
 },
 {
  "text": "Tingnan mo ang bata.",
  "say": "tingnan mo ang bata.",
  "style": "quiet",
  "pre": 0,
  "pause": 0.5,
  "speaker": "M"
 },
 {
  "text": "Ito pala ang sulat niya: \"ibabalik ko sa pinanggalingan\".",
  "say": "ito pala ang sulat niya: ibabalik ko sa pinanggalingan.",
  "style": "whisper",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Mula sa batang ito, bababa ang medalyon sa pamilya ko.",
  "say": "mula sa batang ito, bababa ang medalyon sa pamilya ko.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Hanggang kay Lolo.",
  "say": "hanggang kay lolo.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Hanggang sa akin.",
  "say": "hanggang sa akin.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ang daan ko pauwi, isasabit sa leeg ng isang sanggol.",
  "say": "ang daan ko pauwi, isasabit sa leeg ng isang sanggol.",
  "style": "whisper",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "At kailangan kong panoorin.",
  "say": "at kailangan kong panoorin.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Sige.",
  "say": "sige.",
  "style": "quiet",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO"
 },
 {
  "text": "Isabit mo.",
  "say": "isabit mo.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO"
 },
 {
  "text": "Mahigit tatlong daang taon akong naghintay sa araw na ito.",
  "say": "mahigit tatlong daang taon akong naghintay sa araw na ito.",
  "style": "deep",
  "pre": 0,
  "pause": 0.5,
  "speaker": "DIWA"
 },
 {
  "text": "Sino 'yon?",
  "say": "sino yon?",
  "style": "startled",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO"
 },
 {
  "text": "Si Rajah Sulayman.",
  "say": "si RAha sulayMAN.",
  "style": "low",
  "pre": 0,
  "pause": 0.4,
  "speaker": "M"
 },
 {
  "text": "Ang diwa sa medalyon n'yo.",
  "say": "ang diwa sa medalyon nyo.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "M"
 },
 {
  "text": "Ikaanim.",
  "say": "ikaanim.",
  "style": "soft",
  "pre": 0,
  "pause": 0.4,
  "speaker": "M"
 },
 {
  "text": "Dahil bumitaw ka.",
  "say": "dahil bumitaw ka.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "M"
 },
 {
  "text": "Sino ka na ba ngayon, Indio?",
  "say": "sino ka na ba ngayon, indio?",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "M"
 },
 {
  "text": "Panadero.",
  "say": "panadero.",
  "style": "dry",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO"
 },
 {
  "text": "May trabaho na ako.",
  "say": "may trabaho na ako.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO"
 },
 {
  "text": "Hoy!",
  "say": "hoy!",
  "style": "loud",
  "pre": 0,
  "pause": 0.4,
  "speaker": "ALING PINING"
 },
 {
  "text": "'Yang kinakain n'yong lahat, masa ng binatang 'yan!",
  "say": "yang kinakain nyong lahat, masa ng binatang yan!",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "ALING PINING"
 },
 {
  "text": "Limandaang araw kong tinuruan 'yan!",
  "say": "limandaang araw kong tinuruan yan!",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "ALING PINING"
 },
 {
  "text": "Sikat ka na, par.",
  "say": "sikat ka na, par.",
  "style": "proud",
  "pre": 0,
  "pause": 0.4,
  "speaker": "USMAN"
 },
 {
  "text": "Sa tinapay.",
  "say": "sa tinapay.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "USMAN"
 },
 {
  "text": "Hindi ang medalyon ang hinahanap ng mga sumusunod sa atin.",
  "say": "hindi ang medalyon ang hinahanap ng mga sumusunod sa atin.",
  "style": "low",
  "pre": 0,
  "pause": 0.4,
  "speaker": "M"
 },
 {
  "text": "Ito.",
  "say": "ito.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "M"
 },
 {
  "text": "Ang Huling Tala.",
  "say": "ang huling tala.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "M"
 },
 {
  "text": "Labindalawang medalyon, nakakalat sa mundo.",
  "say": "labindalawang medalyon, nakakalat sa mundo.",
  "style": "low",
  "pre": 0,
  "pause": 0.4,
  "speaker": "M"
 },
 {
  "text": "Kaya kitang iuwi ngayon din, kung gusto mo.",
  "say": "kaya kitang iuwi ngayon din, kung gusto mo.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "M"
 },
 {
  "text": "Lola, itabi mo muna ang sinigang ko.",
  "say": "lola, itabi mo muna ang siniGANG ko.",
  "style": "steady",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO"
 },
 {
  "text": "Teka.",
  "say": "teka.",
  "style": "whisper",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "May cellphone 'yon.",
  "say": "may cellphone yon.",
  "style": "",
  "pre": 0,
  "pause": 0.4,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Hindi lang pala ako ang hindi taga-rito.",
  "say": "hindi lang pala ako ang hindi taga-rito.",
  "style": "",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO",
  "aside": true
 },
 {
  "text": "Ikaw, ka-Indio: kung isang hakbang na lang pauwi, at may nagsabing \"huwag muna\", makikinig ka ba?",
  "say": "ikaw, ka-indio: kung isang hakbang na lang pauwi, at may nagsabing huwag muna, makikinig ka ba?",
  "style": "curious",
  "pre": 0,
  "pause": 0.5,
  "speaker": "INDIO",
  "aside": true
 }
