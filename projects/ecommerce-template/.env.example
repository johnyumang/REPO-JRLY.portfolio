# offline (default): the app's REST API is served in-page by MSW handlers over IndexedDB. No server needed.
# live: requests go to NEXT_PUBLIC_API_URL; orders/tickets/newsletter sign-ups made offline queue and replay.
NEXT_PUBLIC_DATA_MODE=offline
# Base URL of the live API (same contract as lib/api/contract.ts). Only read when DATA_MODE=live.
NEXT_PUBLIC_API_URL=
