# --- JRLY Medusa backend. Copy to .env (never commit .env). ---
STORE_NAME=JRLY
# Where the storefront is served; product image URLs point here (/stock/*.webp)
STOREFRONT_URL=http://localhost:3000
# Public URL of this backend (used by the admin dashboard build)
MEDUSA_BACKEND_URL=http://localhost:9000

STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa_store
# Optional locally, recommended in production (event bus, workflow engine, locking)
REDIS_URL=redis://localhost:6379

# Required in production: random, 32+ chars each (openssl rand -hex 32). The server refuses to start otherwise.
JWT_SECRET=change-me-openssl-rand-hex-32
COOKIE_SECRET=change-me-openssl-rand-hex-32

# shared = API + background jobs in one process (fine for free tiers); or split into server / worker
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
